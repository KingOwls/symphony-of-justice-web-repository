{"id":"game-16-difficulty-and-balance","group":"game","groupLabel":"Game Design","number":"16","title":"Difficulty and Balance","summary":"Defines difficulty goals, encounter scaling, accessibility, telemetry, power creep controls and balance methodology.","sourceFile":"Game Design/16 - Difficulty and Balance.docx","meta":{"status":"DRAFT","version":"0.15.7","owner":"J. Crow","last_updated":"20/08/2026"},"headings":[{"level":1,"text":"1. Balance Goals"},{"level":2,"text":"Development"},{"level":2,"text":"What does a fair combat encounter mean?"},{"level":1,"text":"Margin for Error"},{"level":2,"text":"Normal"},{"level":3,"text":"2–3 major mistakes"},{"level":1,"text":"Hard"},{"level":3,"text":"1–2 major mistakes"},{"level":1,"text":"Challenge"},{"level":1,"text":"Difference Between Difficulties"},{"level":1,"text":"2. Core Stats"},{"level":2,"text":"Development"},{"level":1,"text":"Fundamental Stats"},{"level":2,"text":"Health | HP"},{"level":1,"text":"Attack | ATK"},{"level":1,"text":"Defense / Armor | DEF"},{"level":3,"text":"DEF / Armor"},{"level":1,"text":"Resistances | RES"},{"level":3,"text":"Physical Resistance"},{"level":3,"text":"Elemental Resistance"},{"level":3,"text":"Pure Power Resistance"},{"level":1,"text":"Offensive Stats"},{"level":2,"text":"Critical Rate | CR"},{"level":2,"text":"Critical Damage | CD"},{"level":1,"text":"Elemental Damage Bonus"},{"level":1,"text":"Alchemy"},{"level":3,"text":"Alchemy"},{"level":1,"text":"Resource Stats"},{"level":2,"text":"Energy Recharge"},{"level":1,"text":"Secondary Stats"},{"level":2,"text":"Attack Speed"},{"level":2,"text":"Cooldown Reduction"},{"level":1,"text":"Provocation"},{"level":3,"text":"Threat"},{"level":1,"text":"Core Stats Summary"},{"level":1,"text":"3. Damage Formula"},{"level":2,"text":"Conceptual Formula"},{"level":1,"text":"Step 1. Raw Damage"},{"level":1,"text":"Hybrid Scaling"},{"level":1,"text":"Step 2. Damage Bonuses"},{"level":1,"text":"Step 3. Critical"},{"level":1,"text":"Step 4. Defense Mitigation"},{"level":3,"text":"Defense Multiplier"},{"level":3,"text":"66.7 % of its damage."},{"level":1,"text":"Defense Reduction"},{"level":1,"text":"Step 5. Resistance"},{"level":2,"text":"Proposed Limits"},{"level":3,"text":"Maximum positive Resistance"},{"level":3,"text":"Maximum negative Resistance"},{"level":1,"text":"Chaos"},{"level":1,"text":"Provisional Complete Formula"},{"level":1,"text":"Damage Floor"},{"level":3,"text":"1 damage"},{"level":1,"text":"4. Healing and Shields"},{"level":2,"text":"Development"},{"level":1,"text":"Healing"},{"level":2,"text":"Base Formula"},{"level":1,"text":"Healing Bonus"},{"level":1,"text":"Healing Received"},{"level":1,"text":"Overhealing"},{"level":1,"text":"Shields"},{"level":2,"text":"Formula"},{"level":1,"text":"Duration"},{"level":1,"text":"Shield Cap"},{"level":3,"text":"Initial general cap"},{"level":3,"text":"5,000."},{"level":1,"text":"Damage Order"},{"level":1,"text":"Buffs"},{"level":1,"text":"Debuffs"},{"level":1,"text":"5. Enemy Scaling"},{"level":2,"text":"Development"},{"level":1,"text":"Stat Scaling"},{"level":2,"text":"Normal Enemies"},{"level":2,"text":"Elite"},{"level":2,"text":"Bosses"},{"level":1,"text":"Difficulty Multipliers"},{"level":1,"text":"AI Scaling"},{"level":1,"text":"Damage Sponges"},{"level":3,"text":"Target Time To Kill | TTK"},{"level":1,"text":"Problem Indicator"},{"level":1,"text":"6. Character Power Budget"},{"level":2,"text":"Development"},{"level":1,"text":"Power Budget"},{"level":3,"text":"100 Budget Points"},{"level":1,"text":"Conceptual Example"},{"level":2,"text":"Pure DPS"},{"level":2,"text":"Support"},{"level":2,"text":"Guardian"},{"level":1,"text":"Rarity and Budget"},{"level":3,"text":"4★ = 80 points"},{"level":3,"text":"5★ = 120 points."},{"level":1,"text":"Metrics by Role"},{"level":2,"text":"Damage Dealer"},{"level":2,"text":"Support"},{"level":3,"text":"Team Damage Increase"},{"level":2,"text":"Healer"},{"level":2,"text":"Guardian"},{"level":2,"text":"Controller"},{"level":1,"text":"Field Time"},{"level":3,"text":"Output / Field Time."},{"level":1,"text":"Cooldown Economy"},{"level":1,"text":"Buff Criteria"},{"level":1,"text":"Nerf Criteria"},{"level":1,"text":"Important in a Gacha"},{"level":1,"text":"Popularity Does Not Equal Power"},{"level":1,"text":"7. Testing Plan"},{"level":2,"text":"Development"},{"level":1,"text":"Phase 1. Formula Testing"},{"level":3,"text":"Automated Tests"},{"level":3,"text":"50–100 automated cases per critical mathematical system"},{"level":1,"text":"Phase 2. Simulation"},{"level":3,"text":"10,000 simulated crit events"},{"level":1,"text":"Phase 3. Developer Playtest"},{"level":3,"text":"Recommended minimum"},{"level":3,"text":"5+ different compositions."},{"level":1,"text":"Phase 4. External Playtest"},{"level":3,"text":"First round"},{"level":3,"text":"Second round"},{"level":3,"text":"Future Beta"},{"level":1,"text":"Combat Metrics"},{"level":3,"text":"Clear Rate"},{"level":3,"text":"Attempts to Clear"},{"level":3,"text":"Time to Kill"},{"level":3,"text":"Death Rate"},{"level":3,"text":"Failure Cause"},{"level":3,"text":"Damage Taken"},{"level":3,"text":"Dodge Success"},{"level":3,"text":"Skill Usage"},{"level":3,"text":"Ultimate Usage"},{"level":3,"text":"Reaction Usage"},{"level":3,"text":"Character Usage"},{"level":3,"text":"Team Composition"},{"level":3,"text":"Field Time"},{"level":3,"text":"Damage Contribution"},{"level":3,"text":"Healing Effective / Overheal"},{"level":3,"text":"Shield Effective / Wasted"},{"level":3,"text":"Consumable Usage"},{"level":3,"text":"Restart / Abandon Rate"},{"level":1,"text":"Preliminary Targets by Difficulty"},{"level":2,"text":"Normal"},{"level":3,"text":"75–90 %"},{"level":2,"text":"Hard"},{"level":3,"text":"50–70 %"},{"level":2,"text":"Challenge"},{"level":3,"text":"20–40 %"},{"level":1,"text":"Learning Metric"},{"level":3,"text":"80 %+"},{"level":1,"text":"Character Balance Testing"},{"level":3,"text":"Baseline Build"},{"level":3,"text":"Optimized Build"},{"level":3,"text":"Alternative Build"},{"level":3,"text":"Weak Synergy"},{"level":3,"text":"Strong Synergy"},{"level":1,"text":"Reaction Testing"},{"level":1,"text":"Version Stability Criteria"},{"level":3,"text":"Mathematics"},{"level":3,"text":"Characters"},{"level":3,"text":"Encounters"},{"level":3,"text":"Readability"},{"level":3,"text":"Reactions"},{"level":3,"text":"Testing"},{"level":1,"text":"Balance Freeze"},{"level":3,"text":"Balance Freeze"}],"blocks":[{"type":"p","text":"SYMPHONIA IUSTITIAE"},{"type":"title","text":"16 - Difficulty and Balance"},{"type":"p","text":"Mathematics, curves, and balance criteria"},{"type":"table","table":0},{"type":"h1","text":"1. Balance Goals"},{"type":"h2","text":"Development"},{"type":"p","text":"The balance of Symphony of Justice must ensure that victory depends on a combination of:"},{"type":"p","text":"PREPARATION + COMPOSITION + EXECUTION + UNDERSTANDING + PROGRESSION"},{"type":"p","text":"and not exclusively on the amount of accumulated stats."},{"type":"p","text":"The Game Vision itself establishes that a satisfying victory should come from understanding the team and the conditions of the encounter, not simply from having higher statistical values."},{"type":"h2","text":"What does a fair combat encounter mean?"},{"type":"p","text":"A combat encounter is considered fair when the player has enough information and tools to understand what is happening and respond to it."},{"type":"p","text":"This means that:"},{"type":"p","text":"dangerous attacks have understandable telegraphs;"},{"type":"p","text":"important mechanics can be learned;"},{"type":"p","text":"statuses and reactions provide feedback;"},{"type":"p","text":"a defeat can be explained;"},{"type":"p","text":"several reasonably viable compositions exist;"},{"type":"p","text":"no limited character is mandatory;"},{"type":"p","text":"the recommended progression is sufficient;"},{"type":"p","text":"mistakes have proportional consequences."},{"type":"p","text":"A difficult combat encounter can defeat the player. An unfair one defeats them without allowing them to understand why."},{"type":"h1","text":"Margin for Error"},{"type":"p","text":"Not every difficulty level should allow the same number of mistakes."},{"type":"h2","text":"Normal"},{"type":"p","text":"Designed for:"},{"type":"p","text":"story;"},{"type":"p","text":"exploration;"},{"type":"p","text":"general progression."},{"type":"p","text":"A properly equipped player should be able to make approximately:"},{"type":"h3","text":"2–3 major mistakes"},{"type":"p","text":"before being placed in serious danger. This does not mean exactly three attacks. A “major mistake” may be:"},{"type":"p","text":"failing a critical dodge;"},{"type":"p","text":"ignoring a mechanic;"},{"type":"p","text":"using a defensive ability too early;"},{"type":"p","text":"poor positioning."},{"type":"p","text":"Normal combat should allow the player to recover."},{"type":"h1","text":"Hard"},{"type":"p","text":"Designed for players who understand the systems."},{"type":"p","text":"Allows approximately:"},{"type":"h3","text":"1–2 major mistakes"},{"type":"p","text":"before significant recovery becomes necessary. It demands better:"},{"type":"p","text":"timing;"},{"type":"p","text":"composition;"},{"type":"p","text":"reaction;"},{"type":"p","text":"positioning;"},{"type":"p","text":"cooldown management."},{"type":"h1","text":"Challenge"},{"type":"p","text":"Optional mastery content. Major mistakes can be very costly. But even here:"},{"type":"p","text":"An attack capable of immediately eliminating a character must be clearly telegraphed."},{"type":"p","text":"Difficulty should come from:"},{"type":"p","text":"complex sequences;"},{"type":"p","text":"pressure;"},{"type":"p","text":"combined mechanics;"},{"type":"p","text":"tighter windows;"},{"type":"p","text":"composition;"},{"type":"p","text":"execution."},{"type":"p","text":"Not simply from enemies dealing five times more damage."},{"type":"h1","text":"Difference Between Difficulties"},{"type":"table","table":1},{"type":"p","text":"The exact multipliers must be established through playtesting."},{"type":"h1","text":"2. Core Stats"},{"type":"h2","text":"Development"},{"type":"p","text":"The main stats should be numerous enough to support different builds, but few enough for the player to understand what they are improving. I propose organizing them into four families."},{"type":"h1","text":"Fundamental Stats"},{"type":"h2","text":"Health | HP"},{"type":"p","text":"The amount of damage a character can receive before becoming incapacitated."},{"type":"p","text":"The historical source already establishes: HP = 0 → character is out of combat until revived."},{"type":"p","text":"It can also function as a scaling stat for:"},{"type":"p","text":"Guardians;"},{"type":"p","text":"shields;"},{"type":"p","text":"healers;"},{"type":"p","text":"risk-based characters."},{"type":"p","text":"Juro is a good precedent because their mechanics depend directly on lost Health."},{"type":"h1","text":"Attack | ATK"},{"type":"p","text":"Represents physical/general offensive capability. It can scale:"},{"type":"p","text":"normal attacks;"},{"type":"p","text":"weapons;"},{"type":"p","text":"physical abilities;"},{"type":"p","text":"certain Skills."},{"type":"p","text":"Not every ability needs to depend on ATK."},{"type":"h1","text":"Defense / Armor | DEF"},{"type":"p","text":"Reduces damage received."},{"type":"p","text":"The historical documentation uses both Defense and Armor to represent general resistance."},{"type":"p","text":"I propose unifying them as:"},{"type":"h3","text":"DEF / Armor"},{"type":"p","text":"to avoid having two stats performing practically the same function."},{"type":"h1","text":"Resistances | RES"},{"type":"p","text":"They are divided into:"},{"type":"h3","text":"Physical Resistance"},{"type":"h3","text":"Elemental Resistance"},{"type":"h3","text":"Pure Power Resistance"},{"type":"p","text":"when applicable."},{"type":"p","text":"The documentation already considers specific elemental resistances and establishes that they reduce the effectiveness of damage from a given element."},{"type":"h1","text":"Offensive Stats"},{"type":"h2","text":"Critical Rate | CR"},{"type":"p","text":"Probability that an eligible hit will be critical."},{"type":"p","text":"Example: 25 % Critical Rate"},{"type":"p","text":"means a probability of 0.25."},{"type":"h2","text":"Critical Damage | CD"},{"type":"p","text":"Additional multiplier when a critical hit occurs."},{"type":"p","text":"Provisional base example: 50 % Critical Damage"},{"type":"p","text":"Produces: 1.50× damage"},{"type":"p","text":"when the critical hit occurs."},{"type":"h1","text":"Elemental Damage Bonus"},{"type":"p","text":"Increases damage from a particular element. Example: +20 % Cryo Damage."},{"type":"h1","text":"Alchemy"},{"type":"p","text":"This is one of the project's most distinctive historical stats. The documentation defines it as a stat associated with:"},{"type":"p","text":"reactions;"},{"type":"p","text":"multipliers;"},{"type":"p","text":"weaknesses;"},{"type":"p","text":"Creations;"},{"type":"p","text":"elemental interactions."},{"type":"p","text":"For the current system:"},{"type":"h3","text":"Alchemy"},{"type":"p","text":"will primarily modify the effectiveness of reactions triggered by the character. Depending on the reaction, it may affect:"},{"type":"p","text":"damage;"},{"type":"p","text":"duration;"},{"type":"p","text":"intensity;"},{"type":"p","text":"size;"},{"type":"p","text":"control strength."},{"type":"p","text":"It should not increase all five aspects simultaneously for every reaction."},{"type":"h1","text":"Resource Stats"},{"type":"h2","text":"Energy Recharge"},{"type":"p","text":"Increases generation of the resource associated with the Ultimate. It already exists explicitly in the historical character sheet."},{"type":"h1","text":"Secondary Stats"},{"type":"h2","text":"Attack Speed"},{"type":"p","text":"Speed of certain basic attacks."},{"type":"h2","text":"Cooldown Reduction"},{"type":"p","text":"If introduced, it should be heavily limited."},{"type":"h1","text":"Provocation"},{"type":"p","text":"Historically, it exists as the probability of receiving attacks."},{"type":"p","text":"I propose converting it into:"},{"type":"h3","text":"Threat"},{"type":"p","text":"a property primarily derived from:"},{"type":"p","text":"role;"},{"type":"p","text":"abilities;"},{"type":"p","text":"Taunt;"},{"type":"p","text":"AI."},{"type":"p","text":"Not a general stat that everyone needs to farm."},{"type":"h1","text":"Core Stats Summary"},{"type":"p","text":"HP | ATK | MAG | DEF | RES | CRIT RATE | CRIT DMG | ELEMENTAL DMG | ENERGY RECHARGE | ALCHEMY"},{"type":"p","text":"plus:"},{"type":"p","text":"UNIQUE SCALING"},{"type":"p","text":"for specific characters."},{"type":"h1","text":"3. Damage Formula"},{"type":"p","text":"The historical sources describe stats, but they do not provide a complete damage formula. We need a modular formula so it can be balanced without rebuilding the entire game."},{"type":"h2","text":"Conceptual Formula"},{"type":"p","text":"Final damage is calculated through:"},{"type":"p","text":"BASE POWER × SKILL COEFFICIENT × BONUSES × CRITICAL (If applicable) × REACTION × MITIGATION × RESISTANCE"},{"type":"h1","text":"Step 1. Raw Damage"},{"type":"p","text":"For an ATK-based ability:"},{"type":"p","text":"Raw Damage = ATK × Skill Coefficient + Flat Damage"},{"type":"p","text":"Example:"},{"type":"p","text":"ATK = 1,000"},{"type":"p","text":"Skill Coefficient = 1.50"},{"type":"p","text":"Flat Damage = 100"},{"type":"p","text":"Result:"},{"type":"p","text":"1,000 × 1.50 + 100 = 1,600"},{"type":"h1","text":"Hybrid Scaling"},{"type":"p","text":"Some characters may use:"},{"type":"p","text":"Raw Damage = (HP × CoefA) + (ATK × CoefB) + Flat"},{"type":"p","text":"or even Alchemy/DEF."},{"type":"p","text":"However, hybrid kits should be used sparingly to avoid builds that are impossible to understand."},{"type":"h1","text":"Step 2. Damage Bonuses"},{"type":"p","text":"Bonus Multiplier = 1 + Sum of Relevant Damage Bonuses"},{"type":"p","text":"Example:"},{"type":"p","text":"+20 % Cryo Damage"},{"type":"p","text":"+15 % Skill Damage"},{"type":"p","text":"Result:"},{"type":"p","text":"1 + 0.20 + 0.15 = 1.35"},{"type":"h1","text":"Step 3. Critical"},{"type":"p","text":"If no critical hit occurs:"},{"type":"p","text":"Crit Multiplier = 1"},{"type":"p","text":"If one occurs:"},{"type":"p","text":"Crit Multiplier = 1 + Critical Damage"},{"type":"p","text":"Example:"},{"type":"p","text":"Critical Damage = 0.70"},{"type":"p","text":"Result:"},{"type":"p","text":"1.70×"},{"type":"h1","text":"Step 4. Defense Mitigation"},{"type":"p","text":"I do not recommend a linear reduction such as:"},{"type":"p","text":"DEF 500 = subtract 500 damage."},{"type":"p","text":"That makes defense behave very strangely against both small and large attacks."},{"type":"p","text":"I propose:"},{"type":"h3","text":"Defense Multiplier"},{"type":"p","text":"K / (K + Effective DEF)"},{"type":"p","text":"where K scales with the attacker’s level."},{"type":"p","text":"Initial proposal:"},{"type":"p","text":"K = 100 + (10 × Attacker Level)"},{"type":"p","text":"Example:"},{"type":"p","text":"Level 90:"},{"type":"p","text":"K = 1,000."},{"type":"p","text":"Enemy with DEF 500:"},{"type":"p","text":"1,000 / (1,000 + 500) = 0.667"},{"type":"p","text":"The attack retains approximately:"},{"type":"h3","text":"66.7 % of its damage."},{"type":"h1","text":"Defense Reduction"},{"type":"p","text":"If a debuff reduces:"},{"type":"p","text":"DEF -20 %"},{"type":"p","text":"Then:"},{"type":"p","text":"Effective DEF = DEF × 0.80"},{"type":"p","text":"This modifies mitigation, not base damage."},{"type":"h1","text":"Step 5. Resistance"},{"type":"p","text":"To keep the formula readable:"},{"type":"p","text":"Resistance Multiplier = 1 - Effective Resistance"},{"type":"p","text":"Example:"},{"type":"p","text":"20 % Cryo Resistance:"},{"type":"p","text":"1 - 0.20 = 0.80×"},{"type":"h2","text":"Proposed Limits"},{"type":"h3","text":"Maximum positive Resistance"},{"type":"p","text":"80 % → minimum 0.20× damage."},{"type":"h3","text":"Maximum negative Resistance"},{"type":"p","text":"-50 % → maximum 1.50× through resistance."},{"type":"h1","text":"Chaos"},{"type":"p","text":"As already defined in Elements and Reactions, Chaos can reduce an elemental resistance."},{"type":"p","text":"Example:"},{"type":"p","text":"Cryo Resistance: 20 %"},{"type":"p","text":"Chaos Exposure: -30 %"},{"type":"p","text":"Result: -10 %"},{"type":"p","text":"Multiplier: 1.10×"},{"type":"h1","text":"Provisional Complete Formula"},{"type":"p","text":"We can formalize it as:"},{"type":"p","text":"Final Damage = Round[ Raw × Bonus × Crit × Reaction × Defense × Resistance × Vulnerability ]"},{"type":"p","text":"where:"},{"type":"p","text":"Raw = stat × coefficient + flat;"},{"type":"p","text":"Bonus = relevant bonuses;"},{"type":"p","text":"Crit = critical;"},{"type":"p","text":"Reaction = reaction modifier;"},{"type":"p","text":"Defense = DEF mitigation;"},{"type":"p","text":"Resistance = elemental/physical resistance;"},{"type":"p","text":"Vulnerability = specific debuffs."},{"type":"h1","text":"Damage Floor"},{"type":"p","text":"Every valid attack can deal a minimum of:"},{"type":"h3","text":"1 damage"},{"type":"p","text":"except in cases of:"},{"type":"p","text":"immunity;"},{"type":"p","text":"shield;"},{"type":"p","text":"invulnerability;"},{"type":"p","text":"special mechanic."},{"type":"h1","text":"4. Healing and Shields"},{"type":"h2","text":"Development"},{"type":"p","text":"Healing and shields should use formulas similar to damage so they can be balanced with the same tools. The documentation already includes medical and support characters, and Hizuka specifically converts part of their healing into protection, so both systems need to coexist."},{"type":"h1","text":"Healing"},{"type":"h2","text":"Base Formula"},{"type":"p","text":"Healing = (Scaling Stat × Heal Coefficient + Flat Healing) × Healing Bonus × Healing Received"},{"type":"p","text":"The Scaling Stat may be:"},{"type":"p","text":"HP;"},{"type":"p","text":"ATK;"},{"type":"p","text":"DEF;"},{"type":"p","text":"a unique stat."},{"type":"p","text":"Example:"},{"type":"p","text":"Hizuka:"},{"type":"p","text":"Heal Coefficient = 0.50"},{"type":"p","text":"Flat = 300"},{"type":"p","text":"Healing Bonus = +20 %"},{"type":"p","text":"Result:"},{"type":"p","text":"Base:"},{"type":"p","text":"1,200 × 0.50 + 300 = 900"},{"type":"p","text":"With bonus:"},{"type":"p","text":"900 × 1.20 = 1,080 HP"},{"type":"h1","text":"Healing Bonus"},{"type":"p","text":"Belongs to the healer."},{"type":"h1","text":"Healing Received"},{"type":"p","text":"Belongs to the target."},{"type":"p","text":"Example:"},{"type":"p","text":"Debuff: Healing Received -30 %"},{"type":"p","text":"Then:"},{"type":"p","text":"1,080 × 0.70 = 756 HP"},{"type":"h1","text":"Overhealing"},{"type":"p","text":"By default: Health cannot exceed maximum HP."},{"type":"p","text":"Excess healing is lost. However, certain kits may convert Overheal into:"},{"type":"p","text":"shield;"},{"type":"p","text":"resource;"},{"type":"p","text":"buff."},{"type":"p","text":"Hizuka would be a natural candidate for this."},{"type":"h1","text":"Shields"},{"type":"h2","text":"Formula"},{"type":"p","text":"Shield = Scaling Stat × Shield Coefficient + Flat Shield"},{"type":"p","text":"Then:"},{"type":"p","text":"Final Shield = Shield × Shield Bonus"},{"type":"h1","text":"Duration"},{"type":"p","text":"Shields should have:"},{"type":"p","text":"amount;"},{"type":"p","text":"duration."},{"type":"p","text":"Example:"},{"type":"p","text":"1,500 Shield / 12 seconds"},{"type":"h1","text":"Shield Cap"},{"type":"p","text":"To prevent immortal compositions:"},{"type":"h3","text":"Initial general cap"},{"type":"p","text":"50 % of the target’s maximum HP"},{"type":"p","text":"in simultaneous shields."},{"type":"p","text":"Example:"},{"type":"p","text":"HP 10,000."},{"type":"p","text":"Stacked shields:"},{"type":"p","text":"standard maximum:"},{"type":"h3","text":"5,000."},{"type":"p","text":"Guardians or special talents may modify this limit."},{"type":"h1","text":"Damage Order"},{"type":"p","text":"When a character receives damage: SHIELD → HP unless a mechanic states otherwise."},{"type":"h1","text":"Buffs"},{"type":"p","text":"They may increase:"},{"type":"p","text":"Healing Bonus;"},{"type":"p","text":"Shield Strength;"},{"type":"p","text":"Healing Received."},{"type":"h1","text":"Debuffs"},{"type":"p","text":"They may reduce:"},{"type":"p","text":"healing;"},{"type":"p","text":"shields;"},{"type":"p","text":"duration."},{"type":"p","text":"However, I would avoid a standard debuff of: -100 % healing"},{"type":"p","text":"except for a very specific and clearly communicated mechanic."},{"type":"h1","text":"5. Enemy Scaling"},{"type":"h2","text":"Development"},{"type":"p","text":"Enemy difficulty should grow along two dimensions:"},{"type":"p","text":"STATS + BEHAVIOR"},{"type":"p","text":"Not numbers alone."},{"type":"h1","text":"Stat Scaling"},{"type":"p","text":"Enemies may increase:"},{"type":"p","text":"HP;"},{"type":"p","text":"ATK;"},{"type":"p","text":"DEF;"},{"type":"p","text":"RES;"},{"type":"p","text":"stagger resistance."},{"type":"p","text":"But along controlled curves."},{"type":"h2","text":"Normal Enemies"},{"type":"p","text":"Scaling can be approximately linear relative to the recommended level."},{"type":"h2","text":"Elite"},{"type":"p","text":"They add:"},{"type":"p","text":"moderately higher stats;"},{"type":"p","text":"an additional ability;"},{"type":"p","text":"greater resistance to control."},{"type":"h2","text":"Bosses"},{"type":"p","text":"Difficulty should come primarily from:"},{"type":"p","text":"mechanics;"},{"type":"p","text":"phases;"},{"type":"p","text":"telegraphs;"},{"type":"p","text":"weak points;"},{"type":"p","text":"arena;"},{"type":"p","text":"pressure."},{"type":"p","text":"Not from having fifty times the Health of a normal enemy."},{"type":"h1","text":"Difficulty Multipliers"},{"type":"p","text":"Initial prototype-only values:"},{"type":"table","table":2},{"type":"p","text":"The intent is to demonstrate something important: Challenge does not mean 4× HP."},{"type":"h1","text":"AI Scaling"},{"type":"p","text":"At higher difficulties, the enemy may:"},{"type":"p","text":"react faster;"},{"type":"p","text":"combine abilities;"},{"type":"p","text":"reposition more effectively;"},{"type":"p","text":"prioritize targets;"},{"type":"p","text":"protect allies;"},{"type":"p","text":"interrupt;"},{"type":"p","text":"use new sequences."},{"type":"p","text":"But its behavior must remain readable."},{"type":"h1","text":"Damage Sponges"},{"type":"p","text":"To detect excessive HP, we need to define:"},{"type":"h3","text":"Target Time To Kill | TTK"},{"type":"p","text":"Provisional example:"},{"type":"p","text":"Normal Enemy: 5–15 s."},{"type":"p","text":"Elite: 20–45 s."},{"type":"p","text":"Subboss: 1–3 min."},{"type":"p","text":"Boss: 3–7 min."},{"type":"h1","text":"Problem Indicator"},{"type":"p","text":"If the player understands all the mechanics, is properly developed, and after solving the encounter only needs to repeat their rotation for another four minutes:"},{"type":"p","text":"The enemy probably has too much HP."},{"type":"h1","text":"6. Character Power Budget"},{"type":"h2","text":"Development"},{"type":"p","text":"Character balance cannot be reduced to: “Who deals more DPS?”"},{"type":"p","text":"because there are:"},{"type":"p","text":"healers;"},{"type":"p","text":"Guardians;"},{"type":"p","text":"Debuffers;"},{"type":"p","text":"Controllers;"},{"type":"p","text":"hybrids;"},{"type":"p","text":"specialized characters."},{"type":"p","text":"We need to compare the total value contributed to the team."},{"type":"h1","text":"Power Budget"},{"type":"p","text":"During design, each character may internally receive:"},{"type":"h3","text":"100 Budget Points"},{"type":"p","text":"This does NOT appear to the player. It is a conceptual tool for designers."},{"type":"p","text":"The points represent the approximate distribution of power among:"},{"type":"p","text":"damage;"},{"type":"p","text":"utility;"},{"type":"p","text":"control;"},{"type":"p","text":"survivability;"},{"type":"p","text":"mobility;"},{"type":"p","text":"elemental application."},{"type":"h1","text":"Conceptual Example"},{"type":"h2","text":"Pure DPS"},{"type":"p","text":"Damage: 60"},{"type":"p","text":"Utility: 10"},{"type":"p","text":"Control: 5"},{"type":"p","text":"Survival: 10"},{"type":"h2","text":"Support"},{"type":"p","text":"Damage: 15"},{"type":"p","text":"Utility: 45"},{"type":"p","text":"Control: 10"},{"type":"p","text":"Survival contribution: 20"},{"type":"h2","text":"Guardian"},{"type":"p","text":"Damage: 20"},{"type":"p","text":"Protection: 45"},{"type":"p","text":"Control: 15"},{"type":"p","text":"Survival: 15"},{"type":"p","text":"These numbers are not final formulas. They are meant to answer: if we increase something, what are we sacrificing?"},{"type":"h1","text":"Rarity and Budget"},{"type":"p","text":"I do not recommend:"},{"type":"h3","text":"4★ = 80 points"},{"type":"h3","text":"5★ = 120 points."},{"type":"p","text":"That would turn rarity directly into obsolescence. As already defined in Gacha System:"},{"type":"p","text":"rarity can increase complexity, presentation, and specialization without automatically invalidating lower-rarity characters."},{"type":"p","text":"Therefore, 4★ and 5★ should operate within relatively close gameplay budgets."},{"type":"h1","text":"Metrics by Role"},{"type":"h2","text":"Damage Dealer"},{"type":"p","text":"Measure:"},{"type":"p","text":"DPS 30 s;"},{"type":"p","text":"Burst 10 s;"},{"type":"p","text":"damage per Field Time;"},{"type":"p","text":"AoE damage;"},{"type":"p","text":"Single Target damage."},{"type":"h2","text":"Support"},{"type":"p","text":"Measure:"},{"type":"h3","text":"Team Damage Increase"},{"type":"p","text":"How much the character increases the party’s total damage. Not their own DPS."},{"type":"h2","text":"Healer"},{"type":"p","text":"Measure:"},{"type":"p","text":"Healing per Second;"},{"type":"p","text":"Effective Healing;"},{"type":"p","text":"Overheal;"},{"type":"p","text":"time required for recovery."},{"type":"h2","text":"Guardian"},{"type":"p","text":"Measure:"},{"type":"p","text":"damage prevented;"},{"type":"p","text":"Shield uptime;"},{"type":"p","text":"interception;"},{"type":"p","text":"survivability provided."},{"type":"h2","text":"Controller"},{"type":"p","text":"Measure:"},{"type":"p","text":"control uptime;"},{"type":"p","text":"interrupts;"},{"type":"p","text":"grouping;"},{"type":"p","text":"vulnerability created."},{"type":"h1","text":"Field Time"},{"type":"p","text":"In an Action RPG with character switching: The time a character needs to remain active is also a cost."},{"type":"p","text":"A character who produces:"},{"type":"p","text":"10,000 damage"},{"type":"p","text":"in 2 seconds"},{"type":"p","text":"may provide more flexibility than another who produces:"},{"type":"p","text":"12,000"},{"type":"p","text":"in 12 seconds."},{"type":"p","text":"Therefore, we need to measure:"},{"type":"h3","text":"Output / Field Time."},{"type":"h1","text":"Cooldown Economy"},{"type":"p","text":"We also need to compare: impact / cooldown."},{"type":"p","text":"A Skill that deals 20,000 every 20 seconds is not equivalent to one that deals 15,000 every 5."},{"type":"h1","text":"Buff Criteria"},{"type":"p","text":"Consider a Buff when, during comparable testing:"},{"type":"p","text":"performance is persistently below the role target;"},{"type":"p","text":"its mechanic does not justify the cost;"},{"type":"p","text":"its use requires disproportionate effort;"},{"type":"p","text":"another character replaces it in practically every situation;"},{"type":"p","text":"its fantasy is not expressed correctly."},{"type":"p","text":"An initial reference: 10–15 % below its role target"},{"type":"p","text":"may trigger investigation."},{"type":"p","text":"No automatic Buff."},{"type":"h1","text":"Nerf Criteria"},{"type":"p","text":"Investigate when:"},{"type":"p","text":"it persistently exceeds the role target;"},{"type":"p","text":"it makes alternatives irrelevant;"},{"type":"p","text":"it trivializes mechanics;"},{"type":"p","text":"it appears almost mandatory across different content;"},{"type":"p","text":"an interaction produces unintended scaling."},{"type":"p","text":"Initial reference: 15–20 % above the comparable target"},{"type":"p","text":"may justify review."},{"type":"h1","text":"Important in a Gacha"},{"type":"p","text":"A Nerf after the release of a character acquired with resources or money has enormous implications for:"},{"type":"p","text":"trust;"},{"type":"p","text":"perception;"},{"type":"p","text":"economy."},{"type":"p","text":"Therefore, the priority should be:"},{"type":"p","text":"fix bugs;"},{"type":"p","text":"adjust enemies/systems when the problem is systemic;"},{"type":"p","text":"improve weak characters;"},{"type":"p","text":"directly nerf only when there is a serious problem."},{"type":"p","text":"And any major adjustment should be communicated transparently."},{"type":"h1","text":"Popularity Does Not Equal Power"},{"type":"p","text":"A character may have: 70 % Pick Rate"},{"type":"p","text":"because they are:"},{"type":"p","text":"the protagonist;"},{"type":"p","text":"attractive;"},{"type":"p","text":"easy to use;"},{"type":"p","text":"free."},{"type":"p","text":"That does not automatically prove they are broken. Decisions must be based on multiple metrics."},{"type":"h1","text":"7. Testing Plan"},{"type":"h2","text":"Development"},{"type":"p","text":"Balance cannot be declared correct simply because: “it feels good when I play it.”"},{"type":"p","text":"We need to combine: SIMULATION + PLAYTEST + TELEMETRY + OBSERVATION"},{"type":"p","text":"The Game Vision already establishes that testing must verify that real decisions exist, that characters feel different, that reactions are understandable, and that the player can identify problems without constant explanations."},{"type":"h1","text":"Phase 1. Formula Testing"},{"type":"p","text":"Before playtesting:"},{"type":"h3","text":"Automated Tests"},{"type":"p","text":"Check:"},{"type":"p","text":"damage;"},{"type":"p","text":"DEF;"},{"type":"p","text":"resistance;"},{"type":"p","text":"critical;"},{"type":"p","text":"healing;"},{"type":"p","text":"shield;"},{"type":"p","text":"caps;"},{"type":"p","text":"negative values;"},{"type":"p","text":"edge cases."},{"type":"p","text":"Minimum target:"},{"type":"h3","text":"50–100 automated cases per critical mathematical system"},{"type":"p","text":"Examples:"},{"type":"p","text":"DEF = 0;"},{"type":"p","text":"RES = 80 %;"},{"type":"p","text":"RES = -50 %;"},{"type":"p","text":"CR = 0 %;"},{"type":"p","text":"CR = 100 %;"},{"type":"p","text":"HP = 1;"},{"type":"p","text":"shield cap;"},{"type":"p","text":"simultaneous buffs."},{"type":"h1","text":"Phase 2. Simulation"},{"type":"p","text":"Use spreadsheets or internal tools. For each character:"},{"type":"p","text":"multiple builds;"},{"type":"p","text":"equivalent investment;"},{"type":"p","text":"different enemies;"},{"type":"p","text":"10 s window;"},{"type":"p","text":"30 s;"},{"type":"p","text":"60 s."},{"type":"p","text":"We can run thousands of mathematical calculations."},{"type":"p","text":"Example:"},{"type":"h3","text":"10,000 simulated crit events"},{"type":"p","text":"to verify that 25 % Critical Rate produces approximately the expected distribution."},{"type":"p","text":"This does not replace gameplay. It only verifies the mathematics."},{"type":"h1","text":"Phase 3. Developer Playtest"},{"type":"p","text":"For each major encounter:"},{"type":"h3","text":"Recommended minimum"},{"type":"p","text":"20–30 internal clears"},{"type":"p","text":"using different compositions."},{"type":"p","text":"Ideally:"},{"type":"h3","text":"5+ different compositions."},{"type":"p","text":"Include:"},{"type":"p","text":"offensive team;"},{"type":"p","text":"defensive team;"},{"type":"p","text":"F2P;"},{"type":"p","text":"less optimized characters;"},{"type":"p","text":"experimental compositions."},{"type":"h1","text":"Phase 4. External Playtest"},{"type":"p","text":"For prototype/Vertical Slice:"},{"type":"h3","text":"First round"},{"type":"p","text":"10–15 players"},{"type":"p","text":"to identify major problems."},{"type":"h3","text":"Second round"},{"type":"p","text":"30–50 players"},{"type":"p","text":"after corrections."},{"type":"h3","text":"Future Beta"},{"type":"p","text":"Hundreds or thousands of sessions once the infrastructure exists."},{"type":"h1","text":"Combat Metrics"},{"type":"p","text":"Record:"},{"type":"h3","text":"Clear Rate"},{"type":"p","text":"Percentage of victories."},{"type":"h3","text":"Attempts to Clear"},{"type":"p","text":"Attempts before victory."},{"type":"h3","text":"Time to Kill"},{"type":"p","text":"Encounter duration."},{"type":"h3","text":"Death Rate"},{"type":"p","text":"Characters defeated."},{"type":"h3","text":"Failure Cause"},{"type":"p","text":"Which attack/mechanic caused the defeat."},{"type":"h3","text":"Damage Taken"},{"type":"p","text":"Damage received."},{"type":"h3","text":"Dodge Success"},{"type":"p","text":"Percentage of correctly avoided telegraphed attacks."},{"type":"h3","text":"Skill Usage"},{"type":"p","text":"Frequency."},{"type":"h3","text":"Ultimate Usage"},{"type":"p","text":"Frequency."},{"type":"h3","text":"Reaction Usage"},{"type":"p","text":"Which reactions appear."},{"type":"h3","text":"Character Usage"},{"type":"p","text":"Selected characters."},{"type":"h3","text":"Team Composition"},{"type":"p","text":"Compositions."},{"type":"h3","text":"Field Time"},{"type":"p","text":"Active time for each character."},{"type":"h3","text":"Damage Contribution"},{"type":"p","text":"Per character."},{"type":"h3","text":"Healing Effective / Overheal"},{"type":"p","text":"Useful healing vs wasted healing."},{"type":"h3","text":"Shield Effective / Wasted"},{"type":"p","text":"Shields absorbed vs expired."},{"type":"h3","text":"Consumable Usage"},{"type":"p","text":"Items used."},{"type":"h3","text":"Restart / Abandon Rate"},{"type":"p","text":"Abandonment."},{"type":"h1","text":"Preliminary Targets by Difficulty"},{"type":"p","text":"For external players with recommended gear:"},{"type":"h2","text":"Normal"},{"type":"p","text":"Clear Rate after understanding the rules:"},{"type":"h3","text":"75–90 %"},{"type":"h2","text":"Hard"},{"type":"h3","text":"50–70 %"},{"type":"h2","text":"Challenge"},{"type":"p","text":"First attempts:"},{"type":"h3","text":"20–40 %"},{"type":"p","text":"but it should increase clearly as players learn."},{"type":"h1","text":"Learning Metric"},{"type":"p","text":"Very important:"},{"type":"p","text":"After a defeat, ask:"},{"type":"p","text":"“Why do you think you lost?”"},{"type":"p","text":"Ideally:"},{"type":"h3","text":"80 %+"},{"type":"p","text":"of players should be able to correctly identify the main cause after a few attempts."},{"type":"p","text":"If they cannot: we probably have a readability problem, not a difficulty problem."},{"type":"h1","text":"Character Balance Testing"},{"type":"p","text":"Each character must be tested with:"},{"type":"h3","text":"Baseline Build"},{"type":"p","text":"Standard investment."},{"type":"h3","text":"Optimized Build"},{"type":"p","text":"Advanced investment."},{"type":"h3","text":"Alternative Build"},{"type":"p","text":"Another viable interpretation."},{"type":"h3","text":"Weak Synergy"},{"type":"p","text":"Unfavorable team."},{"type":"h3","text":"Strong Synergy"},{"type":"p","text":"Favorable team."},{"type":"p","text":"This allows us to detect characters that:"},{"type":"p","text":"only work with one partner;"},{"type":"p","text":"scale too much;"},{"type":"p","text":"do not scale enough."},{"type":"h1","text":"Reaction Testing"},{"type":"p","text":"Each reaction should record:"},{"type":"p","text":"usage;"},{"type":"p","text":"damage;"},{"type":"p","text":"utility;"},{"type":"p","text":"control;"},{"type":"p","text":"frequency;"},{"type":"p","text":"situations where it is used."},{"type":"p","text":"If one reaction represents:"},{"type":"p","text":"70 % of Endgame reactions"},{"type":"p","text":"we need to investigate why."},{"type":"p","text":"Not necessarily nerf it immediately."},{"type":"h1","text":"Version Stability Criteria"},{"type":"p","text":"A balance version can be considered stable when:"},{"type":"h3","text":"Mathematics"},{"type":"p","text":"there are no critical errors;"},{"type":"p","text":"caps work;"},{"type":"p","text":"edge cases pass."},{"type":"h3","text":"Characters"},{"type":"p","text":"no character persistently exceeds the expected limits without a design reason;"},{"type":"p","text":"all have at least one clear use case."},{"type":"h3","text":"Encounters"},{"type":"p","text":"TTK is approximately within ±15 % of the target;"},{"type":"p","text":"there are no non-telegraphed one-shots;"},{"type":"p","text":"multiple viable compositions exist."},{"type":"h3","text":"Readability"},{"type":"p","text":"players understand attacks and statuses."},{"type":"h3","text":"Reactions"},{"type":"p","text":"none dominates every scenario."},{"type":"h3","text":"Testing"},{"type":"p","text":"the main problems from the last two iterations do not require structural changes."},{"type":"h1","text":"Balance Freeze"},{"type":"p","text":"Before an important build:"},{"type":"h3","text":"Balance Freeze"},{"type":"p","text":"For a short period before release, no casual numerical changes are added."},{"type":"p","text":"Only:"},{"type":"p","text":"critical bug;"},{"type":"p","text":"exploit;"},{"type":"p","text":"severe problem."},{"type":"p","text":"This allows QA to test a stable version instead of a creature whose stats change every Tuesday."}],"tables":[[["Status","DRAFT","Version","0.15.7"],["Owner","J. Crow","Last updated","20/08/2026"]],[["Variable","Normal","Hard","Challenge"],["Enemy HP","Base","Moderately higher","Moderately higher"],["Enemy Damage","Base","Higher","High"],["Telegraph","Wide","Narrower","Precise"],["Mechanics","Fundamental","Combined","Advanced"],["AI","Standard","More aggressive","Specialized"],["Margin for Error","High","Medium","Low"],["Required Build","Functional","Optimized","Specialized"],["Reward","Normal","Improved","Prestige/advanced"]],[["Difficulty","HP","Damage","Mechanics"],["Normal","1.00×","1.00×","Base"],["Hard","1.15×","1.15×","+ variations"],["Challenge","1.25×","1.30×","+ advanced mechanics"]]]}