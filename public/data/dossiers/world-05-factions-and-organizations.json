{"id":"world-05-factions-and-organizations","group":"world","groupLabel":"World & Lore","number":"05","title":"Factions and Organizations","summary":"Profiles institutions, clans and organizations by structure, ideology, relationships, narrative role and control of information.","sourceFile":"World and Lore/05 - Factions and Organizations.docx","meta":{"status":"DRAFT","version":"0.15.7","owner":"J. Crow","last_updated":"29/08/2026"},"headings":[{"level":1,"text":"Organization Profile"},{"level":2,"text":"Identity"},{"level":2,"text":"Structure"},{"level":2,"text":"Ideology"},{"level":2,"text":"Relationships"},{"level":2,"text":"Narrative"},{"level":1,"text":"Control"},{"level":1,"text":"Sources to consult"},{"level":1,"text":"1. Document Purpose"},{"level":1,"text":"2. Classification Rule"},{"level":1,"text":"3. Overview"},{"level":1,"text":"4. Ministry of Whispers"},{"level":2,"text":"Identity"},{"level":3,"text":"Official Name"},{"level":1,"text":"Ministry of Whispers"},{"level":3,"text":"Classification"},{"level":3,"text":"Purpose"},{"level":1,"text":"Origin"},{"level":1,"text":"Luther"},{"level":1,"text":"Cosmological Distinction"},{"level":1,"text":"creation built by mortals."},{"level":1,"text":"5. Ministry Structure"},{"level":2,"text":"Current Leadership"},{"level":1,"text":"Juro Shinigami Octophus"},{"level":1,"text":"Historical Figure"},{"level":1,"text":"Luther"},{"level":1,"text":"Known Areas"},{"level":3,"text":"Aligura Bluer"},{"level":3,"text":"Hizuka Tamayo"},{"level":3,"text":"Serverus Lazoi"},{"level":1,"text":"Recruitment"},{"level":3,"text":"Possible Criteria"},{"level":1,"text":"Ideology"},{"level":1,"text":"Limits"},{"level":1,"text":"Relationships"},{"level":3,"text":"Major Nations"},{"level":3,"text":"Purgatory"},{"level":3,"text":"Shinigami"},{"level":3,"text":"Memento Mori"},{"level":3,"text":"Bird Executioners"},{"level":1,"text":"Narrative"},{"level":1,"text":"6. Purgatory"},{"level":2,"text":"Identity"},{"level":1,"text":"Purgatory"},{"level":3,"text":"Classification"},{"level":1,"text":"Institutional Purpose"},{"level":1,"text":"Origin"},{"level":1,"text":"Historical Affiliation"},{"level":1,"text":"Headquarters"},{"level":1,"text":"Important Historical Guardian"},{"level":1,"text":"Isabell"},{"level":1,"text":"Recruitment"},{"level":1,"text":"Ideology"},{"level":1,"text":"Relationships"},{"level":3,"text":"Archangels"},{"level":3,"text":"Shinigami"},{"level":3,"text":"Ministry"},{"level":3,"text":"Arcane / Thanatos"},{"level":1,"text":"Narrative"},{"level":1,"text":"7. Shinigami"},{"level":2,"text":"Identity"},{"level":1,"text":"Shinigami"},{"level":3,"text":"Classification"},{"level":3,"text":"Historical Founder"},{"level":1,"text":"The Black Lotus"},{"level":1,"text":"Purpose"},{"level":1,"text":"Temporal Origin"},{"level":1,"text":"Ideology"},{"level":1,"text":"Limits"},{"level":1,"text":"Relationships"},{"level":3,"text":"Purgatory"},{"level":3,"text":"Thanatos"},{"level":3,"text":"Ministry"},{"level":3,"text":"Nations"},{"level":1,"text":"Primary Related Character"},{"level":1,"text":"Juro"},{"level":1,"text":"Narrative"},{"level":1,"text":"8. Writers"},{"level":2,"text":"Identity"},{"level":1,"text":"The Writers"},{"level":3,"text":"Classification"},{"level":1,"text":"Founder"},{"level":1,"text":"Major God"},{"level":1,"text":"Purpose"},{"level":1,"text":"Headquarters"},{"level":1,"text":"Plane of the Writers"},{"level":1,"text":"Symbol"},{"level":1,"text":"Structure"},{"level":1,"text":"Recruitment"},{"level":1,"text":"Ideology"},{"level":1,"text":"Limits"},{"level":1,"text":"Relationships"},{"level":1,"text":"Narrative"},{"level":1,"text":"9. Project Limbo of Osiris"},{"level":2,"text":"Identity"},{"level":1,"text":"Project Limbo of Osiris"},{"level":3,"text":"PLO"},{"level":3,"text":"Classification"},{"level":1,"text":"Purpose"},{"level":1,"text":"Founder"},{"level":1,"text":"Zileus"},{"level":1,"text":"Technology / Magic"},{"level":1,"text":"temporal suspension"},{"level":1,"text":"Ideology"},{"level":1,"text":"Fundamental Ethical Line"},{"level":1,"text":"CONSENT"},{"level":1,"text":"Headquarters"},{"level":1,"text":"Relationships"},{"level":3,"text":"Memento Mori"},{"level":3,"text":"Ministry"},{"level":3,"text":"Writers"},{"level":1,"text":"Narrative"},{"level":1,"text":"10. Memento Mori"},{"level":2,"text":"Identity"},{"level":1,"text":"Memento Mori"},{"level":3,"text":"Conceptual Meaning"},{"level":3,"text":"Classification"},{"level":1,"text":"Origin"},{"level":1,"text":"Purpose"},{"level":1,"text":"Distinctive Feature"},{"level":1,"text":"Known Representatives"},{"level":2,"text":"Arcane"},{"level":3,"text":"Draken"},{"level":2,"text":"Ministry"},{"level":3,"text":"Luther"},{"level":1,"text":"Symbol"},{"level":1,"text":"Ideology"},{"level":1,"text":"Relationships"},{"level":3,"text":"Ministry"},{"level":3,"text":"Governments"},{"level":1,"text":"legal authority vs. historical authority."},{"level":1,"text":"Narrative"},{"level":1,"text":"11. Fifth Clan"},{"level":2,"text":"Identity"},{"level":1,"text":"Fifth Clan"},{"level":3,"text":"Classification"},{"level":1,"text":"Origin"},{"level":1,"text":"Purpose"},{"level":1,"text":"Ideology"},{"level":1,"text":"Relationship with Time"},{"level":1,"text":"Deity"},{"level":1,"text":"Headquarters"},{"level":1,"text":"Recruitment"},{"level":1,"text":"Narrative"},{"level":1,"text":"12. Bird Executioners"},{"level":2,"text":"Identity"},{"level":1,"text":"Bird Executioners"},{"level":3,"text":"Classification"},{"level":1,"text":"Important"},{"level":1,"text":"They are NOT the Fifth Clan."},{"level":1,"text":"Historical Origin"},{"level":1,"text":"Current Canon"},{"level":1,"text":"Philosophy"},{"level":1,"text":"Relationship with the Fifth Clan"},{"level":3,"text":"Related"},{"level":3,"text":"Same organization"},{"level":1,"text":"13. Elemental Edge Entities"},{"level":2,"text":"Current Name"},{"level":1,"text":"Elemental Edge Entities"},{"level":3,"text":"Former Name"},{"level":3,"text":"Status of Former Name"},{"level":1,"text":"Classification"},{"level":1,"text":"Origin"},{"level":1,"text":"Major Rupture"},{"level":1,"text":"Purpose"},{"level":1,"text":"Headquarters"},{"level":1,"text":"Structure"},{"level":1,"text":"Recruitment"},{"level":1,"text":"Relationships"},{"level":3,"text":"Beasts"},{"level":3,"text":"Writers"},{"level":1,"text":"Narrative"},{"level":1,"text":"14. Crescent Moon Circus"},{"level":2,"text":"Identity"},{"level":1,"text":"Crescent Moon Circus"},{"level":3,"text":"Classification"},{"level":1,"text":"Origin"},{"level":1,"text":"Current Purpose"},{"level":1,"text":"Front"},{"level":1,"text":"Headquarters"},{"level":1,"text":"The Circus itself."},{"level":1,"text":"Movement"},{"level":1,"text":"Ideology"},{"level":1,"text":"INDEPENDENCE"},{"level":1,"text":"Moral Limits"},{"level":1,"text":"Related Characters"},{"level":1,"text":"Relationships"},{"level":3,"text":"Mafia"},{"level":3,"text":"Ministry"},{"level":3,"text":"Nations"},{"level":1,"text":"Narrative"},{"level":1,"text":"15. Snow Messenger Foxes"},{"level":2,"text":"Identity"},{"level":1,"text":"Snow Messenger Foxes"},{"level":3,"text":"Classification"},{"level":1,"text":"Origin"},{"level":1,"text":"Members"},{"level":1,"text":"Purpose"},{"level":1,"text":"Reputation"},{"level":1,"text":"Headquarters"},{"level":1,"text":"Structure"},{"level":1,"text":"Neutrality"},{"level":1,"text":"Lines They Should Not Cross"},{"level":1,"text":"Narrative"},{"level":1,"text":"16. The Boarding School"},{"level":1,"text":"historical diplomatic and educational institution."},{"level":1,"text":"Purpose"},{"level":1,"text":"Known Historical Members"},{"level":1,"text":"Destruction"},{"level":1,"text":"Current Status"},{"level":1,"text":"INACTIVE / RUINS / HISTORICAL LEGACY"},{"level":1,"text":"Importance"},{"level":1,"text":"17. Beasts of the Apocalypse"},{"level":1,"text":"Provisional Classification"},{"level":1,"text":"Historical Purpose"},{"level":1,"text":"Relationship"},{"level":1,"text":"Current Status"},{"level":1,"text":"18. Mafia Subfactions"}],"blocks":[{"type":"title","text":"Factions & Organizations"},{"type":"p","text":"Clans, institutions, and transnational groups"},{"type":"p","text":"Public project: Symphony of Justice | Internal/original name: Symphonia Iustitiae"},{"type":"table","table":0},{"type":"h1","text":"Organization Profile"},{"type":"h2","text":"Identity"},{"type":"p","text":"Name, purpose, origin, symbol, headquarters."},{"type":"h2","text":"Structure"},{"type":"p","text":"Hierarchy, ranks, leadership, recruitment."},{"type":"h2","text":"Ideology"},{"type":"p","text":"What it believes, what it wants, what lines it will or will not cross."},{"type":"h2","text":"Relationships"},{"type":"p","text":"Allies, rivals, infiltrations, dependence on governments."},{"type":"h2","text":"Narrative"},{"type":"p","text":"What conflicts it enables."},{"type":"p","text":"Which characters are connected to it."},{"type":"h1","text":"Control"},{"type":"p","text":"Distinguish whether the organization is legal, religious, criminal, military, academic, or secret."},{"type":"p","text":"Record whether its existence is public or secret knowledge."},{"type":"h1","text":"Sources to consult"},{"type":"p","text":"Project Simphony of Justice / Faith Balance Proyect"},{"type":"p","text":"Arcane Company New Story"},{"type":"p","text":"Arcane company"},{"type":"p","text":"Arcane company diseño"},{"type":"p","text":"Personajes"},{"type":"p","text":"Game Design v0.15.7"},{"type":"p","text":"Original Material del proyecto"},{"type":"h1","text":"1. Document Purpose"},{"type":"p","text":"Define the organizations in Symphony of Justice that possess narrative, political, religious, economic, academic, military, or secret influence, but should not automatically be confused with sovereign nations."},{"type":"p","text":"This document must establish for each organization:"},{"type":"p","text":"what it is;"},{"type":"p","text":"why it exists;"},{"type":"p","text":"who leads it;"},{"type":"p","text":"what authority it possesses;"},{"type":"p","text":"how it recruits members;"},{"type":"p","text":"where it operates;"},{"type":"p","text":"what ideals it defends;"},{"type":"p","text":"what limits it recognizes;"},{"type":"p","text":"how it interacts with governments;"},{"type":"p","text":"which characters are connected to it;"},{"type":"p","text":"what conflicts it enables narratively."},{"type":"p","text":"These organizations allow the world to function both above and below national borders."},{"type":"h1","text":"2. Classification Rule"},{"type":"p","text":"Organizations may be classified under one or more categories."},{"type":"table","table":1},{"type":"h1","text":"3. Overview"},{"type":"table","table":2},{"type":"h1","text":"4. Ministry of Whispers"},{"type":"h2","text":"Identity"},{"type":"h3","text":"Official Name"},{"type":"h1","text":"Ministry of Whispers"},{"type":"h3","text":"Classification"},{"type":"p","text":"Diplomatic, international, legal organization with military capability."},{"type":"h3","text":"Purpose"},{"type":"p","text":"Maintain:"},{"type":"p","text":"peace;"},{"type":"p","text":"diplomacy;"},{"type":"p","text":"communication;"},{"type":"p","text":"cooperation;"},{"type":"p","text":"intervention;"},{"type":"p","text":"among the different nations and organizations."},{"type":"p","text":"Historical materials already defined it as the body responsible for mediating between clans and serving as secondary support when war threatened general stability."},{"type":"h1","text":"Origin"},{"type":"p","text":"The Ministry emerges after generations of conflict among the major nations."},{"type":"p","text":"Its creation is strongly associated with:"},{"type":"h1","text":"Luther"},{"type":"p","text":"and with a group of diplomats from different peoples who considered it essential to create an independent institution capable of preventing new wars."},{"type":"p","text":"Conceptually, it draws inspiration from international bodies dedicated to:"},{"type":"p","text":"diplomacy;"},{"type":"p","text":"rights;"},{"type":"p","text":"peace;"},{"type":"p","text":"international cooperation."},{"type":"p","text":"But within Symphony of Justice, it has its own identity."},{"type":"h1","text":"Cosmological Distinction"},{"type":"p","text":"Unlike many other minor clans whose origins may be connected to:"},{"type":"p","text":"deities;"},{"type":"p","text":"Will;"},{"type":"p","text":"higher entities;"},{"type":"p","text":"the Ministry is essentially a:"},{"type":"h1","text":"creation built by mortals."},{"type":"p","text":"It does not require a founding deity to justify its existence."},{"type":"p","text":"This is important because it demonstrates that mortals can also build institutions capable of rivaling, in influence, organizations born from supernatural forces."},{"type":"p","text":"It will probably need to be located in:"},{"type":"p","text":"independent territory;"},{"type":"p","text":"a neutral zone;"},{"type":"p","text":"an international enclave;"},{"type":"p","text":"but we should not decide that yet."},{"type":"p","text":"Possible Concept Art directions:"},{"type":"p","text":"multiple birds;"},{"type":"p","text":"an incomplete circle;"},{"type":"p","text":"chains joined without forming a prison;"},{"type":"p","text":"a diplomatic balance scale."},{"type":"h1","text":"5. Ministry Structure"},{"type":"h2","text":"Current Leadership"},{"type":"h1","text":"Juro Shinigami Octophus"},{"type":"p","text":"current senior leader of the Ministry."},{"type":"p","text":"Character documentation already presents him specifically as a frontline figure responsible for the Ministry and for maintaining order among the realms."},{"type":"h1","text":"Historical Figure"},{"type":"h1","text":"Luther"},{"type":"p","text":"Founder / central diplomat."},{"type":"p","text":"Although Juro currently leads the organization, Luther retains enormous historical authority."},{"type":"p","text":"He also manages Memento Mori meetings."},{"type":"h1","text":"Known Areas"},{"type":"p","text":"Character materials show that the Ministry has specialists in different fields, including:"},{"type":"h3","text":"Aligura Bluer"},{"type":"p","text":"Research into:"},{"type":"p","text":"clans;"},{"type":"p","text":"history;"},{"type":"p","text":"relationships;"},{"type":"p","text":"cultural characteristics."},{"type":"h3","text":"Hizuka Tamayo"},{"type":"p","text":"Medical lead responsible for:"},{"type":"p","text":"diseases;"},{"type":"p","text":"treatments;"},{"type":"p","text":"biological threats."},{"type":"h3","text":"Serverus Lazoi"},{"type":"p","text":"Responsible for:"},{"type":"p","text":"weaponry;"},{"type":"p","text":"artillery;"},{"type":"p","text":"threat analysis."},{"type":"p","text":"These historical functions suggest that the Ministry is not simply a diplomatic office, but a multidisciplinary organization."},{"type":"h1","text":"Recruitment"},{"type":"p","text":"The Ministry accepts individuals from different:"},{"type":"p","text":"nations;"},{"type":"p","text":"clans;"},{"type":"p","text":"professions;"},{"type":"p","text":"backgrounds."},{"type":"h3","text":"Possible Criteria"},{"type":"p","text":"competence;"},{"type":"p","text":"neutrality;"},{"type":"p","text":"reputation;"},{"type":"p","text":"experience;"},{"type":"p","text":"cultural knowledge."},{"type":"h1","text":"Ideology"},{"type":"p","text":"Core principle: differences between nations should not turn every disagreement into a war."},{"type":"p","text":"They do not seek to eliminate cultures or philosophies."},{"type":"p","text":"They seek to create mechanisms that allow them to coexist."},{"type":"h1","text":"Limits"},{"type":"p","text":"Ideally, the Ministry:"},{"type":"p","text":"does not govern nations;"},{"type":"p","text":"does not replace governments;"},{"type":"p","text":"cannot arbitrarily impose a philosophy;"},{"type":"p","text":"must justify its interventions."},{"type":"p","text":"However, it may intervene when a conflict threatens stability across multiple nations."},{"type":"h1","text":"Relationships"},{"type":"h3","text":"Major Nations"},{"type":"p","text":"Formal cooperation, accompanied by occasional suspicion."},{"type":"h3","text":"Purgatory"},{"type":"p","text":"Very close relationship."},{"type":"h3","text":"Shinigami"},{"type":"p","text":"Frequent cooperation."},{"type":"h3","text":"Memento Mori"},{"type":"p","text":"Historical and institutional relationship."},{"type":"h3","text":"Bird Executioners"},{"type":"p","text":"Related origins, but a different current ideology."},{"type":"h1","text":"Narrative"},{"type":"p","text":"Enables stories about:"},{"type":"p","text":"diplomacy;"},{"type":"p","text":"espionage;"},{"type":"p","text":"treaties;"},{"type":"p","text":"international conflicts;"},{"type":"p","text":"jurisdiction;"},{"type":"p","text":"corruption;"},{"type":"p","text":"limits of intervention;"},{"type":"p","text":"peace versus sovereignty."},{"type":"h1","text":"6. Purgatory"},{"type":"h2","text":"Identity"},{"type":"h1","text":"Purgatory"},{"type":"h3","text":"Classification"},{"type":"p","text":"Metaphysical plane + independent spiritual institution."},{"type":"p","text":"This distinction is fundamental."},{"type":"p","text":"Purgatory is simultaneously:"},{"type":"p","text":"a place / plane;"},{"type":"p","text":"an institution that emerged around its custody."},{"type":"h1","text":"Institutional Purpose"},{"type":"p","text":"Manage:"},{"type":"p","text":"souls;"},{"type":"p","text":"dangerous entities;"},{"type":"p","text":"the condemned;"},{"type":"p","text":"undead;"},{"type":"p","text":"spiritual threats;"},{"type":"p","text":"beings that cannot safely remain free in other planes."},{"type":"p","text":"Historical documents already described sinful souls, debtors, corrupted beings, Deadly Sins, and other imprisoned entities there."},{"type":"h1","text":"Origin"},{"type":"p","text":"The plane has existed since extremely ancient times. The institution appears later, after mortals develop greater knowledge of and contact with it. The two should not be confused."},{"type":"h1","text":"Historical Affiliation"},{"type":"p","text":"At different times it has been connected to:"},{"type":"p","text":"Shinigami;"},{"type":"p","text":"Thanatos;"},{"type":"p","text":"Archangels."},{"type":"p","text":"After the Greed Crisis, it consolidates as an independent institution."},{"type":"h1","text":"Headquarters"},{"type":"p","text":"Purgatory itself."},{"type":"p","text":"although there are probably also:"},{"type":"p","text":"access points;"},{"type":"p","text":"outposts;"},{"type":"p","text":"embassies;"},{"type":"p","text":"facilities;"},{"type":"p","text":"on the Material Plane."},{"type":"h1","text":"Important Historical Guardian"},{"type":"h1","text":"Isabell"},{"type":"p","text":"connected to the custody of Purgatory during the Boarding School generation."},{"type":"h1","text":"Recruitment"},{"type":"p","text":"Probably extremely controlled."},{"type":"p","text":"Possible members:"},{"type":"p","text":"guardians;"},{"type":"p","text":"spiritual specialists;"},{"type":"p","text":"researchers;"},{"type":"p","text":"combatants;"},{"type":"p","text":"custodians."},{"type":"h1","text":"Ideology"},{"type":"p","text":"Some existences cannot remain free without endangering others."},{"type":"p","text":"But this creates an enormous question: who decides which soul deserves to remain imprisoned?"},{"type":"p","text":"That should be one of its main narrative dilemmas."},{"type":"h1","text":"Relationships"},{"type":"h3","text":"Archangels"},{"type":"p","text":"Historically extremely close."},{"type":"h3","text":"Shinigami"},{"type":"p","text":"Natural cooperation."},{"type":"h3","text":"Ministry"},{"type":"p","text":"Institutional cooperation."},{"type":"h3","text":"Arcane / Thanatos"},{"type":"p","text":"Historical and technical connection."},{"type":"h1","text":"Narrative"},{"type":"p","text":"Enables:"},{"type":"p","text":"supernatural imprisonment;"},{"type":"p","text":"dilemmas about condemnation;"},{"type":"p","text":"souls;"},{"type":"p","text":"resurrection;"},{"type":"p","text":"corruption;"},{"type":"p","text":"escapes;"},{"type":"p","text":"Sins;"},{"type":"p","text":"secrets of the Deities."},{"type":"h1","text":"7. Shinigami"},{"type":"h2","text":"Identity"},{"type":"h1","text":"Shinigami"},{"type":"h3","text":"Classification"},{"type":"p","text":"Transnational spiritual order."},{"type":"h3","text":"Historical Founder"},{"type":"p","text":"Later materials mention:"},{"type":"h1","text":"The Black Lotus"},{"type":"p","text":"as the founder."},{"type":"p","text":"However, this information has not yet been directly confirmed within our contemporary canon."},{"type":"h1","text":"Purpose"},{"type":"p","text":"Maintain balance between:"},{"type":"p","text":"life;"},{"type":"p","text":"death;"},{"type":"p","text":"souls;"},{"type":"p","text":"undead."},{"type":"p","text":"Historical documents describe their function precisely as monitoring deaths and preventing major disruptions to the order between the living and the dead."},{"type":"h1","text":"Temporal Origin"},{"type":"p","text":"They emerge approximately during the conflicts of the Deities of Judgment."},{"type":"p","text":"They do not originate when mortals discover Purgatory."},{"type":"p","text":"Their structure could be:"},{"type":"p","text":"decentralized;"},{"type":"p","text":"interplanar;"},{"type":"p","text":"organized by regions."},{"type":"h1","text":"Ideology"},{"type":"p","text":"Death is not necessarily understood as punishment."},{"type":"p","text":"It is part of a natural and spiritual order."},{"type":"p","text":"Therefore, they must intervene when someone:"},{"type":"p","text":"artificially disrupts that passage;"},{"type":"p","text":"creates anomalies;"},{"type":"p","text":"retains souls;"},{"type":"p","text":"creates undead outside the expected order."},{"type":"h1","text":"Limits"},{"type":"p","text":"They should not arbitrarily decide who deserves to die."},{"type":"p","text":"Their function is primarily to protect the flow between life and death."},{"type":"p","text":"This should be revisited once we develop the exact rules of death."},{"type":"h1","text":"Relationships"},{"type":"h3","text":"Purgatory"},{"type":"p","text":"Very close."},{"type":"h3","text":"Thanatos"},{"type":"p","text":"Parallel, but not identical."},{"type":"h3","text":"Ministry"},{"type":"p","text":"Cooperative."},{"type":"h3","text":"Nations"},{"type":"p","text":"Generally transnational."},{"type":"h1","text":"Primary Related Character"},{"type":"h1","text":"Juro"},{"type":"p","text":"has Shinigami heritage."},{"type":"h1","text":"Narrative"},{"type":"p","text":"artificial life;"},{"type":"p","text":"immortality;"},{"type":"p","text":"stolen souls;"},{"type":"p","text":"resurrection;"},{"type":"p","text":"PLO;"},{"type":"p","text":"undead;"},{"type":"p","text":"spiritual anomalies."},{"type":"h1","text":"8. Writers"},{"type":"h2","text":"Identity"},{"type":"h1","text":"The Writers"},{"type":"h3","text":"Classification"},{"type":"p","text":"Academic, metaphysical, and interplanar order."},{"type":"h1","text":"Founder"},{"type":"p","text":"An entity later elevated to:"},{"type":"h1","text":"Major God"},{"type":"p","text":"whose absolute Will was to record history without censorship or bias."},{"type":"p","text":"Original documents already establish that the Writers preserved true history and that their records could involve past, present, and future."},{"type":"h1","text":"Purpose"},{"type":"p","text":"Preserve:"},{"type":"p","text":"events;"},{"type":"p","text":"testimonies;"},{"type":"p","text":"versions;"},{"type":"p","text":"historical lines;"},{"type":"p","text":"facts erased by governments."},{"type":"p","text":"They do not necessarily judge what they write."},{"type":"p","text":"Their ideal function is to record it."},{"type":"h1","text":"Headquarters"},{"type":"h1","text":"Plane of the Writers"},{"type":"p","text":"a space separate from the material world."},{"type":"h1","text":"Symbol"},{"type":"p","text":"Potential concepts:"},{"type":"p","text":"open book;"},{"type":"p","text":"quill;"},{"type":"p","text":"eye;"},{"type":"p","text":"three timelines;"},{"type":"p","text":"infinite pages."},{"type":"h1","text":"Structure"},{"type":"p","text":"Still unknown."},{"type":"p","text":"Possible roles:"},{"type":"p","text":"chroniclers;"},{"type":"p","text":"archivists;"},{"type":"p","text":"custodians;"},{"type":"p","text":"observers;"},{"type":"p","text":"researchers."},{"type":"h1","text":"Recruitment"},{"type":"p","text":"We do not yet know whether:"},{"type":"p","text":"they are born as Writers;"},{"type":"p","text":"they are chosen;"},{"type":"p","text":"they can become Writers;"},{"type":"p","text":"they are created by their founder."},{"type":"h1","text":"Ideology"},{"type":"p","text":"Truth must survive even when no one wants to hear it."},{"type":"p","text":"This does not necessarily mean that truth must be published immediately."},{"type":"p","text":"There is a crucial distinction here."},{"type":"p","text":"The Writers may preserve information they consider too dangerous to reveal."},{"type":"h1","text":"Limits"},{"type":"p","text":"Ideally, they should not:"},{"type":"p","text":"alter events;"},{"type":"p","text":"manipulate records;"},{"type":"p","text":"act politically."},{"type":"p","text":"But there could be Writers who break those rules."},{"type":"p","text":"An excellent source of narrative conflict."},{"type":"h1","text":"Relationships"},{"type":"p","text":"They remain independent from:"},{"type":"p","text":"governments;"},{"type":"p","text":"religions;"},{"type":"p","text":"nations."},{"type":"p","text":"It is likely that every major power would want access to their archives."},{"type":"h1","text":"Narrative"},{"type":"p","text":"censored history;"},{"type":"p","text":"lost documents;"},{"type":"p","text":"memories;"},{"type":"p","text":"War of the Deities;"},{"type":"p","text":"the truth about Iluminate;"},{"type":"p","text":"timelines;"},{"type":"p","text":"archive theft."},{"type":"h1","text":"9. Project Limbo of Osiris"},{"type":"h2","text":"Identity"},{"type":"h1","text":"Project Limbo of Osiris"},{"type":"h3","text":"PLO"},{"type":"h3","text":"Classification"},{"type":"p","text":"Secret scientific-metaphysical organization / project."},{"type":"h1","text":"Purpose"},{"type":"p","text":"Voluntarily preserve major figures capable of defending the world during future catastrophes."},{"type":"p","text":"Current material confirms that characters such as Zileus and Isabell have been preserved, and that the organization cannot force anyone to enter the process."},{"type":"h1","text":"Founder"},{"type":"p","text":"We know that:"},{"type":"p","text":"they belong to an extremely ancient era;"},{"type":"p","text":"they are of an age comparable to Zileus;"},{"type":"p","text":"they possess enormous power."},{"type":"h1","text":"Zileus"},{"type":"p","text":"He is not necessarily the founder."},{"type":"p","text":"He participated as:"},{"type":"p","text":"a researcher;"},{"type":"p","text":"a collaborator;"},{"type":"p","text":"and later as a voluntary subject."},{"type":"h1","text":"Technology / Magic"},{"type":"p","text":"It functions through:"},{"type":"h1","text":"temporal suspension"},{"type":"p","text":"The body:"},{"type":"p","text":"does not age;"},{"type":"p","text":"does not heal;"},{"type":"p","text":"does not worsen;"},{"type":"p","text":"does not die."},{"type":"p","text":"The soul and Will remain within it."},{"type":"p","text":"The subject is suspended in time"},{"type":"p","text":"rather than merely frozen in matter."},{"type":"p","text":"Historical materials already associated PLO with temporal fragmentation and the preservation of life."},{"type":"h1","text":"Ideology"},{"type":"p","text":"One generation can preserve what the next may need in order to survive."},{"type":"p","text":"But there is also an underlying obsession:"},{"type":"p","text":"death can be delayed."},{"type":"h1","text":"Fundamental Ethical Line"},{"type":"h1","text":"CONSENT"},{"type":"p","text":"No one can be preserved against their will."},{"type":"h1","text":"Headquarters"},{"type":"p","text":"Possibly multiple facilities."},{"type":"h1","text":"Relationships"},{"type":"h3","text":"Memento Mori"},{"type":"p","text":"Possible cooperation."},{"type":"h3","text":"Ministry"},{"type":"p","text":"May partially know of its existence."},{"type":"h3","text":"Writers"},{"type":"p","text":"Possible historical exchange."},{"type":"h1","text":"Narrative"},{"type":"p","text":"PLO enables:"},{"type":"p","text":"the return of historical characters;"},{"type":"p","text":"heroes from different eras;"},{"type":"p","text":"people waking in a different world;"},{"type":"p","text":"conflicts about immortality;"},{"type":"p","text":"living historical memory;"},{"type":"p","text":"threats accidentally preserved."},{"type":"h1","text":"10. Memento Mori"},{"type":"h2","text":"Identity"},{"type":"h1","text":"Memento Mori"},{"type":"h3","text":"Conceptual Meaning"},{"type":"p","text":"Remember that you will die."},{"type":"h3","text":"Classification"},{"type":"p","text":"Secret international diplomatic organization."},{"type":"h1","text":"Origin"},{"type":"p","text":"It emerges after the war against the Sin of Greed."},{"type":"p","text":"Its members came close enough to death to recognize that:"},{"type":"p","text":"no title;"},{"type":"p","text":"nation;"},{"type":"p","text":"power;"},{"type":"p","text":"legacy;"},{"type":"p","text":"makes them invulnerable."},{"type":"h1","text":"Purpose"},{"type":"p","text":"Maintain communication among figures capable of:"},{"type":"p","text":"preventing wars;"},{"type":"p","text":"containing crises;"},{"type":"p","text":"coordinating responses;"},{"type":"p","text":"preventing smaller conflicts from escalating."},{"type":"h1","text":"Distinctive Feature"},{"type":"p","text":"Memento Mori does not necessarily use each nation's current public leader."},{"type":"p","text":"Its authority comes from:"},{"type":"p","text":"historical experience;"},{"type":"p","text":"trust;"},{"type":"p","text":"personal legitimacy;"},{"type":"p","text":"participation in the original pact."},{"type":"h1","text":"Known Representatives"},{"type":"h2","text":"Arcane"},{"type":"h3","text":"Draken"},{"type":"p","text":"Although current public leadership belongs to Raiko,"},{"type":"p","text":"Draken retains representation within Memento Mori."},{"type":"h2","text":"Ministry"},{"type":"h3","text":"Luther"},{"type":"p","text":"Although Juro"},{"type":"p","text":"is the current leader of the Ministry."},{"type":"p","text":"Luther organizes or conducts the meetings."},{"type":"h1","text":"Symbol"},{"type":"p","text":"Conceptually, it should relate to:"},{"type":"p","text":"mortality;"},{"type":"p","text":"memory;"},{"type":"p","text":"cooperation;"},{"type":"p","text":"scars of war;"},{"type":"p","text":"without necessarily falling into generic skull iconography."},{"type":"h1","text":"Ideology"},{"type":"p","text":"No one possesses so much power that they cease to need others."},{"type":"h1","text":"Relationships"},{"type":"h3","text":"Ministry"},{"type":"p","text":"Very close."},{"type":"h3","text":"Governments"},{"type":"p","text":"Complicated."},{"type":"p","text":"A government might not know everything its historical representative negotiates within Memento Mori."},{"type":"p","text":"This opens a fascinating tension between:"},{"type":"h1","text":"legal authority vs. historical authority."},{"type":"h1","text":"Narrative"},{"type":"p","text":"secret meetings;"},{"type":"p","text":"impossible decisions;"},{"type":"p","text":"operations outside public knowledge;"},{"type":"p","text":"old heroes;"},{"type":"p","text":"generational disagreement;"},{"type":"p","text":"state secrets;"},{"type":"p","text":"clandestine diplomacy."},{"type":"h1","text":"11. Fifth Clan"},{"type":"h2","text":"Identity"},{"type":"h1","text":"Fifth Clan"},{"type":"h3","text":"Classification"},{"type":"p","text":"Philosophical, spiritual, and possibly transnational organization."},{"type":"h1","text":"Origin"},{"type":"p","text":"It emerges primarily around:"},{"type":"p","text":"Kingless Island;"},{"type":"p","text":"ancient texts;"},{"type":"p","text":"knowledge about the Master of Birds;"},{"type":"p","text":"concern over the behavior of the Deities of Judgment."},{"type":"p","text":"Current material establishes this connection with Kingless Island and with texts describing an entity above the four Deities."},{"type":"h1","text":"Purpose"},{"type":"p","text":"Create or preserve a force capable of preventing a new conflict among the Deities from destroying the world."},{"type":"h1","text":"Ideology"},{"type":"p","text":"Its philosophy is closer to:"},{"type":"p","text":"balance;"},{"type":"p","text":"peace;"},{"type":"p","text":"longevity;"},{"type":"p","text":"observation;"},{"type":"p","text":"historical responsibility."},{"type":"h1","text":"Relationship with Time"},{"type":"p","text":"There is a frequent association with:"},{"type":"p","text":"long-lived beings;"},{"type":"p","text":"time;"},{"type":"p","text":"accumulated knowledge."},{"type":"p","text":"The logic is that those who have lived long enough can recognize cycles that younger societies repeat."},{"type":"h1","text":"Deity"},{"type":"p","text":"The Fifth Clan has a deity of its own."},{"type":"p","text":"But it is not correct to automatically state that this deity is the Master of Birds."},{"type":"h1","text":"Headquarters"},{"type":"p","text":"Probably connected to Kingless Island."},{"type":"h1","text":"Recruitment"},{"type":"p","text":"Possible emphasis on:"},{"type":"p","text":"longevity;"},{"type":"p","text":"knowledge;"},{"type":"p","text":"experience;"},{"type":"p","text":"temporal affinity."},{"type":"h1","text":"Narrative"},{"type":"p","text":"secrets of the Deities;"},{"type":"p","text":"time;"},{"type":"p","text":"ancient generations;"},{"type":"p","text":"Master of Birds;"},{"type":"p","text":"Kingless Island;"},{"type":"p","text":"balance among powers."},{"type":"h1","text":"12. Bird Executioners"},{"type":"h2","text":"Identity"},{"type":"h1","text":"Bird Executioners"},{"type":"h3","text":"Classification"},{"type":"p","text":"Irregular military / ideological organization."},{"type":"h1","text":"Important"},{"type":"h1","text":"They are NOT the Fifth Clan."},{"type":"p","text":"The two organizations may share references connected to:"},{"type":"p","text":"birds;"},{"type":"p","text":"ancient deities;"},{"type":"p","text":"conflicts;"},{"type":"p","text":"but their philosophies are different."},{"type":"h1","text":"Historical Origin"},{"type":"p","text":"A later version described them as a hybrid division formed around the Ministry and Purgatory, responsible for punishing those who violated ancient agreements."},{"type":"p","text":"Another historical version presented them directly as followers of a fifth deity who sought to dominate the realms."},{"type":"p","text":"Both formulations have been partially replaced."},{"type":"h1","text":"Current Canon"},{"type":"p","text":"The Bird Executioners find their reason for existing in conflict."},{"type":"p","text":"As long as there is:"},{"type":"p","text":"hatred;"},{"type":"p","text":"war;"},{"type":"p","text":"chaos;"},{"type":"p","text":"their organization can remain fulfilled."},{"type":"p","text":"They do not necessarily seek to conquer the entire world."},{"type":"p","text":"Their relationship with conflict is more complex."},{"type":"h1","text":"Philosophy"},{"type":"p","text":"A completely peaceful world would remove their reason for being."},{"type":"p","text":"That may lead them to:"},{"type":"p","text":"prolong conflicts;"},{"type":"p","text":"intervene selectively;"},{"type":"p","text":"punish;"},{"type":"p","text":"create conditions in which violence continues to exist."},{"type":"h1","text":"Relationship with the Fifth Clan"},{"type":"h3","text":"Related"},{"type":"p","text":"Yes."},{"type":"h3","text":"Same organization"},{"type":"p","text":"No."},{"type":"h1","text":"13. Elemental Edge Entities"},{"type":"h2","text":"Current Name"},{"type":"h1","text":"Elemental Edge Entities"},{"type":"h3","text":"Former Name"},{"type":"p","text":"Entities of the Edge of the Winds"},{"type":"h3","text":"Status of Former Name"},{"type":"h1","text":"Classification"},{"type":"p","text":"Martial and spiritual order."},{"type":"h1","text":"Origin"},{"type":"p","text":"They emerge within the cultural sphere of the Beasts."},{"type":"p","text":"Their goal was to learn to channel elemental Will through weapons."},{"type":"p","text":"They later leave that environment because of:"},{"type":"p","text":"philosophical differences;"},{"type":"p","text":"technical divergences."},{"type":"h1","text":"Major Rupture"},{"type":"p","text":"A massacre destroys a significant portion of their masters."},{"type":"p","text":"However:"},{"type":"p","text":"writings;"},{"type":"p","text":"techniques;"},{"type":"p","text":"weapons;"},{"type":"p","text":"souls of masters;"},{"type":"p","text":"allow their knowledge to survive."},{"type":"p","text":"Historical documents already preserved precisely this idea of murdered masters whose spirits remained to transmit the techniques."},{"type":"h1","text":"Purpose"},{"type":"p","text":"Preserve and perfect elemental martial arts through weapons."},{"type":"h1","text":"Headquarters"},{"type":"p","text":"Could include:"},{"type":"p","text":"an ancient temple;"},{"type":"p","text":"scattered schools;"},{"type":"p","text":"ruins."},{"type":"h1","text":"Structure"},{"type":"p","text":"Possible ranks:"},{"type":"p","text":"disciples;"},{"type":"p","text":"masters;"},{"type":"p","text":"guardians;"},{"type":"p","text":"style bearers."},{"type":"h1","text":"Recruitment"},{"type":"p","text":"Probably through:"},{"type":"p","text":"training;"},{"type":"p","text":"affinity;"},{"type":"p","text":"discipline."},{"type":"p","text":"Not necessarily by birth."},{"type":"h1","text":"Relationships"},{"type":"h3","text":"Beasts"},{"type":"p","text":"Shared origin, complex cultural relationship."},{"type":"h3","text":"Writers"},{"type":"p","text":"May have contributed to preserving techniques."},{"type":"h1","text":"Narrative"},{"type":"p","text":"lost techniques;"},{"type":"p","text":"spectral masters;"},{"type":"p","text":"weapons;"},{"type":"p","text":"tradition;"},{"type":"p","text":"cultural reconstruction;"},{"type":"p","text":"conflict between technique and modernity."},{"type":"h1","text":"14. Crescent Moon Circus"},{"type":"h2","text":"Identity"},{"type":"h1","text":"Crescent Moon Circus"},{"type":"h3","text":"Classification"},{"type":"p","text":"Nomadic, criminal, and clandestine-services organization."},{"type":"h1","text":"Origin"},{"type":"p","text":"Historically derived from:"},{"type":"p","text":"the Mafia."},{"type":"p","text":"It manages to leave the underground territory and free itself from both:"},{"type":"p","text":"physical confinement;"},{"type":"p","text":"political obligations;"},{"type":"p","text":"the codes of the major Mafias."},{"type":"h1","text":"Current Purpose"},{"type":"p","text":"Travel."},{"type":"p","text":"Discover."},{"type":"p","text":"Work."},{"type":"p","text":"Survive."},{"type":"p","text":"Without becoming the property of any nation."},{"type":"h1","text":"Front"},{"type":"p","text":"To the general population, they function as a traveling circus."},{"type":"p","text":"But they also include:"},{"type":"p","text":"assassins;"},{"type":"p","text":"explorers;"},{"type":"p","text":"researchers;"},{"type":"p","text":"mercenaries;"},{"type":"p","text":"specialists."},{"type":"p","text":"Historical materials already present them as nomads who appear only after long intervals between visits and who even accept contracts from clan leaders."},{"type":"h1","text":"Headquarters"},{"type":"h1","text":"The Circus itself."},{"type":"p","text":"They do not need fixed national territory."},{"type":"h1","text":"Movement"},{"type":"p","text":"They never remain in the same location for too long."},{"type":"p","text":"The historical version suggested intervals of even 1-2 years"},{"type":"p","text":"before they are seen again in a region."},{"type":"h1","text":"Ideology"},{"type":"h1","text":"INDEPENDENCE"},{"type":"p","text":"They do not want to:"},{"type":"p","text":"be governed;"},{"type":"p","text":"be chained to a nation;"},{"type":"p","text":"repeat the Mafia's fate."},{"type":"h1","text":"Moral Limits"},{"type":"p","text":"Variable."},{"type":"p","text":"They may accept:"},{"type":"p","text":"espionage;"},{"type":"p","text":"assassination;"},{"type":"p","text":"investigation;"},{"type":"p","text":"protection."},{"type":"h1","text":"Related Characters"},{"type":"p","text":"Historical materials include:"},{"type":"p","text":"Niels;"},{"type":"p","text":"Haruko;"},{"type":"p","text":"Naoto;"},{"type":"p","text":"others."},{"type":"h1","text":"Relationships"},{"type":"h3","text":"Mafia"},{"type":"p","text":"Common origin, potentially tense relationship."},{"type":"h3","text":"Ministry"},{"type":"p","text":"Variable professional relationship."},{"type":"h3","text":"Nations"},{"type":"p","text":"They may offer services."},{"type":"h1","text":"Narrative"},{"type":"p","text":"The Circus works extremely well as:"},{"type":"p","text":"the protagonist's gateway into the world;"},{"type":"p","text":"a source of rumors;"},{"type":"p","text":"an information network;"},{"type":"p","text":"a narrative vehicle;"},{"type":"p","text":"a neutral contact."},{"type":"h1","text":"15. Snow Messenger Foxes"},{"type":"h2","text":"Identity"},{"type":"h1","text":"Snow Messenger Foxes"},{"type":"h3","text":"Classification"},{"type":"p","text":"International communication and courier service."},{"type":"h1","text":"Origin"},{"type":"p","text":"They originate within the Beast Nation"},{"type":"p","text":"as a secure system for transporting information."},{"type":"p","text":"Their effectiveness eventually allowed the service to expand to all major nations."},{"type":"p","text":"Current material confirms this Beast origin and its later expansion into other territories."},{"type":"h1","text":"Members"},{"type":"p","text":"Frequently:"},{"type":"p","text":"foxes;"},{"type":"p","text":"Kitsunes;"},{"type":"p","text":"agile Beasts."},{"type":"p","text":"But:"},{"type":"p","text":"not exclusively foxes."},{"type":"p","text":"Other fast types of Beasts may also belong."},{"type":"h1","text":"Purpose"},{"type":"p","text":"Deliver:"},{"type":"p","text":"letters;"},{"type":"p","text":"documents;"},{"type":"p","text":"messages;"},{"type":"p","text":"sensitive packages;"},{"type":"p","text":"securely."},{"type":"h1","text":"Reputation"},{"type":"p","text":"They are considered one of the safest courier systems in the world."},{"type":"p","text":"Older sources even claimed that clans were unable to intercept what they carried."},{"type":"h1","text":"Headquarters"},{"type":"p","text":"Probably the Beast Nation."},{"type":"h1","text":"Structure"},{"type":"p","text":"Could include:"},{"type":"p","text":"couriers;"},{"type":"p","text":"coordinators;"},{"type":"p","text":"custodians;"},{"type":"p","text":"cryptographers."},{"type":"h1","text":"Neutrality"},{"type":"p","text":"To operate internationally, they must protect confidentiality."},{"type":"p","text":"If they began handing information to any one nation, they would immediately lose their value."},{"type":"h1","text":"Lines They Should Not Cross"},{"type":"p","text":"open correspondence;"},{"type":"p","text":"sell information;"},{"type":"p","text":"alter messages;"},{"type":"p","text":"collaborate with state espionage."},{"type":"h1","text":"Narrative"},{"type":"p","text":"They can enable:"},{"type":"p","text":"lost messages;"},{"type":"p","text":"seemingly impossible interception;"},{"type":"p","text":"secret information;"},{"type":"p","text":"pursuits;"},{"type":"p","text":"witnesses;"},{"type":"p","text":"clandestine routes."},{"type":"h1","text":"16. The Boarding School"},{"type":"p","text":"Although it no longer operates in the same way, it should appear because it was a:"},{"type":"h1","text":"historical diplomatic and educational institution."},{"type":"h1","text":"Purpose"},{"type":"p","text":"Bring together the heirs of the major powers"},{"type":"p","text":"in an attempt to ensure that a future generation grew up:"},{"type":"p","text":"knowing one another;"},{"type":"p","text":"collaborating;"},{"type":"p","text":"understanding other nations."},{"type":"p","text":"Historical materials describe the Boarding School precisely as a project intended to form a generation capable of maintaining peace."},{"type":"h1","text":"Known Historical Members"},{"type":"p","text":"Draken;"},{"type":"p","text":"Shereth;"},{"type":"p","text":"Isabell;"},{"type":"p","text":"Juro;"},{"type":"p","text":"Mafia heir;"},{"type":"p","text":"Tadashi;"},{"type":"p","text":"Toshinori;"},{"type":"p","text":"Blacked;"},{"type":"p","text":"others."},{"type":"h1","text":"Destruction"},{"type":"p","text":"Its failure is connected to King Shadow / Greed and the control of Draken."},{"type":"p","text":"The other powers initially interpreted the situation as Arcane betrayal."},{"type":"h1","text":"Current Status"},{"type":"h1","text":"INACTIVE / RUINS / HISTORICAL LEGACY"},{"type":"h1","text":"Importance"},{"type":"p","text":"The Boarding School creates a network of personal relationships that later explains:"},{"type":"p","text":"Memento Mori;"},{"type":"p","text":"diplomacy;"},{"type":"p","text":"romances;"},{"type":"p","text":"enmities;"},{"type":"p","text":"alliances."},{"type":"h1","text":"17. Beasts of the Apocalypse"},{"type":"p","text":"This organization requires special care."},{"type":"p","text":"Older materials describe the Beasts of the Apocalypse as four extremely high-ranking figures associated with Mafia organizations."},{"type":"h1","text":"Provisional Classification"},{"type":"p","text":"Special military force of the Mafia."},{"type":"h1","text":"Historical Purpose"},{"type":"p","text":"Protection and high-level combat."},{"type":"h1","text":"Relationship"},{"type":"p","text":"It appears to be connected to different major Mafias."},{"type":"h1","text":"Current Status"},{"type":"p","text":"I do not consider the material we currently have sufficient to declare:"},{"type":"p","text":"structure;"},{"type":"p","text":"members;"},{"type":"p","text":"leadership;"},{"type":"p","text":"exact number;"},{"type":"p","text":"contemporary function."},{"type":"p","text":"We should return to it when we develop the Mafia in greater depth."},{"type":"h1","text":"18. Mafia Subfactions"},{"type":"p","text":"The five major Mafias should also be considered organizations within the Mafia Nation."},{"type":"p","text":"Their full national profiles do not need to be repeated here, but they should be registered:"},{"type":"table","table":3},{"type":"p","text":"The original documents already established clear differences among these five Mafia blocs and their internal rules. Full profiles should later appear under: Nations & Territories → Mafia → Internal Factions"}],"tables":[[["Status","DRAFT","Version","0.15.7"],["Owner","J. Crow","Last updated","29/08/2026"]],[["Category","Definition"],["Diplomatic","Mediates between nations or institutions."],["Legal","Officially recognized by governments."],["Military","Possesses organized combat capability."],["Religious / Spiritual","Works with souls, beliefs, or metaphysical entities."],["Academic","Preserves, researches, or produces knowledge."],["Criminal","Operates outside or against recognized legal systems."],["Economic","Controls services, trade, or resources."],["Secret","Its existence or operations are not public knowledge."],["Transnational","Operates across multiple nations."],["Historical","No longer operates normally, but still affects the present."]],[["Organization","Primary Type","Scope","Public Existence"],["Ministry of Whispers","Diplomatic / Military","International","Public"],["Purgatory","Spiritual / Institutional","International / Interplanar","Partially public"],["Shinigami","Spiritual","International","Known"],["Writers","Academic / Metaphysical","International / Interplanar","Partially known"],["Project Limbo of Osiris","Research / Secret","International","Secret"],["Memento Mori","Diplomatic / Secret","International","Secret"],["Fifth Clan","Philosophical / Spiritual","TBD","Highly restricted"],["Bird Executioners","Military / Ideological","International","Partial / unknown"],["Elemental Edge Entities","Martial / Spiritual","International","Fragmentarily known"],["Crescent Moon Circus","Nomadic / Criminal / Services","International","Public under cover"],["Snow Messenger Foxes","Communication / Economic","International","Public"],["Boarding School","Educational / Diplomatic","International","Historical"],["Beasts of the Apocalypse","Mafia military","Mafia","Partially known"]],[["Organization","Summarized Philosophy"],["Hat Mafia","The greater objective may justify brutal means"],["Pale Moon Mafia","Return what you received in kind"],["Crimson Eyes Mafia","Absolute protection under a strict code"],["Counts Mafia","Power, influence, and internal judgment"],["Low Streets Mafia","No one will save you; fight for what you want"]]]}