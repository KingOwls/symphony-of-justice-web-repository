{"id":"slice-00-vertical-slice-index","group":"slice","groupLabel":"Vertical Slice","number":"00","title":"Vertical Slice Index","summary":"Central index for the playable proof of concept and its production documentation.","sourceFile":"Vertical Slice/00 - Vertical Slice Index.docx","meta":{"folder":"Vertical Slice","status":"Meaning","version":"0.15.7","last_updated":"2026-08-16"},"headings":[{"level":1,"text":"1. Purpose"},{"level":1,"text":"2. Vertical Slice Goal"},{"level":1,"text":"3. Vertical Slice Principles"},{"level":2,"text":"3.1 Small world, complete experience"},{"level":2,"text":"3.2 Quality over quantity"},{"level":2,"text":"3.3 Representative, not exhaustive"},{"level":2,"text":"3.4 No fake systems"},{"level":1,"text":"4. Target Experience"},{"level":3,"text":"Initial platform"},{"level":1,"text":"PC"},{"level":3,"text":"Engine"},{"level":1,"text":"Unreal Engine 5"},{"level":3,"text":"Experience type"},{"level":1,"text":"Single-player Action RPG Vertical Slice"},{"level":3,"text":"Initial target duration"},{"level":1,"text":"5. Core Experience Statement"},{"level":1,"text":"6. Core Demonstration Loop"},{"level":1,"text":"7. Document Map"},{"level":1,"text":"8. Status Definitions"},{"level":1,"text":"9. Scope Layers"},{"level":2,"text":"MUST"},{"level":2,"text":"SHOULD"},{"level":2,"text":"COULD"},{"level":2,"text":"OUT"},{"level":1,"text":"10. Current High-Level Scope"},{"level":2,"text":"MUST"},{"level":2,"text":"SHOULD"},{"level":2,"text":"COULD"},{"level":2,"text":"OUT"},{"level":1,"text":"11. Playable Character Target"},{"level":3,"text":"Roster objective"},{"level":1,"text":"12. Combat Model"},{"level":3,"text":"Expected components"},{"level":1,"text":"13. Character Swapping"},{"level":3,"text":"Status"},{"level":1,"text":"14. Elemental Scope"},{"level":3,"text":"Recommended Vertical Slice"},{"level":3,"text":"Status"},{"level":1,"text":"15. Enemy Scope"},{"level":3,"text":"Initial target"},{"level":1,"text":"16. Boss Candidate"},{"level":2,"text":"Zalenquea Guardian"},{"level":3,"text":"Historical status"},{"level":3,"text":"Vertical Slice status"},{"level":3,"text":"Purpose"},{"level":3,"text":"Current concept"},{"level":3,"text":"Important"},{"level":1,"text":"17. Environment Scope"},{"level":3,"text":"Initial target"},{"level":1,"text":"18. Environmental Progression"},{"level":3,"text":"Zone 1"},{"level":3,"text":"Zone 2"},{"level":3,"text":"Zone 3"},{"level":3,"text":"Zone 4"},{"level":3,"text":"Zone 5"},{"level":1,"text":"19. Vertical Slice Location"},{"level":3,"text":"Currently:"},{"level":1,"text":"20. Narrative Scope"},{"level":3,"text":"Recommended structure"},{"level":2,"text":"Beginning"},{"level":2,"text":"Discovery"},{"level":2,"text":"Development"},{"level":2,"text":"Preparation"},{"level":2,"text":"Boss"},{"level":2,"text":"Closing"},{"level":1,"text":"21. Narrative Rule"},{"level":1,"text":"22. Progression Scope"},{"level":3,"text":"May include"},{"level":3,"text":"Does not need"},{"level":3,"text":"Status"},{"level":1,"text":"23. Gacha in Vertical Slice"},{"level":3,"text":"Option"},{"level":3,"text":"Priority"},{"level":1,"text":"24. UI Requirements Overview"},{"level":3,"text":"SHOULD"},{"level":1,"text":"25. Art Requirements Overview"},{"level":3,"text":"Stages"},{"level":2,"text":"Blockout"},{"level":2,"text":"Greybox"},{"level":2,"text":"Art Pass"},{"level":2,"text":"Lighting Pass"},{"level":2,"text":"Polish"},{"level":1,"text":"26. Placeholder Policy"},{"level":3,"text":"For the Pitch build"},{"level":1,"text":"27. Technical Scope"},{"level":3,"text":"Engine"},{"level":3,"text":"Systems expected"},{"level":1,"text":"28. Technical Philosophy"},{"level":1,"text":"29. Build Evidence"},{"level":1,"text":"30. Evidence Naming Convention"},{"level":3,"text":"Build"},{"level":3,"text":"Video"},{"level":3,"text":"Screenshots"},{"level":3,"text":"Playtest"},{"level":3,"text":"Bugs"},{"level":1,"text":"31. Build Register"},{"level":1,"text":"32. Known Issues Register"},{"level":1,"text":"33. Pitch Readiness"},{"level":3,"text":"Current Pitch Readiness"},{"level":1,"text":"34. Pitch Readiness Levels"},{"level":2,"text":"RED"},{"level":2,"text":"YELLOW"},{"level":2,"text":"GREEN"},{"level":2,"text":"GOLD"},{"level":1,"text":"35. Current Assessment"},{"level":2,"text":"World & Lore"},{"level":2,"text":"Game Design"},{"level":2,"text":"Concept Art"},{"level":2,"text":"Vertical Slice Gameplay"},{"level":2,"text":"MegaGrant Package"},{"level":1,"text":"36. Public Exposure Policy"},{"level":2,"text":"PUBLIC"},{"level":2,"text":"REVIEW BEFORE PUBLICATION"},{"level":2,"text":"INTERNAL ONLY"},{"level":1,"text":"37. MegaGrant Evidence Target"},{"level":2,"text":"MUST"},{"level":2,"text":"STRONG BONUS"},{"level":1,"text":"38. Dependencies"},{"level":1,"text":"39. Current Critical Dependencies"},{"level":2,"text":"1. Vertical Slice location"},{"level":2,"text":"2. Playable roster"},{"level":2,"text":"3. Element subset"},{"level":2,"text":"4. Reaction subset"},{"level":2,"text":"5. Enemy roster"},{"level":2,"text":"6. Zalenquea final prototype role"},{"level":2,"text":"7. Visual direction"},{"level":2,"text":"8. UE5 technical architecture"},{"level":1,"text":"40. Completion Criteria"},{"level":1,"text":"41. Definition of Playable"},{"level":1,"text":"42. Definition of Vertical Slice Complete"},{"level":1,"text":"43. Current Project Position"},{"level":1,"text":"44. Immediate Next Documents"},{"level":2,"text":"VS-01 — Vision & Scope"},{"level":2,"text":"VS-02 — Player Flow & Demo Structure"},{"level":2,"text":"VS-03 — Feature Matrix"},{"level":2,"text":"VS-04 — Playable Character Roster"},{"level":2,"text":"VS-05 — Combat Encounters & Boss"},{"level":2,"text":"VS-06 — Environment & Exploration"},{"level":1,"text":"45. Vertical Slice Dashboard"},{"level":3,"text":"Recommended document status"}],"blocks":[{"type":"p","text":"SYMPHONY OF JUSTICE"},{"type":"p","text":"Vertical Slice Index"},{"type":"p","text":"Internal codename: Symphonia Iustitiae"},{"type":"table","table":0},{"type":"h1","text":"1. Purpose"},{"type":"p","text":"The Vertical Slice Index serves as the master document for navigation, scope control, and tracking of the Symphony of Justice Vertical Slice."},{"type":"p","text":"Its purpose is to record:"},{"type":"p","text":"• which documents make up the Vertical Slice;"},{"type":"p","text":"• which decision each document controls;"},{"type":"p","text":"• who is responsible;"},{"type":"p","text":"• what has been approved;"},{"type":"p","text":"• what is still in design;"},{"type":"p","text":"• what depends on other systems;"},{"type":"p","text":"• what content actually exists inside a build;"},{"type":"p","text":"• what evidence may be used publicly;"},{"type":"p","text":"• what material may be shown to Epic MegaGrants evaluators;"},{"type":"p","text":"• which known issues prevent the demo from being considered complete."},{"type":"p","text":"This document does not by itself prove that a feature exists. A feature should only be considered implemented when verifiable evidence exists through:"},{"type":"p","text":"• build;"},{"type":"p","text":"• video;"},{"type":"p","text":"• screenshot;"},{"type":"p","text":"• playtest;"},{"type":"p","text":"• Unreal Engine capture;"},{"type":"p","text":"• technical report."},{"type":"h1","text":"2. Vertical Slice Goal"},{"type":"p","text":"The Vertical Slice must demonstrate a small, representative portion of the final Symphony of Justice experience. It should not attempt to demonstrate the entire game."},{"type":"p","text":"Its goal is to answer: Can Symphony of Justice truly become the Action RPG promised by its Game Design?"},{"type":"p","text":"The demo should showcase the combination of:"},{"type":"p","text":"• 3D exploration;"},{"type":"p","text":"• real-time Action RPG combat;"},{"type":"p","text":"• distinct characters;"},{"type":"p","text":"• cooldown-based abilities;"},{"type":"p","text":"• elements;"},{"type":"p","text":"• reactions;"},{"type":"p","text":"• readable enemies;"},{"type":"p","text":"• limited progression;"},{"type":"p","text":"• environmental storytelling;"},{"type":"p","text":"• worldbuilding;"},{"type":"p","text":"• functional UI;"},{"type":"p","text":"• art direction;"},{"type":"p","text":"• Boss encounter;"},{"type":"p","text":"• sufficient technical quality to communicate the project vision."},{"type":"h1","text":"3. Vertical Slice Principles"},{"type":"h2","text":"3.1 Small world, complete experience"},{"type":"p","text":"The Vertical Slice should build: a small but complete experience"},{"type":"p","text":"instead of: a huge and incomplete version of the final game."},{"type":"h2","text":"3.2 Quality over quantity"},{"type":"p","text":"Priority will be given to:"},{"type":"p","text":"• combat feel;"},{"type":"p","text":"• visual clarity;"},{"type":"p","text":"• artistic identity;"},{"type":"p","text":"• coherence;"},{"type":"p","text":"• stability;"},{"type":"p","text":"over:"},{"type":"p","text":"• number of characters;"},{"type":"p","text":"• map size;"},{"type":"p","text":"• number of enemies;"},{"type":"p","text":"• hours of content."},{"type":"h2","text":"3.3 Representative, not exhaustive"},{"type":"p","text":"The demo should demonstrate representative systems."},{"type":"p","text":"It does not need to implement:"},{"type":"p","text":"• the entire roster;"},{"type":"p","text":"• all nations;"},{"type":"p","text":"• all elements;"},{"type":"p","text":"• the entire Endgame;"},{"type":"p","text":"• real multiplayer;"},{"type":"p","text":"• the complete economy;"},{"type":"p","text":"• real monetization."},{"type":"h2","text":"3.4 No fake systems"},{"type":"p","text":"A mechanic may be:"},{"type":"p","text":"• simplified;"},{"type":"p","text":"• simulated;"},{"type":"p","text":"• limited;"},{"type":"p","text":"but it must not be presented externally as fully functional if it is not."},{"type":"h1","text":"4. Target Experience"},{"type":"h3","text":"Initial platform"},{"type":"h1","text":"PC"},{"type":"h3","text":"Engine"},{"type":"h1","text":"Unreal Engine 5"},{"type":"h3","text":"Experience type"},{"type":"h1","text":"Single-player Action RPG Vertical Slice"},{"type":"h3","text":"Initial target duration"},{"type":"p","text":"20–30 minutes"},{"type":"p","text":"It may grow later if production justifies it."},{"type":"h1","text":"5. Core Experience Statement"},{"type":"p","text":"The Vertical Slice should allow a player to explore a small region, discover a conflict or mystery, use a reduced team of characters with different abilities, combine elements and reactions in combat, improve or prepare the party, and finish the experience by facing a Boss designed to test what the player has learned."},{"type":"h1","text":"6. Core Demonstration Loop"},{"type":"p","text":"The demo should condense the Game Design Core Loop:"},{"type":"p","text":"EXPLORE → DISCOVER → PREPARE → FIGHT → OBTAIN → IMPROVE → ADAPT → UNLOCK → EXPLORE"},{"type":"p","text":"For the Vertical Slice, it may be visually simplified to:"},{"type":"p","text":"Explore → Discover → Fight → Grow → Build → Explore"},{"type":"h1","text":"7. Document Map"},{"type":"p","text":"The Vertical Slice folder is organized through the following documents."},{"type":"table","table":1},{"type":"h1","text":"8. Status Definitions"},{"type":"p","text":"For the Vertical Slice, I recommend using production states that are different from the narrative states of the World Bible."},{"type":"table","table":2},{"type":"p","text":"This can coexist with:"},{"type":"p","text":"CANON / PROPOSED / PROTOTYPE"},{"type":"p","text":"because they answer different questions."},{"type":"p","text":"For example:"},{"type":"p","text":"Zalenquea Guardian\nLore: TBD\nGameplay Design: PROTOTYPE\nProduction: TEMPLATE"},{"type":"h1","text":"9. Scope Layers"},{"type":"p","text":"Each feature should be classified by priority."},{"type":"h2","text":"MUST"},{"type":"p","text":"Without this, the demo does not represent the game."},{"type":"h2","text":"SHOULD"},{"type":"p","text":"Strongly improves the demonstration."},{"type":"h2","text":"COULD"},{"type":"p","text":"Implemented only if time allows."},{"type":"h2","text":"OUT"},{"type":"p","text":"Outside the current Vertical Slice."},{"type":"h1","text":"10. Current High-Level Scope"},{"type":"h2","text":"MUST"},{"type":"p","text":"• Unreal Engine 5 project;"},{"type":"p","text":"• 3D movement;"},{"type":"p","text":"• camera;"},{"type":"p","text":"• real-time Action RPG combat;"},{"type":"p","text":"• basic attack;"},{"type":"p","text":"• cooldown-based abilities;"},{"type":"p","text":"• dodge;"},{"type":"p","text":"• at least one character resource;"},{"type":"p","text":"• multiple playable characters;"},{"type":"p","text":"• character switching or an approved equivalent system;"},{"type":"p","text":"• elements;"},{"type":"p","text":"• selected reactions;"},{"type":"p","text":"• normal enemies;"},{"type":"p","text":"• Elite;"},{"type":"p","text":"• Boss;"},{"type":"p","text":"• micro-region;"},{"type":"p","text":"• exploration;"},{"type":"p","text":"• POIs;"},{"type":"p","text":"• reward;"},{"type":"p","text":"• limited progression;"},{"type":"p","text":"• HUD;"},{"type":"p","text":"• minimal narrative;"},{"type":"p","text":"• basic audio;"},{"type":"p","text":"• VFX;"},{"type":"p","text":"• minimal pause/settings menu;"},{"type":"p","text":"• executable build."},{"type":"h2","text":"SHOULD"},{"type":"p","text":"• four playable characters;"},{"type":"p","text":"• exploration with small secrets;"},{"type":"p","text":"• 5–8 POIs;"},{"type":"p","text":"• elemental puzzle;"},{"type":"p","text":"• environmental puzzle;"},{"type":"p","text":"• environmental storytelling;"},{"type":"p","text":"• limited Codex;"},{"type":"p","text":"• one short mission;"},{"type":"p","text":"• NPC interaction;"},{"type":"p","text":"• transition between safe and dangerous areas;"},{"type":"p","text":"• small preparation phase before the Boss;"},{"type":"p","text":"• results or closing screen."},{"type":"h2","text":"COULD"},{"type":"p","text":"• simulated gacha;"},{"type":"p","text":"• small acquisition screen;"},{"type":"p","text":"• demonstrative Legacy Card;"},{"type":"p","text":"• basic crafting;"},{"type":"p","text":"• limited equipment;"},{"type":"p","text":"• small shop;"},{"type":"p","text":"• weather;"},{"type":"p","text":"• day/night cycle;"},{"type":"p","text":"• photography;"},{"type":"p","text":"• optional content."},{"type":"h2","text":"OUT"},{"type":"p","text":"For the first version of the Vertical Slice:"},{"type":"p","text":"• real online multiplayer;"},{"type":"p","text":"• PvP;"},{"type":"p","text":"• guilds;"},{"type":"p","text":"• dedicated servers;"},{"type":"p","text":"• chat;"},{"type":"p","text":"• trading;"},{"type":"p","text":"• full housing;"},{"type":"p","text":"• large open world;"},{"type":"p","text":"• all nations;"},{"type":"p","text":"• complete roster;"},{"type":"p","text":"• all elements;"},{"type":"p","text":"• final economy;"},{"type":"p","text":"• real monetization;"},{"type":"p","text":"• store with payments;"},{"type":"p","text":"• battle pass;"},{"type":"p","text":"• seasons;"},{"type":"p","text":"• raids;"},{"type":"p","text":"• complete Endgame;"},{"type":"p","text":"• legal account system;"},{"type":"p","text":"• complete Live Service backend."},{"type":"p","text":"This protects the project from every development team’s favorite monster: scope creep."},{"type":"h1","text":"11. Playable Character Target"},{"type":"p","text":"The current design considers a reasonable target of:"},{"type":"p","text":"4 playable characters"},{"type":"p","text":"but this number must remain a:"},{"type":"p","text":"PROTOTYPE TARGET"},{"type":"p","text":"until production has been validated."},{"type":"h3","text":"Roster objective"},{"type":"p","text":"The selected characters should demonstrate real differences in:"},{"type":"p","text":"• element;"},{"type":"p","text":"• role;"},{"type":"p","text":"• range;"},{"type":"p","text":"• mobility;"},{"type":"p","text":"• ability;"},{"type":"p","text":"• Ultimate;"},{"type":"p","text":"• resource;"},{"type":"p","text":"• talent."},{"type":"p","text":"We do not need four characters that hit differently but play the same."},{"type":"h1","text":"12. Combat Model"},{"type":"p","text":"The demo will use:"},{"type":"p","text":"real-time Action RPG combat"},{"type":"p","text":"and NOT the old turn-based system found in certain historical documents."},{"type":"h3","text":"Expected components"},{"type":"p","text":"• free movement;"},{"type":"p","text":"• 3D camera;"},{"type":"p","text":"• attacks;"},{"type":"p","text":"• dodge;"},{"type":"p","text":"• cooldowns;"},{"type":"p","text":"• Ultimate;"},{"type":"p","text":"• resources;"},{"type":"p","text":"• telegraphs;"},{"type":"p","text":"• active enemies;"},{"type":"p","text":"• elements;"},{"type":"p","text":"• reactions;"},{"type":"p","text":"• team switching/adaptation."},{"type":"h1","text":"13. Character Swapping"},{"type":"p","text":"The currently recommended system consists of:"},{"type":"p","text":"one directly controlled active character with quick switching between party members."},{"type":"h3","text":"Status"},{"type":"p","text":"PROPOSED / must be prototyped."},{"type":"p","text":"If it does not technically produce a good experience, it may be reviewed without changing the overall game concept."},{"type":"h1","text":"14. Elemental Scope"},{"type":"p","text":"We do not need to implement every historical reaction."},{"type":"h3","text":"Recommended Vertical Slice"},{"type":"p","text":"Select:"},{"type":"p","text":"• 3–4 elements"},{"type":"p","text":"• 2–4 main reactions"},{"type":"p","text":"that can demonstrate:"},{"type":"p","text":"• aura;"},{"type":"p","text":"• trigger;"},{"type":"p","text":"• reaction;"},{"type":"p","text":"• visual feedback;"},{"type":"p","text":"• composition decisions."},{"type":"h3","text":"Status"},{"type":"p","text":"PROTOTYPE."},{"type":"h1","text":"15. Enemy Scope"},{"type":"h3","text":"Initial target"},{"type":"p","text":"• 2 basic enemy families"},{"type":"p","text":"• 1 Elite/Subboss"},{"type":"p","text":"• 1 Boss"},{"type":"p","text":"It may be accompanied by non-hostile fauna."},{"type":"h1","text":"16. Boss Candidate"},{"type":"h2","text":"Zalenquea Guardian"},{"type":"h3","text":"Historical status"},{"type":"p","text":"LEGACY SUPPORTED"},{"type":"h3","text":"Vertical Slice status"},{"type":"p","text":"PROTOTYPE"},{"type":"h3","text":"Purpose"},{"type":"p","text":"Function as the final examination of:"},{"type":"p","text":"• movement;"},{"type":"p","text":"• dodge;"},{"type":"p","text":"• cooldown management;"},{"type":"p","text":"• character switching;"},{"type":"p","text":"• elements;"},{"type":"p","text":"• reactions;"},{"type":"p","text":"• terrain;"},{"type":"p","text":"• attack readability."},{"type":"h3","text":"Current concept"},{"type":"p","text":"A Guardian associated with Earth."},{"type":"p","text":"The current prototype considers:"},{"type":"p","text":"• tectonic armor;"},{"type":"p","text":"• breakable plates;"},{"type":"p","text":"• vulnerable core;"},{"type":"p","text":"• terrain modification;"},{"type":"p","text":"• a second phase that changes the combat space."},{"type":"h3","text":"Important"},{"type":"p","text":"This is:"},{"type":"p","text":"GAMEPLAY PROTOTYPE"},{"type":"p","text":"It does not yet mean that its definitive lore is: “an ancient tectonic golem created by X.”"},{"type":"p","text":"That remains TBD."},{"type":"h1","text":"17. Environment Scope"},{"type":"p","text":"The demo needs:"},{"type":"p","text":"one micro-region"},{"type":"p","text":"Not an entire nation."},{"type":"h3","text":"Initial target"},{"type":"p","text":"5–8 POIs"},{"type":"p","text":"Examples of function:"},{"type":"p","text":"1. entrance;"},{"type":"p","text":"2. safe area;"},{"type":"p","text":"3. landmark;"},{"type":"p","text":"4. resource;"},{"type":"p","text":"5. encounter;"},{"type":"p","text":"6. puzzle;"},{"type":"p","text":"7. secret;"},{"type":"p","text":"8. Boss arena."},{"type":"p","text":"Not all are mandatory."},{"type":"h1","text":"18. Environmental Progression"},{"type":"p","text":"The region should communicate progression through:"},{"type":"h3","text":"Zone 1"},{"type":"p","text":"Safe / introduction."},{"type":"h3","text":"Zone 2"},{"type":"p","text":"Normal exploration."},{"type":"h3","text":"Zone 3"},{"type":"p","text":"Increasing danger."},{"type":"h3","text":"Zone 4"},{"type":"p","text":"Preparation/climax."},{"type":"h3","text":"Zone 5"},{"type":"p","text":"Boss."},{"type":"h1","text":"19. Vertical Slice Location"},{"type":"h3","text":"Currently:"},{"type":"p","text":"TBD"},{"type":"p","text":"We have not yet confirmed whether it takes place in:"},{"type":"p","text":"• Arcana Nation;"},{"type":"p","text":"• Archangels;"},{"type":"p","text":"• Mafia;"},{"type":"p","text":"• Beasts;"},{"type":"p","text":"• Kingdomless Island;"},{"type":"p","text":"• an independent region."},{"type":"p","text":"This should be decided after comparing:"},{"type":"p","text":"• visual value;"},{"type":"p","text":"• required lore;"},{"type":"p","text":"• technical difficulty;"},{"type":"p","text":"• assets;"},{"type":"p","text":"• relationship to characters;"},{"type":"p","text":"• ability to represent the game."},{"type":"h1","text":"20. Narrative Scope"},{"type":"p","text":"The Vertical Slice story should be: self-contained, understandable, and connected to the larger universe."},{"type":"p","text":"We do not need to adapt a full chapter of the main story."},{"type":"h3","text":"Recommended structure"},{"type":"h2","text":"Beginning"},{"type":"p","text":"The player receives a clear reason to explore."},{"type":"h2","text":"Discovery"},{"type":"p","text":"The player finds:"},{"type":"p","text":"• environment;"},{"type":"p","text":"• NPC;"},{"type":"p","text":"• evidence;"},{"type":"p","text":"• anomaly."},{"type":"h2","text":"Development"},{"type":"p","text":"Combat and exploration reveal the problem."},{"type":"h2","text":"Preparation"},{"type":"p","text":"The player understands how to face the threat."},{"type":"h2","text":"Boss"},{"type":"p","text":"Mechanical resolution."},{"type":"h2","text":"Closing"},{"type":"p","text":"The immediate conflict is resolved, but a larger question remains."},{"type":"h1","text":"21. Narrative Rule"},{"type":"p","text":"The Vertical Slice should demonstrate one of the project’s fundamental principles:"},{"type":"p","text":"the first explanation the player receives is not necessarily the whole truth."},{"type":"p","text":"There is no need to reveal:"},{"type":"p","text":"• Master of the Birds;"},{"type":"p","text":"• Iluminate’s true death;"},{"type":"p","text":"• PLO;"},{"type":"p","text":"• Memento Mori;"},{"type":"p","text":"• central secrets."},{"type":"p","text":"A small local conflict can demonstrate the same narrative philosophy."},{"type":"h1","text":"22. Progression Scope"},{"type":"p","text":"The demo should allow a small but real sense of growth."},{"type":"h3","text":"May include"},{"type":"p","text":"• XP;"},{"type":"p","text":"• character upgrades;"},{"type":"p","text":"• ability upgrades;"},{"type":"p","text":"• limited equipment;"},{"type":"p","text":"• a resource obtained through exploration;"},{"type":"p","text":"• encounter rewards."},{"type":"h3","text":"Does not need"},{"type":"p","text":"• level 90;"},{"type":"p","text":"• complete Ascensions;"},{"type":"p","text":"• complete economy;"},{"type":"p","text":"• farming;"},{"type":"p","text":"• weeks of progression."},{"type":"h3","text":"Status"},{"type":"p","text":"PROTOTYPE."},{"type":"h1","text":"23. Gacha in Vertical Slice"},{"type":"p","text":"The full monetization system:"},{"type":"p","text":"MUST NOT be implemented."},{"type":"p","text":"If we want to demonstrate acquisition:"},{"type":"h3","text":"Option"},{"type":"p","text":"create a:"},{"type":"p","text":"simulated deterministic acquisition screen"},{"type":"p","text":"without:"},{"type":"p","text":"• real money;"},{"type":"p","text":"• payments;"},{"type":"p","text":"• commercial manipulation."},{"type":"p","text":"It may show:"},{"type":"p","text":"• acquisition;"},{"type":"p","text":"• character presentation;"},{"type":"p","text":"• rarity;"},{"type":"p","text":"• Legacy;"},{"type":"p","text":"without building monetization."},{"type":"h3","text":"Priority"},{"type":"p","text":"COULD."},{"type":"h1","text":"24. UI Requirements Overview"},{"type":"p","text":"At minimum, the demo should include:"},{"type":"p","text":"• HP;"},{"type":"p","text":"• abilities;"},{"type":"p","text":"• cooldown;"},{"type":"p","text":"• Ultimate;"},{"type":"p","text":"• elemental indicator;"},{"type":"p","text":"• available characters;"},{"type":"p","text":"• current objective;"},{"type":"p","text":"• interaction;"},{"type":"p","text":"• damage/status feedback;"},{"type":"p","text":"• pause."},{"type":"h3","text":"SHOULD"},{"type":"p","text":"• minimap;"},{"type":"p","text":"• map;"},{"type":"p","text":"• limited inventory;"},{"type":"p","text":"• character sheet;"},{"type":"p","text":"• Codex;"},{"type":"p","text":"• contextual tutorials."},{"type":"h1","text":"25. Art Requirements Overview"},{"type":"p","text":"The demo needs to achieve a visual direction clear enough to:"},{"type":"p","text":"be recognizable as Symphony of Justice"},{"type":"p","text":"even if temporary assets are used during early prototyping."},{"type":"h3","text":"Stages"},{"type":"h2","text":"Blockout"},{"type":"p","text":"Functional geometry."},{"type":"h2","text":"Greybox"},{"type":"p","text":"Complete gameplay."},{"type":"h2","text":"Art Pass"},{"type":"p","text":"Representative assets."},{"type":"h2","text":"Lighting Pass"},{"type":"p","text":"Approximate final lighting."},{"type":"h2","text":"Polish"},{"type":"p","text":"VFX, animation, audio, cinematography."},{"type":"h1","text":"26. Placeholder Policy"},{"type":"p","text":"Placeholders are allowed during development."},{"type":"p","text":"But they must be marked as:"},{"type":"p","text":"TEMP"},{"type":"p","text":"Examples:"},{"type":"p","text":"• Marketplace animation;"},{"type":"p","text":"• temporary materials;"},{"type":"p","text":"• placeholder sounds;"},{"type":"p","text":"• base models;"},{"type":"p","text":"• temporary icons."},{"type":"h3","text":"For the Pitch build"},{"type":"p","text":"Every visible asset must be:"},{"type":"p","text":"• original;"},{"type":"p","text":"• properly licensed;"},{"type":"p","text":"• permitted for commercial use;"},{"type":"p","text":"• compatible with public presentation."},{"type":"p","text":"Inherited materials from external IP in Original Material must not be included."},{"type":"h1","text":"27. Technical Scope"},{"type":"h3","text":"Engine"},{"type":"p","text":"Unreal Engine 5"},{"type":"h3","text":"Systems expected"},{"type":"p","text":"• Character Controller;"},{"type":"p","text":"• Camera;"},{"type":"p","text":"• Ability System or equivalent architecture;"},{"type":"p","text":"• Enemy AI;"},{"type":"p","text":"• Combat;"},{"type":"p","text":"• Element system;"},{"type":"p","text":"• Reaction system;"},{"type":"p","text":"• Character switching;"},{"type":"p","text":"• Health/damage;"},{"type":"p","text":"• UI;"},{"type":"p","text":"• Interaction;"},{"type":"p","text":"• Checkpoints;"},{"type":"p","text":"• limited Save;"},{"type":"p","text":"• Level streaming if necessary;"},{"type":"p","text":"• audio;"},{"type":"p","text":"• VFX."},{"type":"h1","text":"28. Technical Philosophy"},{"type":"p","text":"For the Vertical Slice:"},{"type":"p","text":"functional and extensible > perfect architecture."},{"type":"p","text":"But also:"},{"type":"p","text":"rapid prototype ≠ uncontrolled disposable code."},{"type":"p","text":"Fundamental systems should be built with later reuse in mind."},{"type":"h1","text":"29. Build Evidence"},{"type":"p","text":"This section should contain only evidence that actually exists."},{"type":"p","text":"At present, no Unreal Engine 5 Vertical Slice build has been registered in this conversation."},{"type":"p","text":"Therefore, we should not pretend that one exists."},{"type":"table","table":3},{"type":"p","text":"That table is better than filling everything with “coming soon.”"},{"type":"p","text":"It tells us clearly:"},{"type":"p","text":"we are still entering Vertical Slice pre-production."},{"type":"h1","text":"30. Evidence Naming Convention"},{"type":"p","text":"When we begin to have builds:"},{"type":"h3","text":"Build"},{"type":"p","text":"SOJ_VS_Build_0.1.0_Win64"},{"type":"h3","text":"Video"},{"type":"p","text":"SOJ_VS_Gameplay_0.1.0.mp4"},{"type":"h3","text":"Screenshots"},{"type":"p","text":"SOJ_VS_ENV_001.png"},{"type":"h3","text":"Playtest"},{"type":"p","text":"SOJ_VS_Playtest_001.docx"},{"type":"h3","text":"Bugs"},{"type":"p","text":"SOJ_VS_KnownIssues_0.1.0.xlsx"},{"type":"p","text":"This will help a great deal once there are twenty versions and they are all named:"},{"type":"p","text":"final_final_now_yes_2.zip"},{"type":"p","text":"The traditional graveyard of every digital project. 😭"},{"type":"h1","text":"31. Build Register"},{"type":"p","text":"When builds exist:"},{"type":"table","table":4},{"type":"h1","text":"32. Known Issues Register"},{"type":"p","text":"Recommended format:"},{"type":"table","table":5},{"type":"p","text":"Severities:"},{"type":"p","text":"• Critical"},{"type":"p","text":"• High"},{"type":"p","text":"• Medium"},{"type":"p","text":"• Low"},{"type":"p","text":"• Polish"},{"type":"h1","text":"33. Pitch Readiness"},{"type":"p","text":"Here the index should answer:"},{"type":"p","text":"What can we show today?"},{"type":"h3","text":"Current Pitch Readiness"},{"type":"table","table":6},{"type":"h1","text":"34. Pitch Readiness Levels"},{"type":"p","text":"We can use four levels:"},{"type":"h2","text":"RED"},{"type":"p","text":"Do not show."},{"type":"h2","text":"YELLOW"},{"type":"p","text":"Show only as: concept / work in progress."},{"type":"h2","text":"GREEN"},{"type":"p","text":"Presentable."},{"type":"h2","text":"GOLD"},{"type":"p","text":"Quality sufficient for:"},{"type":"p","text":"• website hero;"},{"type":"p","text":"• trailer;"},{"type":"p","text":"• MegaGrant;"},{"type":"p","text":"• publisher pitch."},{"type":"h1","text":"35. Current Assessment"},{"type":"h2","text":"World & Lore"},{"type":"p","text":"🟢 GREEN"},{"type":"p","text":"Conceptually presentable on a selective basis."},{"type":"h2","text":"Game Design"},{"type":"p","text":"🟢 GREEN"},{"type":"p","text":"Can explain systems."},{"type":"p","text":"But Prototype numbers should not be presented as final."},{"type":"h2","text":"Concept Art"},{"type":"p","text":"🟡 YELLOW"},{"type":"p","text":"Until final pieces exist."},{"type":"h2","text":"Vertical Slice Gameplay"},{"type":"p","text":"🔴 RED"},{"type":"p","text":"No registered playable evidence exists yet."},{"type":"h2","text":"MegaGrant Package"},{"type":"p","text":"🟡 YELLOW"},{"type":"p","text":"The vision can be prepared."},{"type":"p","text":"But the application will gain enormous value once there is:"},{"type":"p","text":"• build;"},{"type":"p","text":"• video;"},{"type":"p","text":"• Concept Art;"},{"type":"p","text":"• real testing."},{"type":"h1","text":"36. Public Exposure Policy"},{"type":"p","text":"The overall document is marked:"},{"type":"p","text":"Mixed"},{"type":"p","text":"because it contains information that may or may not be shown."},{"type":"h2","text":"PUBLIC"},{"type":"p","text":"May be used on web/pitch:"},{"type":"p","text":"• Action RPG;"},{"type":"p","text":"• UE5;"},{"type":"p","text":"• exploration;"},{"type":"p","text":"• combat;"},{"type":"p","text":"• elements;"},{"type":"p","text":"• characters;"},{"type":"p","text":"• world;"},{"type":"p","text":"• micro-region;"},{"type":"p","text":"• Boss;"},{"type":"p","text":"• final screenshots;"},{"type":"p","text":"• footage."},{"type":"h2","text":"REVIEW BEFORE PUBLICATION"},{"type":"p","text":"• prototype numbers;"},{"type":"p","text":"• provisional character roster;"},{"type":"p","text":"• exact demo location;"},{"type":"p","text":"• systems not yet validated;"},{"type":"p","text":"• technical diagrams."},{"type":"h2","text":"INTERNAL ONLY"},{"type":"p","text":"• bugs;"},{"type":"p","text":"• risks;"},{"type":"p","text":"• cut content;"},{"type":"p","text":"• internal architecture;"},{"type":"p","text":"• performance issues;"},{"type":"p","text":"• narrative secrets;"},{"type":"p","text":"• temporary assets;"},{"type":"p","text":"• comparisons with external references;"},{"type":"p","text":"• IP placeholders."},{"type":"h1","text":"37. MegaGrant Evidence Target"},{"type":"p","text":"Before submitting a strong version to Epic, ideally we should have:"},{"type":"h2","text":"MUST"},{"type":"p","text":"• clear description;"},{"type":"p","text":"• UE5 confirmed;"},{"type":"p","text":"• real gameplay;"},{"type":"p","text":"• functional build;"},{"type":"p","text":"• 1–3 minute video;"},{"type":"p","text":"• screenshots;"},{"type":"p","text":"• production goal;"},{"type":"p","text":"• team/responsible person;"},{"type":"p","text":"• budget;"},{"type":"p","text":"• roadmap."},{"type":"h2","text":"STRONG BONUS"},{"type":"p","text":"• Concept Art;"},{"type":"p","text":"• complete Boss;"},{"type":"p","text":"• visible elemental reaction;"},{"type":"p","text":"• small cinematic;"},{"type":"p","text":"• playtest feedback;"},{"type":"p","text":"• website;"},{"type":"p","text":"• short trailer."},{"type":"h1","text":"38. Dependencies"},{"type":"p","text":"The Vertical Slice directly depends on:"},{"type":"p","text":"GAME DESIGN ✅\n│\n├──────────────┐\n▼              ▼\nWORLD & LORE   CHARACTERS\n│              │\n└───────┬──────┘\n        ▼\n   CONCEPT ART\n        │\n        ▼\nVERTICAL SLICE SCOPE\n        │\n        ▼\n   CORE PROTOTYPE\n        │\n        ▼\n   GREYBOX BUILD\n        │\n        ▼\n      ART PASS\n        │\n        ▼\n   PLAYTEST / QA\n        │\n        ▼\n POLISH / CAPTURE\n        │\n        ▼\nWEBSITE + MEGAGRANT"},{"type":"h1","text":"39. Current Critical Dependencies"},{"type":"p","text":"Before serious production begins, we need to decide:"},{"type":"h2","text":"1. Vertical Slice location"},{"type":"p","text":"TBD"},{"type":"h2","text":"2. Playable roster"},{"type":"p","text":"TBD"},{"type":"h2","text":"3. Element subset"},{"type":"p","text":"TBD"},{"type":"h2","text":"4. Reaction subset"},{"type":"p","text":"TBD"},{"type":"h2","text":"5. Enemy roster"},{"type":"p","text":"TBD"},{"type":"h2","text":"6. Zalenquea final prototype role"},{"type":"p","text":"PROTOTYPE"},{"type":"h2","text":"7. Visual direction"},{"type":"p","text":"Depends on Concept Art."},{"type":"h2","text":"8. UE5 technical architecture"},{"type":"p","text":"TBD"},{"type":"h1","text":"40. Completion Criteria"},{"type":"p","text":"The Vertical Slice may only be marked:"},{"type":"p","text":"DONE"},{"type":"p","text":"when:"},{"type":"p","text":"• an executable build exists;"},{"type":"p","text":"• it can be completed from beginning to end;"},{"type":"p","text":"• the Core Loop is represented;"},{"type":"p","text":"• combat works;"},{"type":"p","text":"• characters feel distinct;"},{"type":"p","text":"• reactions work;"},{"type":"p","text":"• exploration works;"},{"type":"p","text":"• the Boss can be defeated;"},{"type":"p","text":"• the UI communicates correctly;"},{"type":"p","text":"• there are no critical blockers;"},{"type":"p","text":"• performance reaches the approved target;"},{"type":"p","text":"• public assets have clear rights;"},{"type":"p","text":"• gameplay capture exists;"},{"type":"p","text":"• documented playtesting exists;"},{"type":"p","text":"• the team considers that it reasonably represents the vision."},{"type":"h1","text":"41. Definition of Playable"},{"type":"p","text":"Do not confuse:"},{"type":"p","text":"COMPILES"},{"type":"p","text":"with:"},{"type":"p","text":"IS PLAYABLE."},{"type":"p","text":"PLAYABLE means:"},{"type":"p","text":"a person can open the build, understand what to do, progress, fight, and complete the intended content without using development tools."},{"type":"h1","text":"42. Definition of Vertical Slice Complete"},{"type":"p","text":"A finished Vertical Slice does not mean:"},{"type":"p","text":"“we have the complete game, but smaller.”"},{"type":"p","text":"It means:"},{"type":"p","text":"we have a sufficiently finished section to demonstrate how the complete game should feel."},{"type":"h1","text":"43. Current Project Position"},{"type":"p","text":"I would currently place the project here:"},{"type":"p","text":"GAME VISION ✅"},{"type":"p","text":"GAME DESIGN FOUNDATION ✅"},{"type":"p","text":"WORLD & LORE IN PROGRESS 🟢"},{"type":"p","text":"CONCEPT ART NEXT 🟡"},{"type":"p","text":"VERTICAL SLICE PLANNING STARTING 🟡"},{"type":"p","text":"CORE PROTOTYPE NOT STARTED / NOT EVIDENCED 🔴"},{"type":"p","text":"PLAYABLE BUILD 🔴"},{"type":"p","text":"POLISHED BUILD 🔴"},{"type":"p","text":"PITCH CAPTURE 🔴"},{"type":"p","text":"MEGAGRANT READY FUTURE 🟡"},{"type":"p","text":"This is not a bad position."},{"type":"p","text":"On the contrary, it means we are entering the Vertical Slice with prior design work instead of opening Unreal and placing cubes while hoping the game magically appears through atmospheric pressure."},{"type":"h1","text":"44. Immediate Next Documents"},{"type":"p","text":"From this index, I would work on the Vertical Slice in exactly this order:"},{"type":"h2","text":"VS-01 — Vision & Scope"},{"type":"p","text":"First."},{"type":"p","text":"Defines what we are promising to build."},{"type":"p","text":"↓"},{"type":"h2","text":"VS-02 — Player Flow & Demo Structure"},{"type":"p","text":"Defines the 20–30 minutes."},{"type":"p","text":"↓"},{"type":"h2","text":"VS-03 — Feature Matrix"},{"type":"p","text":"Defines which systems that journey needs."},{"type":"p","text":"↓"},{"type":"h2","text":"VS-04 — Playable Character Roster"},{"type":"p","text":"We choose who demonstrates those systems."},{"type":"p","text":"↓"},{"type":"h2","text":"VS-05 — Combat Encounters & Boss"},{"type":"p","text":"We choose what the player faces."},{"type":"p","text":"↓"},{"type":"h2","text":"VS-06 — Environment & Exploration"},{"type":"p","text":"We build where it happens."},{"type":"p","text":"After that, the following begin to fall naturally into place:"},{"type":"p","text":"• Narrative;"},{"type":"p","text":"• Art Requirements;"},{"type":"p","text":"• UI;"},{"type":"p","text":"• Technical Plan;"},{"type":"p","text":"• QA;"},{"type":"p","text":"• Deliverables."},{"type":"h1","text":"45. Vertical Slice Dashboard"},{"type":"p","text":"I would close the document with this small dashboard:"},{"type":"table","table":7},{"type":"h3","text":"Recommended document status"},{"type":"p","text":"VERTICAL SLICE INDEX v0.15.7"},{"type":"p","text":"DRAFT / ACTIVE"},{"type":"p","text":"Scope Definition: STARTING"},{"type":"p","text":"World Foundation: STRONG"},{"type":"p","text":"Game Design Foundation: COMPLETE"},{"type":"p","text":"Vertical Slice Design: EARLY PRE-PRODUCTION"},{"type":"p","text":"Unreal Implementation: NOT YET EVIDENCED"},{"type":"p","text":"Build Evidence: NONE REGISTERED"},{"type":"p","text":"Public Gameplay: NOT READY"},{"type":"p","text":"MegaGrant Visual Package: IN DEVELOPMENT"}],"tables":[[["Folder","Vertical Slice","Status","TEMPLATE"],["Version","0.15.7","Last Updated","2026-08-16"]],[["ID","Document","Purpose","Owner","Status","Dependencies"],["VS-00","Vertical Slice Index","Master control","J. Crow","DRAFT","All"],["VS-01","Vision & Scope","Defines what is included and excluded","J. Crow","NEXT","Game Design"],["VS-02","Player Flow & Demo Structure","Complete player journey","J. Crow","TEMPLATE","VS-01"],["VS-03","Feature Matrix","System list and priority","Design","TEMPLATE","VS-01"],["VS-04","Playable Character Roster","Playable demo characters","Design","TEMPLATE","Character Gameplay"],["VS-05","Combat Encounters & Boss","Enemies, encounters, and Boss","De