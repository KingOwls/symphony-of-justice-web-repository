{"id":"slice-03-feature-and-content-matrix","group":"slice","groupLabel":"Vertical Slice","number":"03","title":"Feature and Content Matrix","summary":"Controls scope by ranking every slice feature as MUST, SHOULD, COULD or CUT and tying it to pillars, dependencies and evidence.","sourceFile":"Vertical Slice/03 - Feature and Content Matrix.docx","meta":{"folder":"Vertical Slice","status":"TEMPLATE","version":"0.1.0","last_updated":"2026-08-16"},"headings":[{"level":1,"text":"1. Purpose"},{"level":1,"text":"2. Scope Priority"},{"level":2,"text":"MUST"},{"level":2,"text":"SHOULD"},{"level":2,"text":"COULD"},{"level":2,"text":"CUT / OUT"},{"level":1,"text":"3. Cut Rule"},{"level":1,"text":"4. Pillars Used by the Matrix"},{"level":2,"text":"P1"},{"level":3,"text":"Characters with Gameplay Identity"},{"level":2,"text":"P2"},{"level":3,"text":"Strategy, Synergy & Adaptation"},{"level":2,"text":"P3"},{"level":3,"text":"Exploration, Discovery & Progression"},{"level":2,"text":"P4"},{"level":3,"text":"World, Narrative & Perspectives"},{"level":1,"text":"5. Evidence Types"},{"level":1,"text":"6. Production Status"},{"level":1,"text":"7. Feature Matrix"},{"level":2,"text":"Player Foundation"},{"level":1,"text":"8. Movement Scope"},{"level":2,"text":"MUST"},{"level":2,"text":"SHOULD"},{"level":2,"text":"COULD"},{"level":2,"text":"CUT"},{"level":1,"text":"9. Combat Matrix"},{"level":1,"text":"10. Important Combat Canon Correction"},{"level":3,"text":"Current Decision"},{"level":1,"text":"DEPRECATED"},{"level":1,"text":"REAL-TIME ACTION RPG COMBAT"},{"level":1,"text":"11. Character System Matrix"},{"level":1,"text":"12. Playable Roster Target"},{"level":3,"text":"Current target"},{"level":1,"text":"4 playable characters"},{"level":2,"text":"Minimum acceptable fallback"},{"level":1,"text":"3 characters"},{"level":1,"text":"13. Roster Selection Criteria"},{"level":1,"text":"14. Candidate Legacy Pool"},{"level":3,"text":"Status"},{"level":1,"text":"SOURCE POOL"},{"level":1,"text":"15. Element System Matrix"},{"level":1,"text":"16. Vertical Slice Element Scope"},{"level":1,"text":"3–4 elements"},{"level":1,"text":"Reaction Target"},{"level":1,"text":"2–4 reactions"},{"level":3,"text":"MUST"},{"level":1,"text":"17. Pure Powers"},{"level":3,"text":"Vertical Slice"},{"level":1,"text":"COULD / SELECTIVE"},{"level":1,"text":"18. Reaction Implementation Rule"},{"level":1,"text":"19. Enemy AI Matrix"},{"level":1,"text":"20. Enemy Content Target"},{"level":2,"text":"MUST"},{"level":3,"text":"Enemy Family A"},{"level":3,"text":"Enemy Family B"},{"level":3,"text":"Elite"},{"level":3,"text":"Boss"},{"level":1,"text":"21. Historical Enemy Pool"},{"level":3,"text":"Important"},{"level":1,"text":"LEGACY SOURCE OPTIONS"},{"level":1,"text":"22. Boss Matrix"},{"level":2,"text":"Current Candidate"},{"level":1,"text":"Zalenquea Guardian"},{"level":3,"text":"Current Vertical Slice State"},{"level":1,"text":"PROTOTYPE"},{"level":1,"text":"23. Boss Evidence Required"},{"level":1,"text":"24. Exploration Matrix"},{"level":1,"text":"25. Environment Content Matrix"},{"level":2,"text":"MUST"},{"level":2,"text":"SHOULD"},{"level":2,"text":"COULD"},{"level":1,"text":"26. Puzzle Matrix"},{"level":1,"text":"27. Puzzle Rule"},{"level":1,"text":"28. Narrative Matrix"},{"level":1,"text":"29. Narrative Asset Target"},{"level":3,"text":"MUST"},{"level":2,"text":"SHOULD"},{"level":1,"text":"30. Cinematic Matrix"},{"level":1,"text":"31. Progression Matrix"},{"level":1,"text":"32. Progression Proof"},{"level":1,"text":"33. Equipment Matrix"},{"level":2,"text":"SHOULD"},{"level":2,"text":"CUT"},{"level":1,"text":"34. Acquisition & Gacha Matrix"},{"level":1,"text":"35. UI Matrix"},{"level":1,"text":"36. UI Principle"},{"level":1,"text":"37. VFX Matrix"},{"level":2,"text":"MUST"},{"level":2,"text":"SHOULD"},{"level":2,"text":"CUT"},{"level":1,"text":"38. Animation Matrix"},{"level":1,"text":"39. Audio Matrix"},{"level":1,"text":"40. Content Matrix"},{"level":2,"text":"Characters"},{"level":1,"text":"41. Content Matrix"},{"level":2,"text":"Enemies"},{"level":1,"text":"42. Content Matrix"},{"level":2,"text":"Environment"},{"level":1,"text":"43. Props Matrix"},{"level":2,"text":"MUST"},{"level":2,"text":"SHOULD"},{"level":2,"text":"CUT"},{"level":1,"text":"44. Narrative Content Matrix"},{"level":1,"text":"45. Performance / Technical Features"},{"level":1,"text":"46. Unreal Engine System Matrix"},{"level":1,"text":"47. Accessibility Matrix"},{"level":2,"text":"MUST"},{"level":2,"text":"SHOULD"},{"level":1,"text":"48. Feature Validation Rule"},{"level":2,"text":"Functional"},{"level":2,"text":"Readable"},{"level":2,"text":"Useful"},{"level":2,"text":"Integrated"},{"level":2,"text":"Representative"},{"level":2,"text":"Evidenced"},{"level":1,"text":"49. Cut Decision Framework"},{"level":3,"text":"1. COULD"},{"level":3,"text":"2. SHOULD with low pillar value"},{"level":3,"text":"3. Content quantity"},{"level":3,"text":"4. Visual complexity"},{"level":3,"text":"5. NEVER cut a core promise casually"},{"level":1,"text":"50. Quality Before Quantity Rule"},{"level":3,"text":"Option A"},{"level":3,"text":"Option B"},{"level":1,"text":"Choose B."},{"level":1,"text":"51. Feature Freeze"},{"level":1,"text":"FEATURE FREEZE"},{"level":1,"text":"52. Current Feature Freeze State"},{"level":1,"text":"NOT ACTIVE"},{"level":1,"text":"53. Recommended Implementation Order"},{"level":2,"text":"Phase A"},{"level":3,"text":"Player Fundamentals"},{"level":2,"text":"Phase B"},{"level":3,"text":"Ability Combat"},{"level":2,"text":"Phase C"},{"level":3,"text":"Character Identity"},{"level":2,"text":"Phase D"},{"level":3,"text":"Elemental Core"},{"level":2,"text":"Phase E"},{"level":3,"text":"Enemy Foundation"},{"level":2,"text":"Phase F"},{"level":3,"text":"Combat Loop Prototype"},{"level":2,"text":"Phase G"},{"level":3,"text":"Exploration"},{"level":2,"text":"Phase H"},{"level":3,"text":"Boss Prototype"},{"level":2,"text":"Phase I"},{"level":3,"text":"Progression & UI"},{"level":2,"text":"Phase J"},{"level":3,"text":"Narrative"},{"level":2,"text":"Phase K"},{"level":3,"text":"Art Pass"},{"level":1,"text":"54. Definition of Minimum Viable Vertical Slice"},{"level":3,"text":"3 playable characters"},{"level":3,"text":"3 elements"},{"level":3,"text":"2 reactions"},{"level":3,"text":"2 enemy families"},{"level":3,"text":"1 Elite"},{"level":3,"text":"1 Boss"},{"level":3,"text":"1 micro-region"},{"level":3,"text":"1 puzzle"},{"level":3,"text":"1 narrative reversal"},{"level":3,"text":"1 progression choice"},{"level":3,"text":"functional HUD"},{"level":3,"text":"20-ish minute complete flow"},{"level":1,"text":"55. Full Target Vertical Slice"},{"level":3,"text":"4 playable characters"},{"level":3,"text":"3–4 elements"},{"level":3,"text":"2–4 reactions"},{"level":3,"text":"2 enemy families + variants"},{"level":3,"text":"1 Elite"},{"level":3,"text":"Zalenquea Guardian"},{"level":3,"text":"5–8 POI"},{"level":3,"text":"1–2 puzzles"},{"level":3,"text":"1 meaningful optional secret"},{"level":3,"text":"limited progression"},{"level":3,"text":"environmental narrative"},{"level":3,"text":"short narrative arc"},{"level":3,"text":"20–30 minutes"},{"level":3,"text":"Status"},{"level":1,"text":"56. Key Reviewer Promises"},{"level":2,"text":"Promise 1"},{"level":2,"text":"Promise 2"},{"level":2,"text":"Promise 3"},{"level":2,"text":"Promise 4"},{"level":2,"text":"Promise 5"},{"level":2,"text":"Promise 6"},{"level":1,"text":"57. Public vs Internal"},{"level":1,"text":"INTERNAL"},{"level":2,"text":"Public derivatives"}],"blocks":[{"type":"p","text":"SYMPHONY OF JUSTICE"},{"type":"p","text":"Feature and Content Matrix"},{"type":"p","text":"Internal codename: Symphonia Iustitiae"},{"type":"table","table":0},{"type":"h1","text":"1. Purpose"},{"type":"p","text":"The Feature and Content Matrix serves as the primary scope-control mechanism for the Symphony of Justice Vertical Slice."},{"type":"p","text":"Its purpose is to connect each feature or content item with:"},{"type":"p","text":"the design pillar it demonstrates;"},{"type":"p","text":"its importance within the Vertical Slice;"},{"type":"p","text":"dependency;"},{"type":"p","text":"owner;"},{"type":"p","text":"implementation status;"},{"type":"p","text":"required evidence;"},{"type":"p","text":"criteria for keeping or cutting it."},{"type":"p","text":"The document must prevent the Vertical Slice from expanding through interesting but unnecessary features."},{"type":"p","text":"The main question will be:"},{"type":"p","text":"What does this feature demonstrate about Symphony of Justice?"},{"type":"p","text":"If a feature cannot clearly answer that question, it should be:"},{"type":"p","text":"justified;"},{"type":"p","text":"reduced;"},{"type":"p","text":"deferred;"},{"type":"p","text":"or removed."},{"type":"h1","text":"2. Scope Priority"},{"type":"p","text":"We will use four levels."},{"type":"h2","text":"MUST"},{"type":"p","text":"The experience cannot adequately represent the project without this feature."},{"type":"p","text":"It must exist in the final Vertical Slice build."},{"type":"h2","text":"SHOULD"},{"type":"p","text":"Clearly improves the experience or presentation."},{"type":"p","text":"It should be implemented if possible, but may be simplified if it threatens:"},{"type":"p","text":"schedule;"},{"type":"p","text":"stability;"},{"type":"p","text":"quality."},{"type":"h2","text":"COULD"},{"type":"p","text":"Optional feature."},{"type":"p","text":"It is developed only after all MUST items are:"},{"type":"p","text":"functional;"},{"type":"p","text":"integrated;"},{"type":"p","text":"reasonably polished."},{"type":"h2","text":"CUT / OUT"},{"type":"p","text":"Does not belong in the current Vertical Slice."},{"type":"p","text":"It may be part of the full product."},{"type":"h1","text":"3. Cut Rule"},{"type":"p","text":"The main rule will be:"},{"type":"p","text":"If a feature does not demonstrate a pillar, a gameplay promise, or a presentation need, it may be removed from the Vertical Slice."},{"type":"p","text":"It may also be cut if it:"},{"type":"p","text":"requires too much infrastructure;"},{"type":"p","text":"duplicates another feature;"},{"type":"p","text":"creates disproportionate technical debt;"},{"type":"p","text":"requires content we cannot produce;"},{"type":"p","text":"introduces a system that cannot be demonstrated properly;"},{"type":"p","text":"reduces overall quality in pursuit of quantity."},{"type":"h1","text":"4. Pillars Used by the Matrix"},{"type":"p","text":"The matrix will use the pillars defined in Game Design."},{"type":"h2","text":"P1"},{"type":"h3","text":"Characters with Gameplay Identity"},{"type":"p","text":"Characters must feel different both mechanically and narratively."},{"type":"h2","text":"P2"},{"type":"h3","text":"Strategy, Synergy & Adaptation"},{"type":"p","text":"The player must understand:"},{"type":"p","text":"composition;"},{"type":"p","text":"abilities;"},{"type":"p","text":"elements;"},{"type":"p","text":"reactions;"},{"type":"p","text":"threats."},{"type":"p","text":"Strategic satisfaction is an explicit part of the Game Vision."},{"type":"h2","text":"P3"},{"type":"h3","text":"Exploration, Discovery & Progression"},{"type":"p","text":"The world must reward:"},{"type":"p","text":"curiosity;"},{"type":"p","text":"detours;"},{"type":"p","text":"observation;"},{"type":"p","text":"discovery."},{"type":"p","text":"Historical documentation already envisioned exploration missions as mechanisms for discovering the world, its origins, and past events."},{"type":"h2","text":"P4"},{"type":"h3","text":"World, Narrative & Perspectives"},{"type":"p","text":"The player should perceive:"},{"type":"p","text":"a world with history;"},{"type":"p","text":"cultures;"},{"type":"p","text":"conflicting versions of events;"},{"type":"p","text":"characters with motivations of their own."},{"type":"p","text":"The Game Vision establishes the goal that the player should finish with new questions and remember that the world is built around different interpretations of what is just."},{"type":"h1","text":"5. Evidence Types"},{"type":"p","text":"A feature is not DONE simply because it exists in a document."},{"type":"p","text":"It may require one or more of these types of evidence:"},{"type":"table","table":1},{"type":"h1","text":"6. Production Status"},{"type":"p","text":"Each entry may use:"},{"type":"p","text":"TEMPLATE"},{"type":"p","text":"DRAFT"},{"type":"p","text":"APPROVED"},{"type":"p","text":"IMPLEMENTING"},{"type":"p","text":"PLAYABLE"},{"type":"p","text":"VALIDATED"},{"type":"p","text":"BLOCKED"},{"type":"p","text":"CUT"},{"type":"p","text":"DONE"},{"type":"h1","text":"7. Feature Matrix"},{"type":"h2","text":"Player Foundation"},{"type":"table","table":2},{"type":"h1","text":"8. Movement Scope"},{"type":"h2","text":"MUST"},{"type":"p","text":"walk/run;"},{"type":"p","text":"camera;"},{"type":"p","text":"sprint;"},{"type":"p","text":"dodge;"},{"type":"p","text":"contextual interaction."},{"type":"h2","text":"SHOULD"},{"type":"p","text":"jump."},{"type":"h2","text":"COULD"},{"type":"p","text":"ledge/vault;"},{"type":"p","text":"limited climb."},{"type":"h2","text":"CUT"},{"type":"p","text":"parkour system;"},{"type":"p","text":"mounts;"},{"type":"p","text":"swimming system;"},{"type":"p","text":"gliding;"},{"type":"p","text":"grappling;"},{"type":"p","text":"advanced traversal trees."},{"type":"p","text":"These may belong in the future product, but they do not prove the current core experience."},{"type":"h1","text":"9. Combat Matrix"},{"type":"table","table":3},{"type":"h1","text":"10. Important Combat Canon Correction"},{"type":"p","text":"The most recent historical documents still contain explicit references to turn-based combat. The existing Game Vision also retains an outdated phrase mentioning “turn-based combat” within the prototype objective."},{"type":"h3","text":"Current Decision"},{"type":"h1","text":"DEPRECATED"},{"type":"p","text":"The current Vertical Slice uses:"},{"type":"h1","text":"REAL-TIME ACTION RPG COMBAT"},{"type":"p","text":"Therefore:"},{"type":"p","text":"turn order;"},{"type":"p","text":"initiative;"},{"type":"p","text":"turn phases;"},{"type":"p","text":"double-turn mechanics;"},{"type":"p","text":"are not part of this matrix."},{"type":"p","text":"Reusable concepts from older versions, such as:"},{"type":"p","text":"professions;"},{"type":"p","text":"roles;"},{"type":"p","text":"abilities;"},{"type":"p","text":"elements;"},{"type":"p","text":"talents;"},{"type":"p","text":"synergies;"},{"type":"p","text":"can be adapted to real-time combat. Historical sources already connected professions with exploration and the distinct functionality of individual characters."},{"type":"h1","text":"11. Character System Matrix"},{"type":"table","table":4},{"type":"h1","text":"12. Playable Roster Target"},{"type":"h3","text":"Current target"},{"type":"h1","text":"4 playable characters"},{"type":"p","text":"Not yet final."},{"type":"h2","text":"Minimum acceptable fallback"},{"type":"h1","text":"3 characters"},{"type":"p","text":"Only if each demonstrates a sufficiently different function."},{"type":"p","text":"If producing a fourth character compromises:"},{"type":"p","text":"animation;"},{"type":"p","text":"VFX;"},{"type":"p","text":"balance;"},{"type":"p","text":"polish;"},{"type":"p","text":"the fourth should be cut rather than shipping four weak kits."},{"type":"h1","text":"13. Roster Selection Criteria"},{"type":"p","text":"Each selected character must justify their inclusion."},{"type":"p","text":"The final group should collectively demonstrate:"},{"type":"p","text":"different roles;"},{"type":"p","text":"different elements;"},{"type":"p","text":"different ranges;"},{"type":"p","text":"different skill rhythms;"},{"type":"p","text":"at least one support/defensive function;"},{"type":"p","text":"elemental interaction;"},{"type":"p","text":"different visual silhouettes."},{"type":"h1","text":"14. Candidate Legacy Pool"},{"type":"p","text":"The historical documents already contain characters spanning many elements, professions and combat functions, such as Juro, Yuzuki, Suki, Rubeus, Luther, Izanagi, Lyna and Haruko."},{"type":"p","text":"Examples include:"},{"type":"p","text":"Juro: Chaos / Executioner / Fighter;"},{"type":"p","text":"Yuzuki: Electro / Inventor / Explosive Fighter;"},{"type":"p","text":"Suki: Cryo / Vigilante / Debuffer;"},{"type":"p","text":"Rubeus: Pyro / Blacksmith / Tank;"},{"type":"p","text":"Luther: Hydro / Professor / Guardian;"},{"type":"p","text":"Izanagi: Anemo / Mage / Strategist;"},{"type":"p","text":"Lyna: Pyro / Chef / Healer;"},{"type":"p","text":"Haruko: Geo / Guardian."},{"type":"h3","text":"Status"},{"type":"h1","text":"SOURCE POOL"},{"type":"p","text":"This does not mean they are the four characters selected for the Vertical Slice."},{"type":"p","text":"Final selection remains:"},{"type":"p","text":"."},{"type":"h1","text":"15. Element System Matrix"},{"type":"table","table":5},{"type":"h1","text":"16. Vertical Slice Element Scope"},{"type":"p","text":"Recommended:"},{"type":"h1","text":"3–4 elements"},{"type":"p","text":"Enough to demonstrate:"},{"type":"p","text":"application;"},{"type":"p","text":"combination;"},{"type":"p","text":"team composition."},{"type":"p","text":"Not enough to require implementing the complete elemental ecosystem."},{"type":"h1","text":"Reaction Target"},{"type":"h1","text":"2–4 reactions"},{"type":"h3","text":"MUST"},{"type":"p","text":"At least:"},{"type":"p","text":"one damage-oriented reaction;"},{"type":"p","text":"one tactical/control/terrain-oriented reaction."},{"type":"p","text":"This allows the reviewer to understand that reactions are not merely:"},{"type":"p","text":"“different colors produce larger damage numbers.”"},{"type":"h1","text":"17. Pure Powers"},{"type":"p","text":"Current Game Design includes concepts such as:"},{"type":"p","text":"Chaos;"},{"type":"p","text":"Illumination;"},{"type":"p","text":"Spectrum;"},{"type":"p","text":"Seals;"},{"type":"p","text":"Time Clock."},{"type":"p","text":"Historical material also describes systems such as Seals and Time Clock."},{"type":"h3","text":"Vertical Slice"},{"type":"h1","text":"COULD / SELECTIVE"},{"type":"p","text":"At most one should be present if a selected character requires it."},{"type":"p","text":"We should not implement the entire Pure Power taxonomy merely to demonstrate that it exists."},{"type":"h1","text":"18. Reaction Implementation Rule"},{"type":"p","text":"The Vertical Slice does NOT need:"},{"type":"p","text":"every combination;"},{"type":"p","text":"every stack rule;"},{"type":"p","text":"every resistance interaction;"},{"type":"p","text":"full elemental balancing."},{"type":"p","text":"It DOES need:"},{"type":"p","text":"reliable activation;"},{"type":"p","text":"readable feedback;"},{"type":"p","text":"clear strategic value."},{"type":"h1","text":"19. Enemy AI Matrix"},{"type":"table","table":6},{"type":"h1","text":"20. Enemy Content Target"},{"type":"h2","text":"MUST"},{"type":"h3","text":"Enemy Family A"},{"type":"p","text":"Simple melee / teaching enemy."},{"type":"h3","text":"Enemy Family B"},{"type":"p","text":"Different pressure profile."},{"type":"p","text":"Could be:"},{"type":"p","text":"ranged;"},{"type":"p","text":"area denial;"},{"type":"p","text":"mobile."},{"type":"h3","text":"Elite"},{"type":"p","text":"One stronger enemy combining existing lessons."},{"type":"h3","text":"Boss"},{"type":"p","text":"Zalenquea or replacement approved through scope review."},{"type":"h1","text":"21. Historical Enemy Pool"},{"type":"p","text":"Original Material contains potential enemies such as:"},{"type":"p","text":"Hungry Skeletons;"},{"type":"p","text":"Timeless Puppets;"},{"type":"p","text":"Slime;"},{"type":"p","text":"Flora;"},{"type":"p","text":"Dragons;"},{"type":"p","text":"Fungus Family;"},{"type":"p","text":"Tanukis;"},{"type":"p","text":"alchemical creatures;"},{"type":"p","text":"various sub-bosses."},{"type":"h3","text":"Important"},{"type":"p","text":"These are:"},{"type":"h1","text":"LEGACY SOURCE OPTIONS"},{"type":"p","text":"not automatic Vertical Slice commitments."},{"type":"p","text":"The final two enemy families should be selected based on:"},{"type":"p","text":"region;"},{"type":"p","text":"visual production cost;"},{"type":"p","text":"gameplay readability;"},{"type":"p","text":"elemental interactions;"},{"type":"p","text":"animation reuse potential."},{"type":"h1","text":"22. Boss Matrix"},{"type":"h2","text":"Current Candidate"},{"type":"h1","text":"Zalenquea Guardian"},{"type":"p","text":"Historical material already lists Zalenquea Guardian as the Earth/Terra Evolution Boss."},{"type":"h3","text":"Current Vertical Slice State"},{"type":"h1","text":"PROTOTYPE"},{"type":"table","table":7},{"type":"h1","text":"23. Boss Evidence Required"},{"type":"p","text":"Zalenquea cannot be marked DONE until there is:"},{"type":"p","text":"BLD: complete playable fight;"},{"type":"p","text":"VID: full fight capture;"},{"type":"p","text":"PT: external player can understand core mechanic;"},{"type":"p","text":"QA: no progression blocker;"},{"type":"p","text":"ART: sufficient final visual quality;"},{"type":"p","text":"AUDIO: telegraphs readable;"},{"type":"p","text":"PERF: acceptable performance."},{"type":"h1","text":"24. Exploration Matrix"},{"type":"table","table":8},{"type":"h1","text":"25. Environment Content Matrix"},{"type":"h2","text":"MUST"},{"type":"p","text":"entry area;"},{"type":"p","text":"safe/introduction zone;"},{"type":"p","text":"exploration route;"},{"type":"p","text":"combat arena;"},{"type":"p","text":"optional route;"},{"type":"p","text":"narrative POI;"},{"type":"p","text":"preparation space;"},{"type":"p","text":"Boss arena."},{"type":"h2","text":"SHOULD"},{"type":"p","text":"one memorable landmark;"},{"type":"p","text":"one optional secret;"},{"type":"p","text":"one environmental puzzle;"},{"type":"p","text":"one element-based interaction;"},{"type":"p","text":"one vista."},{"type":"h2","text":"COULD"},{"type":"p","text":"secondary interior;"},{"type":"p","text":"small hidden chamber;"},{"type":"p","text":"alternate traversal path."},{"type":"h1","text":"26. Puzzle Matrix"},{"type":"table","table":9},{"type":"h1","text":"27. Puzzle Rule"},{"type":"p","text":"The puzzle must prove:"},{"type":"p","text":"exploration uses the same systems the player learns in combat."},{"type":"p","text":"It should not exist purely to add puzzle content."},{"type":"h1","text":"28. Narrative Matrix"},{"type":"table","table":10},{"type":"h1","text":"29. Narrative Asset Target"},{"type":"h3","text":"MUST"},{"type":"p","text":"intro context;"},{"type":"p","text":"objective text;"},{"type":"p","text":"key dialogue;"},{"type":"p","text":"environmental clues;"},{"type":"p","text":"narrative reveal;"},{"type":"p","text":"Boss context;"},{"type":"p","text":"closing scene/hook."},{"type":"h2","text":"SHOULD"},{"type":"p","text":"party banter;"},{"type":"p","text":"optional Codex;"},{"type":"p","text":"optional readable note;"},{"type":"p","text":"short cinematic."},{"type":"h1","text":"30. Cinematic Matrix"},{"type":"table","table":11},{"type":"p","text":"The demo should remain gameplay-first."},{"type":"h1","text":"31. Progression Matrix"},{"type":"table","table":12},{"type":"h1","text":"32. Progression Proof"},{"type":"p","text":"The player must experience at least once:"},{"type":"p","text":"Example:"},{"type":"p","text":"exploration reward;"},{"type":"p","text":"upgrade;"},{"type":"p","text":"stronger encounter;"},{"type":"p","text":"visible usefulness."},{"type":"p","text":"This demonstrates progression without implementing the entire RPG economy."},{"type":"h1","text":"33. Equipment Matrix"},{"type":"h2","text":"SHOULD"},{"type":"p","text":"One simplified equipment slot or weapon upgrade can exist."},{"type":"h2","text":"CUT"},{"type":"p","text":"complete 5-artifact system;"},{"type":"p","text":"set farming;"},{"type":"p","text":"random substats;"},{"type":"p","text":"weapon refinement;"},{"type":"p","text":"complete inventory economy;"},{"type":"p","text":"Last Wills."},{"type":"p","text":"The Vertical Slice does not need to prove loot longevity."},{"type":"p","text":"It needs to prove:"},{"type":"p","text":"the combat feels worth building around."},{"type":"h1","text":"34. Acquisition & Gacha Matrix"},{"type":"table","table":13},{"type":"p","text":"The long-term Game Vision reserves full Gacha, premium economy and commercial infrastructure for later stages."},{"type":"h1","text":"35. UI Matrix"},{"type":"table","table":14},{"type":"h1","text":"36. UI Principle"},{"type":"p","text":"Every visible UI element must answer:"},{"type":"p","text":"What decision does this information help the player make?"},{"type":"p","text":"If it does not:"},{"type":"p","text":"remove it;"},{"type":"p","text":"simplify it;"},{"type":"p","text":"or move it outside combat."},{"type":"h1","text":"37. VFX Matrix"},{"type":"h2","text":"MUST"},{"type":"p","text":"normal attack feedback;"},{"type":"p","text":"Skill VFX;"},{"type":"p","text":"Ultimate VFX;"},{"type":"p","text":"selected elemental VFX;"},{"type":"p","text":"selected reaction VFX;"},{"type":"p","text":"hit feedback;"},{"type":"p","text":"dodge feedback;"},{"type":"p","text":"enemy telegraphs;"},{"type":"p","text":"Boss telegraphs;"},{"type":"p","text":"break/vulnerability feedback."},{"type":"h2","text":"SHOULD"},{"type":"p","text":"environment element effects;"},{"type":"p","text":"pickup VFX;"},{"type":"p","text":"progression VFX;"},{"type":"p","text":"character swap transition."},{"type":"h2","text":"CUT"},{"type":"p","text":"every element;"},{"type":"p","text":"every reaction;"},{"type":"p","text":"full skin/cosmetic system;"},{"type":"p","text":"massive cinematic Ultimate for every character if cost is excessive."},{"type":"h1","text":"38. Animation Matrix"},{"type":"table","table":15},{"type":"h1","text":"39. Audio Matrix"},{"type":"table","table":16},{"type":"p","text":"The existing Game Vision already notes that a Vertical Slice does not initially require full voice acting in multiple languages."},{"type":"h1","text":"40. Content Matrix"},{"type":"h2","text":"Characters"},{"type":"table","table":17},{"type":"h1","text":"41. Content Matrix"},{"type":"h2","text":"Enemies"},{"type":"table","table":18},{"type":"h1","text":"42. Content Matrix"},{"type":"h2","text":"Environment"},{"type":"table","table":19},{"type":"h1","text":"43. Props Matrix"},{"type":"h2","text":"MUST"},{"type":"p","text":"interactive object;"},{"type":"p","text":"pickups;"},{"type":"p","text":"environmental storytelling props;"},{"type":"p","text":"Boss arena assets;"},{"type":"p","text":"region-specific props."},{"type":"h2","text":"SHOULD"},{"type":"p","text":"destructible small prop;"},{"type":"p","text":"readable lore object;"},{"type":"p","text":"resource node;"},{"type":"p","text":"landmark props."},{"type":"h2","text":"CUT"},{"type":"p","text":"complete furnishing library;"},{"type":"p","text":"housing props;"},{"type":"p","text":"hundreds of crafting resources."},{"type":"h1","text":"44. Narrative Content Matrix"},{"type":"table","table":20},{"type":"h1","text":"45. Performance / Technical Features"},{"type":"table","table":21},{"type":"h1","text":"46. Unreal Engine System Matrix"},{"type":"p","text":"Potential technical modules:"},{"type":"table","table":22},{"type":"p","text":"Whether these use:"},{"type":"p","text":"Gameplay Ability System;"},{"type":"p","text":"Blueprint systems;"},{"type":"p","text":"C++;"},{"type":"p","text":"hybrid architecture;"},{"type":"p","text":"belongs to Technical Plan."},{"type":"h1","text":"47. Accessibility Matrix"},{"type":"h2","text":"MUST"},{"type":"p","text":"subtitles;"},{"type":"p","text":"readable text;"},{"type":"p","text":"rebind consideration or standard input support;"},{"type":"p","text":"mouse sensitivity;"},{"type":"p","text":"volume controls;"},{"type":"p","text":"graphics controls;"},{"type":"p","text":"telegraphs using more than color alone."},{"type":"h2","text":"SHOULD"},{"type":"p","text":"subtitle size;"},{"type":"p","text":"camera shake toggle;"},{"type":"p","text":"motion blur toggle;"},{"type":"p","text":"damage number toggle;"},{"type":"p","text":"aim/lock assistance if needed."},{"type":"h1","text":"48. Feature Validation Rule"},{"type":"p","text":"A MUST feature should pass:"},{"type":"h2","text":"Functional"},{"type":"p","text":"Does it work?"},{"type":"h2","text":"Readable"},{"type":"p","text":"Can a new player understand it?"},{"type":"h2","text":"Useful"},{"type":"p","text":"Does it affect a decision?"},{"type":"h2","text":"Integrated"},{"type":"p","text":"Does it interact with other systems?"},{"type":"h2","text":"Representative"},{"type":"p","text":"Does it resemble the intended final game?"},{"type":"h2","text":"Evidenced"},{"type":"p","text":"Can we prove it exists?"},{"type":"h1","text":"49. Cut Decision Framework"},{"type":"p","text":"When production pressure appears, cut in this order:"},{"type":"h3","text":"1. COULD"},{"type":"p","text":"Cut freely."},{"type":"h3","text":"2. SHOULD with low pillar value"},{"type":"p","text":"Cut next."},{"type":"h3","text":"3. Content quantity"},{"type":"p","text":"Reduce:"},{"type":"p","text":"characters;"},{"type":"p","text":"POI;"},{"type":"p","text":"enemy variants;"},{"type":"p","text":"animations."},{"type":"h3","text":"4. Visual complexity"},{"type":"p","text":"Simplify without losing identity."},{"type":"h3","text":"5. NEVER cut a core promise casually"},{"type":"p","text":"Avoid removing:"},{"type":"p","text":"real-time combat;"},{"type":"p","text":"character identity;"},{"type":"p","text":"elements/reactions;"},{"type":"p","text":"exploration;"},{"type":"p","text":"Boss;"},{"type":"p","text":"basic narrative."},{"type":"p","text":"If we remove those, we are no longer demonstrating Symphony of Justice."},{"type":"h1","text":"50. Quality Before Quantity Rule"},{"type":"p","text":"Suppose we have a choice between:"},{"type":"h3","text":"Option A"},{"type":"p","text":"4 characters at 60% quality."},{"type":"h3","text":"Option B"},{"type":"p","text":"3 characters at 90% quality."},{"type":"p","text":"For the Vertical Slice:"},{"type":"h1","text":"Choose B."},{"type":"p","text":"Likewise:"},{"type":"p","text":"1 memorable Boss > 3 mediocre Bosses."},{"type":"p","text":"1 beautiful micro-region > 4 unfinished biomes."},{"type":"p","text":"3 readable reactions > 21 confusing reactions."},{"type":"p","text":"This should be one of the governing principles of the matrix."},{"type":"h1","text":"51. Feature Freeze"},{"type":"p","text":"At a future milestone, the matrix should enter:"},{"type":"h1","text":"FEATURE FREEZE"},{"type":"p","text":"From that point:"},{"type":"p","text":"No new feature enters unless:"},{"type":"p","text":"fixes a critical problem;"},{"type":"p","text":"replaces a failed feature;"},{"type":"p","text":"is required for submission/build stability."},{"type":"p","text":"Everything else moves to:"},{"type":"p","text":"Post-Slice Backlog."},{"type":"h1","text":"52. Current Feature Freeze State"},{"type":"h1","text":"NOT ACTIVE"},{"type":"p","text":"We are still in design/preproduction."},{"type":"h1","text":"53. Recommended Implementation Order"},{"type":"h2","text":"Phase A"},{"type":"h3","text":"Player Fundamentals"},{"type":"p","text":"movement;"},{"type":"p","text":"camera;"},{"type":"p","text":"dodge;"},{"type":"p","text":"basic attack;"},{"type":"p","text":"health/damage."},{"type":"h2","text":"Phase B"},{"type":"h3","text":"Ability Combat"},{"type":"p","text":"Skill;"},{"type":"p","text":"cooldown;"},{"type":"p","text":"resource;"},{"type":"p","text":"Ultimate."},{"type":"h2","text":"Phase C"},{"type":"h3","text":"Character Identity"},{"type":"p","text":"second character;"},{"type":"p","text":"Swap;"},{"type":"p","text":"different kit;"},{"type":"p","text":"role distinction."},{"type":"h2","text":"Phase D"},{"type":"h3","text":"Elemental Core"},{"type":"p","text":"aura;"},{"type":"p","text":"second element;"},{"type":"p","text":"first reaction;"},{"type":"p","text":"feedback."},{"type":"h2","text":"Phase E"},{"type":"h3","text":"Enemy Foundation"},{"type":"p","text":"first enemy;"},{"type":"p","text":"telegraph;"},{"type":"p","text":"damage;"},{"type":"p","text":"death;"},{"type":"p","text":"reaction."},{"type":"h2","text":"Phase F"},{"type":"h3","text":"Combat Loop Prototype"},{"type":"p","text":"3-character or provisional party;"},{"type":"p","text":"first real encounter;"},{"type":"p","text":"reaction;"},{"type":"p","text":"Elite."},{"type":"h2","text":"Phase G"},{"type":"h3","text":"Exploration"},{"type":"p","text":"greybox region;"},{"type":"p","text":"POI;"},{"type":"p","text":"interaction;"},{"type":"p","text":"reward;"},{"type":"p","text":"puzzle."},{"type":"h2","text":"Phase H"},{"type":"h3","text":"Boss Prototype"},{"type":"p","text":"Zalenquea;"},{"type":"p","text":"Phase 1;"},{"type":"p","text":"break;"},{"type":"p","text":"Phase 2."},{"type":"h2","text":"Phase I"},{"type":"h3","text":"Progression & UI"},{"type":"p","text":"reward;"},{"type":"p","text":"upgrade;"},{"type":"p","text":"menus;"},{"type":"p","text":"feedback."},{"type":"h2","text":"Phase J"},{"type":"h3","text":"Narrative"},{"type":"p","text":"local context;"},{"type":"p","text":"dialogue;"},{"type":"p","text":"reveal;"},{"type":"p","text":"closing hook."},{"type":"h2","text":"Phase K"},{"type":"h3","text":"Art Pass"},{"type":"p","text":"Only once the gameplay works."},{"type":"p","text":"This ordering matches the existing Game Vision's distinction between validating the Core Gameplay Prototype before investing heavily in Vertical Slice presentation."},{"type":"h1","text":"54. Definition of Minimum Viable Vertical Slice"},{"type":"p","text":"If production became heavily constrained, the smallest version I would still consider representative would be:"},{"type":"h3","text":"3 playable characters"},{"type":"h3","text":"3 elements"},{"type":"h3","text":"2 reactions"},{"type":"h3","text":"2 enemy families"},{"type":"h3","text":"1 Elite"},{"type":"h3","text":"1 Boss"},{"type":"h3","text":"1 micro-region"},{"type":"h3","text":"1 puzzle"},{"type":"h3","text":"1 narrative reversal"},{"type":"h3","text":"1 progression choice"},{"type":"h3","text":"functional HUD"},{"type":"h3","text":"20-ish minute complete flow"},{"type":"p","text":"Everything beyond that is negotiable."},{"type":"p","text":"Everything below that begins to risk demonstrating only:"},{"type":"p","text":"“a combat prototype”"},{"type":"p","text":"rather than:"},{"type":"p","text":"a Vertical Slice of Symphony of Justice."},{"type":"h1","text":"55. Full Target Vertical Slice"},{"type":"p","text":"The preferred version remains:"},{"type":"h3","text":"4 playable characters"},{"type":"h3","text":"3–4 elements"},{"type":"h3","text":"2–4 reactions"},{"type":"h3","text":"2 enemy families + variants"},{"type":"h3","text":"1 Elite"},{"type":"h3","text":"Zalenquea Guardian"},{"type":"h3","text":"5–8 POI"},{"type":"h3","text":"1–2 puzzles"},{"type":"h3","text":"1 meaningful optional secret"},{"type":"h3","text":"limited progression"},{"type":"h3","text":"environmental narrative"},{"type":"h3","text":"short narrative arc"},{"type":"h3","text":"20–30 minutes"},{"type":"h3","text":"Status"},{"type":"p","text":"PROTOTYPE TARGET."},{"type":"h1","text":"56. Key Reviewer Promises"},{"type":"p","text":"A reviewer should be able to verify these six promises directly from footage/build:"},{"type":"h2","text":"Promise 1"},{"type":"p","text":"Characters play differently."},{"type":"p","text":"Evidence:\n character switching + kit differences."},{"type":"h2","text":"Promise 2"},{"type":"p","text":"Elements create tactical interactions."},{"type":"p","text":"Evidence:\n at least two clear reactions."},{"type":"h2","text":"Promise 3"},{"type":"p","text":"Combat rewards understanding."},{"type":"p","text":"Evidence:\n enemy telegraphs, reaction choice, Boss windows."},{"type":"h2","text":"Promise 4"},{"type":"p","text":"Exploration matters."},{"type":"p","text":"Evidence:\n optional POI/reward/puzzle."},{"type":"h2","text":"Promise 5"},{"type":"p","text":"The world has identity."},{"type":"p","text":"Evidence:\n environment, narrative clues, art direction."},{"type":"h2","text":"Promise 6"},{"type":"p","text":"There is something larger behind the demo."},{"type":"p","text":"Evidence:\n closing narrative hook."},{"type":"h1","text":"57. Public vs Internal"},{"type":"p","text":"This document itself should remain:"},{"type":"h1","text":"INTERNAL"},{"type":"p","text":"Because it contains:"},{"type":"p","text":"cuts;"},{"type":"p","text":"priorities;"},{"type":"p","text":"incomplete systems;"},{"type":"p","text":"implementation status;"},{"type":"p","text":"scope compromises."},{"type":"h2","text":"Public derivatives"},{"type":"p","text":"Can extract:"},{"type":"p","text":"feature overview;"},{"type":"p","text":"gameplay pillars;"},{"type":"p","text":"“Vertical Slice includes” summary."},{"type":"p","text":"But NOT:"},{"type":"p","text":"cut list;"},{"type":"p","text":"missing functionality;"},{"type":"p","text":"internal risk;"},{"type":"p","text":"scope fallback."}],"tables":[[["Folder","Vertical Slice","Status","TEMPLATE"],["Version","0.1.0","Last Updated","2026-08-16"]],[["Code","Evidence"],["BLD","Works in an executable build"],["VID","Gameplay video"],["SCR","Screenshot"],["PT","Playtest"],["DOC","Approved document"],["PERF","Performance evidence"],["QA","Approved test case"],["ART","Final or sufficiently representative asset"]],[["Feature","Pillar","Priority","Dependency","Current Status","Required Evidence"],["Boot / Launch","Presentation","MUST","UE5 project","NOT STARTED","BLD"],["Main Menu","Presentation","MUST","UI","NOT STARTED","BLD / SCR"],["Settings","Accessibility","MUST minimal","UI / Tech","NOT STARTED","BLD"],["Character Movement","P3","MUST","Controller","NOT 