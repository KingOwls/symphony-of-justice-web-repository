{"id":"game-13-social-and-multiplayer","group":"game","groupLabel":"Game Design","number":"13","title":"Social and Multiplayer","summary":"Frames cooperative and social systems, communication, boundaries and the conditions under which online features support rather than replace the RPG.","sourceFile":"Game Design/13 - Social and Multiplayer.docx","meta":{"status":"DRAFT","version":"0.15.7","owner":"J. Crow","last_updated":"08/20/2026"},"headings":[{"level":1,"text":"1. Social Vision"},{"level":2,"text":"Development"},{"level":2,"text":"Social Fantasy"},{"level":2,"text":"What It Offers the Player"},{"level":3,"text":"Cooperation"},{"level":3,"text":"Expression"},{"level":3,"text":"Community"},{"level":3,"text":"Celebration"},{"level":3,"text":"Challenge"},{"level":2,"text":"Main Rule"},{"level":1,"text":"2. Friends and Groups"},{"level":2,"text":"Development"},{"level":1,"text":"Friends List"},{"level":2,"text":"Available Actions"},{"level":3,"text":"Invite to Party"},{"level":3,"text":"Join Request"},{"level":3,"text":"Message"},{"level":3,"text":"Visit"},{"level":3,"text":"Block"},{"level":3,"text":"Remove Friend"},{"level":1,"text":"Presence Status"},{"level":1,"text":"Invitations"},{"level":3,"text":"Anyone"},{"level":3,"text":"Friends Only"},{"level":3,"text":"Invite Only"},{"level":3,"text":"Nobody"},{"level":1,"text":"Temporary Party"},{"level":1,"text":"Size"},{"level":1,"text":"4 players"},{"level":3,"text":"Solo"},{"level":3,"text":"2 Players"},{"level":3,"text":"3 Players"},{"level":3,"text":"4 Players"},{"level":1,"text":"Group Leader"},{"level":1,"text":"Guilds"},{"level":3,"text":"Adventurers' Guild"},{"level":3,"text":"Adventurers' Guild"},{"level":3,"text":"Player Guilds"},{"level":2,"text":"Player Guilds"},{"level":1,"text":"3. Co-op"},{"level":2,"text":"Development"},{"level":1,"text":"Compatible Activities"},{"level":2,"text":"Exploration"},{"level":1,"text":"Bosses"},{"level":1,"text":"Dungeons"},{"level":1,"text":"Weekly Activities"},{"level":1,"text":"Events"},{"level":1,"text":"What Does NOT Require Cooperation"},{"level":1,"text":"Cooperative Gameplay"},{"level":3,"text":"Player A"},{"level":3,"text":"Player B"},{"level":3,"text":"Electrified Zone"},{"level":1,"text":"Synergies"},{"level":1,"text":"Rewards"},{"level":1,"text":"Personal Loot"},{"level":1,"text":"World Resources"},{"level":1,"text":"Chests"},{"level":1,"text":"Host and Guest Progress"},{"level":3,"text":"Host"},{"level":3,"text":"Guest"},{"level":1,"text":"Matchmaking"},{"level":1,"text":"Difficulty"},{"level":1,"text":"4. Social Hub"},{"level":2,"text":"Development"},{"level":1,"text":"Kingdomless Island"},{"level":1,"text":"Main Function"},{"level":1,"text":"First Arrival"},{"level":1,"text":"Central Plaza"},{"level":1,"text":"Training Area"},{"level":1,"text":"Housing"},{"level":3,"text":"Personal Residence"},{"level":1,"text":"Marketplace"},{"level":2,"text":"Proposed Safe Trading"},{"level":1,"text":"Non-Combat Activities"},{"level":1,"text":"Ruins"},{"level":1,"text":"5. Competitive"},{"level":2,"text":"Development"},{"level":1,"text":"Battle in an Isolated Zone (Competitive)"},{"level":1,"text":"Objective"},{"level":1,"text":"Proposed Main Format"},{"level":2,"text":"Arena Duel"},{"level":3,"text":"1 player vs. 1 player"},{"level":3,"text":"Isolated Zone"},{"level":1,"text":"Team"},{"level":3,"text":"4 characters"},{"level":1,"text":"Duration"},{"level":3,"text":"3–7 minutes"},{"level":1,"text":"Fair Play Rules"},{"level":1,"text":"Ranked uses normalized statistics."},{"level":3,"text":"Legacy Bonuses"},{"level":2,"text":"Why?"},{"level":1,"text":"Unranked"},{"level":1,"text":"Ranked"},{"level":1,"text":"Ranking"},{"level":3,"text":"internal MMR"},{"level":1,"text":"Seasons"},{"level":3,"text":"Rewards"},{"level":1,"text":"PvE Leaderboards"},{"level":1,"text":"6. Safety and Moderation"},{"level":1,"text":"Chat"},{"level":3,"text":"Party Chat"},{"level":3,"text":"Friends Chat"},{"level":3,"text":"Guild Chat"},{"level":3,"text":"Hub Chat"},{"level":1,"text":"Quick Chat"},{"level":1,"text":"Voice Chat"},{"level":1,"text":"Mute"},{"level":1,"text":"Block"},{"level":1,"text":"Report"},{"level":3,"text":"Harassment"},{"level":3,"text":"Hate / Abuse"},{"level":3,"text":"Sexual Content"},{"level":3,"text":"Threats"},{"level":3,"text":"Spam"},{"level":3,"text":"Scam / Fraud"},{"level":3,"text":"Cheating"},{"level":3,"text":"Inappropriate Name/Profile"},{"level":3,"text":"Exploit"},{"level":3,"text":"Other"},{"level":1,"text":"Evidence"},{"level":1,"text":"Moderation"},{"level":3,"text":"Automated"},{"level":3,"text":"Human"},{"level":1,"text":"Escalation"},{"level":1,"text":"Privacy"},{"level":1,"text":"Account Protection"},{"level":1,"text":"Trade Safety"},{"level":3,"text":"Double confirmation."},{"level":1,"text":"Conduct"},{"level":3,"text":"Community Code of Conduct"},{"level":1,"text":"Anti-Cheat"},{"level":1,"text":"7. Scope Control"},{"level":2,"text":"Development"},{"level":1,"text":"Vertical Slice"},{"level":2,"text":"What Should NOT Be Implemented"},{"level":1,"text":"What Can Be Shown"},{"level":3,"text":"Concept Art"},{"level":3,"text":"Greybox"},{"level":3,"text":"UI Mockup"},{"level":3,"text":"Roadmap"},{"level":3,"text":"Concept Video"},{"level":1,"text":"Backend Dependencies"},{"level":1,"text":"Recommended Architecture"},{"level":1,"text":"Services That Can Be Added Later"},{"level":3,"text":"Online Phase 1"},{"level":3,"text":"Online Phase 2"},{"level":3,"text":"Online Phase 3"},{"level":3,"text":"Online Phase 4"},{"level":3,"text":"Online Phase 5"},{"level":3,"text":"Online Phase 6"},{"level":1,"text":"Complete Social Layer Relationship"}],"blocks":[{"type":"p","text":"SYMPHONIA IUSTITIAE"},{"type":"title","text":"13 - Social and Multiplayer"},{"type":"p","text":"Social, Cooperative, and Competitive Features"},{"type":"table","table":0},{"type":"h1","text":"1. Social Vision"},{"type":"h2","text":"Development"},{"type":"p","text":"The social layer of Symphony of Justice exists to allow players to share part of their journey with others without turning the entire game into a mandatory multiplayer experience."},{"type":"p","text":"The core game will remain fully playable solo. The social feature should expand:"},{"type":"p","text":"COOPERATION → EXPRESSION → COMMUNITY → CHALLENGE → BELONGING"},{"type":"p","text":"and not replace:"},{"type":"p","text":"story → exploration → characters → combat."},{"type":"p","text":"The current Game Vision already positions friends, groups, cooperation, guilds, matchmaking, and community activities as a later stage of online expansion, not as a requirement for the main RPG to function."},{"type":"h2","text":"Social Fantasy"},{"type":"p","text":"Throughout the story, the protagonist travels through societies divided by different ideas of justice. The Kingdomless Island can serve as a counterpoint to those divisions:"},{"type":"p","text":"a territory where people from different nations can meet without immediately being defined by the borders of their clans."},{"type":"p","text":"This also gives the social system a narrative justification."},{"type":"p","text":"We do not simply want:"},{"type":"p","text":"“Here is the multiplayer lobby because we need a lobby.”"},{"type":"p","text":"We want:"},{"type":"p","text":"“This place exists within the world precisely because it represents freedom, connection, and neutrality.”"},{"type":"p","text":"The historical source already presents it as a nation independent of the major and minor clans, also connected to the ruins of the ancient Kingdom of Judgment and to important events of the past."},{"type":"h2","text":"What It Offers the Player"},{"type":"h3","text":"Cooperation"},{"type":"p","text":"Receive help with:"},{"type":"p","text":"Bosses;"},{"type":"p","text":"Dungeons;"},{"type":"p","text":"exploration;"},{"type":"p","text":"Hunts;"},{"type":"p","text":"special activities."},{"type":"p","text":"This connects directly with the Island's original conception as a place where players help others with progression and exploration."},{"type":"h3","text":"Expression"},{"type":"p","text":"Show:"},{"type":"p","text":"favorite characters;"},{"type":"p","text":"skins;"},{"type":"p","text":"profile;"},{"type":"p","text":"achievements;"},{"type":"p","text":"housing;"},{"type":"p","text":"decorations."},{"type":"h3","text":"Community"},{"type":"p","text":"Create persistent connections:"},{"type":"p","text":"friends;"},{"type":"p","text":"groups;"},{"type":"p","text":"organizations;"},{"type":"p","text":"communities."},{"type":"h3","text":"Celebration"},{"type":"p","text":"Events, festivals, activities, and spaces where players can be present without needing to fight constantly."},{"type":"h3","text":"Challenge"},{"type":"p","text":"Optional cooperative and competitive content."},{"type":"h2","text":"Main Rule"},{"type":"p","text":"Social features should add reasons to play with others, never punish those who prefer to play solo."},{"type":"p","text":"Therefore, the main story, essential exploration, and basic progression must remain completable without a party."},{"type":"h1","text":"2. Friends and Groups"},{"type":"h2","text":"Development"},{"type":"p","text":"I propose organizing it into three levels:"},{"type":"p","text":"FRIENDS → TEMPORARY PARTY → PERSISTENT COMMUNITY"},{"type":"h1","text":"Friends List"},{"type":"p","text":"Each account can maintain a friends list. A social profile should display only authorized information such as:"},{"type":"p","text":"display name;"},{"type":"p","text":"avatar;"},{"type":"p","text":"general level/rank;"},{"type":"p","text":"featured character;"},{"type":"p","text":"online status;"},{"type":"p","text":"last activity, if the user permits it;"},{"type":"p","text":"availability status."},{"type":"h2","text":"Available Actions"},{"type":"p","text":"From the list:"},{"type":"h3","text":"Invite to Party"},{"type":"p","text":"Invite."},{"type":"h3","text":"Join Request"},{"type":"p","text":"Request access to the world or activity."},{"type":"h3","text":"Message"},{"type":"p","text":"When chat is enabled."},{"type":"h3","text":"Visit"},{"type":"p","text":"Visit the Island/Housing if permission is granted."},{"type":"h3","text":"Block"},{"type":"p","text":"Block."},{"type":"h3","text":"Remove Friend"},{"type":"p","text":"Remove."},{"type":"h1","text":"Presence Status"},{"type":"p","text":"It may use:"},{"type":"p","text":"Online"},{"type":"p","text":"In Combat"},{"type":"p","text":"In Dungeon"},{"type":"p","text":"In Story"},{"type":"p","text":"In Social Hub"},{"type":"p","text":"Do Not Disturb"},{"type":"p","text":"Offline"},{"type":"p","text":"Players must be able to hide their presence."},{"type":"h1","text":"Invitations"},{"type":"p","text":"Users can configure:"},{"type":"h3","text":"Anyone"},{"type":"h3","text":"Friends Only"},{"type":"h3","text":"Invite Only"},{"type":"h3","text":"Nobody"},{"type":"p","text":"for:"},{"type":"p","text":"friend requests;"},{"type":"p","text":"world join;"},{"type":"p","text":"party;"},{"type":"p","text":"messages;"},{"type":"p","text":"housing."},{"type":"p","text":"This should be part of basic privacy settings."},{"type":"h1","text":"Temporary Party"},{"type":"p","text":"A temporary party is used for:"},{"type":"p","text":"exploration;"},{"type":"p","text":"Bosses;"},{"type":"p","text":"Dungeons;"},{"type":"p","text":"Hunts;"},{"type":"p","text":"events."},{"type":"p","text":"It is created through:"},{"type":"p","text":"invitation;"},{"type":"p","text":"matchmaking;"},{"type":"p","text":"Social Hub;"},{"type":"p","text":"friends list."},{"type":"h1","text":"Size"},{"type":"p","text":"I propose a maximum of:"},{"type":"h1","text":"4 players"},{"type":"p","text":"because it remains consistent with the base four-character team structure."},{"type":"p","text":"However, we need to determine how the four team slots are distributed when there are fewer than four human players."},{"type":"p","text":"One interesting proposal would be:"},{"type":"h3","text":"Solo"},{"type":"p","text":"1 player controls 4 characters."},{"type":"h3","text":"2 Players"},{"type":"p","text":"Each player contributes up to 2 characters."},{"type":"h3","text":"3 Players"},{"type":"p","text":"Two players contribute 1 character each, while one controls 2; the Host has the authority to make this assignment."},{"type":"h3","text":"4 Players"},{"type":"p","text":"Each player controls 1 character."},{"type":"p","text":"This preserves:"},{"type":"p","text":"a maximum of 4 active characters"},{"type":"p","text":"without multiplying a party of four players by four characters each and ending up with sixteen combatants overwhelming the battlefield."},{"type":"h1","text":"Group Leader"},{"type":"p","text":"One player acts as Host/Leader to:"},{"type":"p","text":"start activities;"},{"type":"p","text":"select a Dungeon;"},{"type":"p","text":"manage matchmaking;"},{"type":"p","text":"remove members;"},{"type":"p","text":"configure certain options."},{"type":"p","text":"However:"},{"type":"p","text":"Being the Host does not grant authority over inventories or rewards."},{"type":"p","text":"That belongs to the server."},{"type":"h1","text":"Guilds"},{"type":"p","text":"Here we must distinguish between two concepts. The documents explicitly mention an:"},{"type":"h3","text":"Adventurers' Guild"},{"type":"p","text":"as part of the world's activities."},{"type":"p","text":"However, the sources do not clearly establish that this Guild is a player-created clan system."},{"type":"p","text":"Therefore:"},{"type":"h3","text":"Adventurers' Guild"},{"type":"p","text":"World institution / mission system."},{"type":"h3","text":"Player Guilds"},{"type":"p","text":"A separate future social system."},{"type":"h2","text":"Player Guilds"},{"type":"p","text":"They could allow:"},{"type":"p","text":"name;"},{"type":"p","text":"emblem;"},{"type":"p","text":"description;"},{"type":"p","text":"members;"},{"type":"p","text":"rank;"},{"type":"p","text":"message board;"},{"type":"p","text":"activities;"},{"type":"p","text":"future Guild Hall;"},{"type":"p","text":"collective goals."},{"type":"p","text":"However, they should not provide significant power advantages. Their main benefit would be:"},{"type":"p","text":"organization + community + activities."},{"type":"p","text":"Thematic name to be determined: ???"},{"type":"p","text":"They could be called companies, adventuring companies, circles, etc., depending on later lore decisions."},{"type":"h1","text":"3. Co-op"},{"type":"h2","text":"Development"},{"type":"p","text":"Co-op should primarily use systems that are already fun in solo play. We do not want to design a completely different second version of the game exclusively for multiplayer."},{"type":"h1","text":"Compatible Activities"},{"type":"h2","text":"Exploration"},{"type":"p","text":"Players can travel together through:"},{"type":"p","text":"world;"},{"type":"p","text":"hostile areas;"},{"type":"p","text":"secrets;"},{"type":"p","text":"encounters;"},{"type":"p","text":"Hunts."},{"type":"h1","text":"Bosses"},{"type":"p","text":"Especially:"},{"type":"p","text":"Evolution Bosses;"},{"type":"p","text":"elites;"},{"type":"p","text":"Weekly Bosses."},{"type":"p","text":"Bosses can scale based on the number of players through:"},{"type":"p","text":"moderate HP;"},{"type":"p","text":"aggressiveness;"},{"type":"p","text":"behavior;"},{"type":"p","text":"additional mechanics."},{"type":"p","text":"Not simply by multiplying health."},{"type":"h1","text":"Dungeons"},{"type":"p","text":"Especially well suited to co-op. They may allow:"},{"type":"p","text":"premade groups;"},{"type":"p","text":"matchmaking;"},{"type":"p","text":"friends."},{"type":"p","text":"Story Dungeons could remain primarily solo to preserve narrative direction."},{"type":"h1","text":"Weekly Activities"},{"type":"p","text":"They may have cooperative modes."},{"type":"h1","text":"Events"},{"type":"p","text":"Some events may include temporary group activities."},{"type":"h1","text":"What Does NOT Require Cooperation"},{"type":"p","text":"main story;"},{"type":"p","text":"important character mission;"},{"type":"p","text":"exploration required for progression;"},{"type":"p","text":"essential puzzles;"},{"type":"p","text":"basic farming."},{"type":"h1","text":"Cooperative Gameplay"},{"type":"p","text":"Each player controls their assigned characters. Elemental interactions continue to work across participants. Example:"},{"type":"h3","text":"Player A"},{"type":"p","text":"applies Water."},{"type":"h3","text":"Player B"},{"type":"p","text":"uses Electro."},{"type":"p","text":"↓"},{"type":"h3","text":"Electrified Zone"},{"type":"p","text":"This creates a fitting social fantasy:"},{"type":"p","text":"players not only fight together; they can also create reactions together."},{"type":"h1","text":"Synergies"},{"type":"p","text":"The following abilities:"},{"type":"p","text":"healing;"},{"type":"p","text":"shields;"},{"type":"p","text":"buffs;"},{"type":"p","text":"control;"},{"type":"p","text":"can affect human-controlled allies."},{"type":"p","text":"However, an independent balancing system will be required."},{"type":"p","text":"An ability designed for three AI-controlled companions can become absurd when three coordinated players exploit it."},{"type":"p","text":"Likewise, taunting—an attribute associated with tanks or fighters—is intended to determine where and whom enemies attack first, allowing players to focus encounters and adapt their approach for survival."},{"type":"h1","text":"Rewards"},{"type":"p","text":"The fundamental rule should be:"},{"type":"h1","text":"Personal Loot"},{"type":"p","text":"Each player receives their own result. There is no situation where:"},{"type":"p","text":"A Boss drops one sword and four people must argue over who gets it."},{"type":"p","text":"This prevents:"},{"type":"p","text":"conflicts;"},{"type":"p","text":"loot theft;"},{"type":"p","text":"griefing."},{"type":"h1","text":"World Resources"},{"type":"p","text":"For common materials, gathering can be individual."},{"type":"p","text":"If one player gathers a plant, it does not necessarily disappear for everyone else."},{"type":"h1","text":"Chests"},{"type":"p","text":"Each player can claim their own reward after meeting the requirements."},{"type":"h1","text":"Host and Guest Progress"},{"type":"p","text":"I propose:"},{"type":"h3","text":"Host"},{"type":"p","text":"Controls the persistent state of the world."},{"type":"h3","text":"Guest"},{"type":"p","text":"Can obtain:"},{"type":"p","text":"rewards;"},{"type":"p","text":"materials;"},{"type":"p","text":"experience;"},{"type":"p","text":"progress in compatible activities."},{"type":"p","text":"But should not alter:"},{"type":"p","text":"narrative decisions;"},{"type":"p","text":"missions;"},{"type":"p","text":"the Host's world state."},{"type":"p","text":"For shared missions, joint progression must be defined on a case-by-case basis."},{"type":"h1","text":"Matchmaking"},{"type":"p","text":"It may be available for:"},{"type":"p","text":"Dungeons;"},{"type":"p","text":"Bosses;"},{"type":"p","text":"weekly activities;"},{"type":"p","text":"events."},{"type":"p","text":"I would not recommend random matchmaking for free exploration."},{"type":"h1","text":"Difficulty"},{"type":"p","text":"The game should scale based on:"},{"type":"p","text":"number of participants;"},{"type":"p","text":"content level;"},{"type":"p","text":"team composition."},{"type":"p","text":"Not based on how much money players have spent."},{"type":"h1","text":"4. Social Hub"},{"type":"h2","text":"Development"},{"type":"p","text":"This is probably the project's most distinctive social component:"},{"type":"h1","text":"Kingdomless Island"},{"type":"p","text":"The historical documentation explicitly conceives it as:"},{"type":"p","text":"independent nation;"},{"type":"p","text":"territory of serenity and freedom;"},{"type":"p","text":"historical place connected to the first great war;"},{"type":"p","text":"limited social space;"},{"type":"p","text":"future Endgame area."},{"type":"p","text":"The version history adds:"},{"type":"p","text":"socializing;"},{"type":"p","text":"houses;"},{"type":"p","text":"decorations;"},{"type":"p","text":"Endgame areas;"},{"type":"p","text":"trading;"},{"type":"p","text":"PvE;"},{"type":"p","text":"PvP."},{"type":"p","text":"Therefore, I would not treat it as merely a lobby."},{"type":"h1","text":"Main Function"},{"type":"p","text":"The Island should be: NARRATIVE REGION + SOCIAL HUB + ENDGAME HUB"},{"type":"p","text":"This allows it to retain value even for someone who never uses multiplayer."},{"type":"h1","text":"First Arrival"},{"type":"p","text":"It should be discovered through the story the first time. It does not appear automatically in the menu."},{"type":"p","text":"The player learns about:"},{"type":"p","text":"history;"},{"type":"p","text":"ruins;"},{"type":"p","text":"inhabitants;"},{"type":"p","text":"political significance;"},{"type":"p","text":"relationship with the deities."},{"type":"p","text":"Afterward, its social features are progressively unlocked."},{"type":"h1","text":"Central Plaza"},{"type":"p","text":"It may contain:"},{"type":"p","text":"players;"},{"type":"p","text":"merchants;"},{"type":"p","text":"activity board;"},{"type":"p","text":"Guild/Party Finder;"},{"type":"p","text":"NPC;"},{"type":"p","text":"events."},{"type":"h1","text":"Training Area"},{"type":"p","text":"An area to:"},{"type":"p","text":"test characters;"},{"type":"p","text":"practice combos;"},{"type":"p","text":"measure damage;"},{"type":"p","text":"teach mechanics;"},{"type":"p","text":"hold optional duels."},{"type":"p","text":"The older documentation already mentioned the need for an isolated area for practicing and testing mechanics alongside the social servers."},{"type":"h1","text":"Housing"},{"type":"p","text":"Historical version 1.6 explicitly proposes houses and decorations."},{"type":"p","text":"This may evolve into:"},{"type":"h3","text":"Personal Residence"},{"type":"p","text":"The player can:"},{"type":"p","text":"decorate;"},{"type":"p","text":"display trophies;"},{"type":"p","text":"place keepsakes;"},{"type":"p","text":"receive visitors;"},{"type":"p","text":"display characters."},{"type":"p","text":"It also provides a clear use for cosmetic items from the Economy System."},{"type":"h1","text":"Marketplace"},{"type":"p","text":"It must be handled very carefully."},{"type":"p","text":"The historical source includes “trading.”"},{"type":"p","text":"The following exchanges are not allowed:"},{"type":"p","text":"character ↔ character"},{"type":"p","text":"or:"},{"type":"p","text":"5-star weapon ↔ money/currency"},{"type":"p","text":"between players."},{"type":"p","text":"That would create major problems involving:"},{"type":"p","text":"fraud;"},{"type":"p","text":"bots;"},{"type":"p","text":"gray markets;"},{"type":"p","text":"stolen accounts;"},{"type":"p","text":"inflation."},{"type":"h2","text":"Proposed Safe Trading"},{"type":"p","text":"Initially, only the following could be traded:"},{"type":"p","text":"common materials;"},{"type":"p","text":"ingredients;"},{"type":"p","text":"certain craftable items."},{"type":"p","text":"optimized Artifacts;"},{"type":"p","text":"Last Wills."},{"type":"p","text":"The goal is to solve small problems directly and encourage interaction between players. For example, a player might obtain a high-rarity Artifact with good attributes but have no character who can justify or use it. They could then trade it or list it in an area where someone else can buy it or offer something of value in exchange."},{"type":"h1","text":"Non-Combat Activities"},{"type":"p","text":"The Island may contain:"},{"type":"p","text":"future fishing;"},{"type":"p","text":"cooking;"},{"type":"p","text":"crafting;"},{"type":"p","text":"photography;"},{"type":"p","text":"minigames;"},{"type":"p","text":"festivals;"},{"type":"p","text":"music;"},{"type":"p","text":"housing;"},{"type":"p","text":"emotes;"},{"type":"p","text":"community events."},{"type":"p","text":"This ensures that “socializing” does not mean standing around a fountain."},{"type":"h1","text":"Ruins"},{"type":"p","text":"The Island also has major narrative importance. Therefore, some sections should preserve:"},{"type":"p","text":"exploration;"},{"type":"p","text":"history;"},{"type":"p","text":"puzzles;"},{"type":"p","text":"remnants of war."},{"type":"p","text":"The Social Hub must not erase its identity as a region."},{"type":"h1","text":"5. Competitive"},{"type":"h2","text":"Development"},{"type":"p","text":"PvP does have an explicit historical precedent."},{"type":"p","text":"The original document describes:"},{"type":"h1","text":"Battle in an Isolated Zone (Competitive)"},{"type":"p","text":"as a confrontation between players inspired by tournaments, where skills, strategies, and character builds can be compared. It also raises concerns about reducing the gap between Free-to-Play and Pay-to-Win players."},{"type":"h1","text":"Objective"},{"type":"p","text":"Competitive play should answer: Who understands and executes their characters better?"},{"type":"h1","text":"Proposed Main Format"},{"type":"h2","text":"Arena Duel"},{"type":"h3","text":"1 player vs. 1 player"},{"type":"p","text":"Each player brings their team composition. Combat takes place within an:"},{"type":"h3","text":"Isolated Zone"},{"type":"p","text":"preserving even the historical name."},{"type":"h1","text":"Team"},{"type":"p","text":"Each player can prepare:"},{"type":"h3","text":"4 characters"},{"type":"p","text":"and use the same switching system as PvE."},{"type":"p","text":"This preserves the core gameplay."},{"type":"p","text":"I do not want to design a completely different combat system for PvP."},{"type":"h1","text":"Duration"},{"type":"p","text":"Short matches."},{"type":"p","text":"Approximate target:"},{"type":"h3","text":"3–7 minutes"},{"type":"h1","text":"Fair Play Rules"},{"type":"p","text":"Here I propose a fairly strong decision:"},{"type":"h1","text":"Ranked uses normalized statistics."},{"type":"p","text":"The system may normalize:"},{"type":"p","text":"level;"},{"type":"p","text":"weapon;"},{"type":"p","text":"Artifacts;"},{"type":"p","text":"talents."},{"type":"p","text":"And limit or disable:"},{"type":"h3","text":"Legacy Bonuses"},{"type":"p","text":"obtained from duplicates."},{"type":"h2","text":"Why?"},{"type":"p","text":"The historical documentation itself already recognized the problem of the gap between Free-to-Play and Pay-to-Win players in competitive content."},{"type":"p","text":"The cleanest solution is to separate economic progression from ranked competition."},{"type":"h1","text":"Unranked"},{"type":"p","text":"May allow normal builds."},{"type":"p","text":"It is intended for:"},{"type":"p","text":"friends;"},{"type":"p","text":"testing;"},{"type":"p","text":"fun."},{"type":"h1","text":"Ranked"},{"type":"p","text":"Uses normalized competitive rules."},{"type":"p","text":"What matters here is:"},{"type":"p","text":"team composition;"},{"type":"p","text":"knowledge;"},{"type":"p","text":"timing;"},{"type":"p","text":"cooldowns;"},{"type":"p","text":"dodging;"},{"type":"p","text":"reactions."},{"type":"h1","text":"Ranking"},{"type":"p","text":"It may use:"},{"type":"h3","text":"internal MMR"},{"type":"p","text":"and visible leagues."},{"type":"p","text":"Example:"},{"type":"p","text":"Bronze → Silver → Gold → etc."},{"type":"p","text":"The final names should be themed later."},{"type":"h1","text":"Seasons"},{"type":"p","text":"They may last several weeks, even across versions."},{"type":"p","text":"I would not set an exact duration yet."},{"type":"h3","text":"Rewards"},{"type":"p","text":"Primarily:"},{"type":"p","text":"titles;"},{"type":"p","text":"emblems;"},{"type":"p","text":"profiles;"},{"type":"p","text":"cosmetics;"},{"type":"p","text":"decorations."},{"type":"h1","text":"PvE Leaderboards"},{"type":"p","text":"Indirect competition may also exist:"},{"type":"p","text":"Boss time;"},{"type":"p","text":"Dungeon score;"},{"type":"p","text":"Challenge score."},{"type":"p","text":"It may be more accessible to players who do not enjoy PvP."},{"type":"h1","text":"6. Safety and Moderation"},{"type":"p","text":"This section is necessary because the project has recognized the need for servers, account protection, and a cybersecurity team since 2023."},{"type":"h1","text":"Chat"},{"type":"p","text":"I initially propose:"},{"type":"h3","text":"Party Chat"},{"type":"h3","text":"Friends Chat"},{"type":"h3","text":"Guild Chat"},{"type":"h3","text":"Hub Chat"},{"type":"p","text":"I do not recommend starting with a permanent Global World Chat"},{"type":"p","text":"because it is considerably more difficult to moderate and usually provides less value than it costs."},{"type":"h1","text":"Quick Chat"},{"type":"p","text":"There should be an alternative based on predefined messages:"},{"type":"p","text":"Hello;"},{"type":"p","text":"Thanks;"},{"type":"p","text":"Follow Me;"},{"type":"p","text":"Boss;"},{"type":"p","text":"Need Help;"},{"type":"p","text":"Ready;"},{"type":"p","text":"Wait;"},{"type":"p","text":"Good Game."},{"type":"p","text":"Especially useful for:"},{"type":"p","text":"console;"},{"type":"p","text":"mobile;"},{"type":"p","text":"players who speak different languages."},{"type":"h1","text":"Voice Chat"},{"type":"p","text":"I do not consider it necessary for the first social implementation. Players can use external communication if they wish. Integrated voice chat adds:"},{"type":"p","text":"moderation;"},{"type":"p","text":"privacy;"},{"type":"p","text":"infrastructure;"},{"type":"p","text":"abuse;"},{"type":"p","text":"recording/reports."},{"type":"h1","text":"Mute"},{"type":"p","text":"Players can immediately mute another person without needing to report them."},{"type":"h1","text":"Block"},{"type":"p","text":"Blocking should prevent:"},{"type":"p","text":"messages;"},{"type":"p","text":"invitations;"},{"type":"p","text":"requests;"},{"type":"p","text":"direct social matchmaking whenever possible;"},{"type":"p","text":"visits."},{"type":"h1","text":"Report"},{"type":"p","text":"It should provide clear categories:"},{"type":"h3","text":"Harassment"},{"type":"h3","text":"Hate / Abuse"},{"type":"h3","text":"Sexual Content"},{"type":"h3","text":"Threats"},{"type":"h3","text":"Spam"},{"type":"h3","text":"Scam / Fraud"},{"type":"h3","text":"Cheating"},{"type":"h3","text":"Inappropriate Name/Profile"},{"type":"h3","text":"Exploit"},{"type":"h3","text":"Other"},{"type":"h1","text":"Evidence"},{"type":"p","text":"The system should temporarily retain relevant data such as:"},{"type":"p","text":"reported messages;"},{"type":"p","text":"match/session ID;"},{"type":"p","text":"timestamp;"},{"type":"p","text":"user;"},{"type":"p","text":"context."},{"type":"p","text":"Do not rely solely on a screenshot submitted by the player."},{"type":"h1","text":"Moderation"},{"type":"p","text":"It may combine:"},{"type":"h3","text":"Automated"},{"type":"p","text":"filters;"},{"type":"p","text":"rate limits;"},{"type":"p","text":"spam detection;"},{"type":"p","text":"prohibited names."},{"type":"h3","text":"Human"},{"type":"p","text":"For reported cases and serious sanctions."},{"type":"h1","text":"Escalation"},{"type":"p","text":"Sanctions may include: warning → mute → temporary suspension → social suspension → ban."},{"type":"p","text":"Severity depends on the behavior."},{"type":"h1","text":"Privacy"},{"type":"p","text":"By default, users must be able to control:"},{"type":"p","text":"who can find them;"},{"type":"p","text":"who can invite them;"},{"type":"p","text":"presence;"},{"type":"p","text":"messages;"},{"type":"p","text":"visits;"},{"type":"p","text":"profile."},{"type":"h1","text":"Account Protection"},{"type":"p","text":"Especially important because the game would include:"},{"type":"p","text":"Gacha;"},{"type":"p","text":"purchases;"},{"type":"p","text":"characters;"},{"type":"p","text":"equipment."},{"type":"p","text":"The following should be considered later:"},{"type":"p","text":"authentication;"},{"type":"p","text":"recovery;"},{"type":"p","text":"session security;"},{"type":"p","text":"irregular access detection."},{"type":"p","text":"The historical documentation already identified the need to protect player accounts through cybersecurity."},{"type":"h1","text":"Trade Safety"},{"type":"p","text":"If trading exists:"},{"type":"h3","text":"Double confirmation."},{"type":"p","text":"The interface must display exactly: YOU GIVE and YOU RECEIVE before acceptance."},{"type":"p","text":"After an offer is modified, both confirmations are reset."},{"type":"h1","text":"Conduct"},{"type":"p","text":"There must be a:"},{"type":"h3","text":"Community Code of Conduct"},{"type":"p","text":"Applicable to:"},{"type":"p","text":"names;"},{"type":"p","text":"profiles;"},{"type":"p","text":"chat;"},{"type":"p","text":"guilds;"},{"type":"p","text":"public housing;"},{"type":"p","text":"match behavior."},{"type":"h1","text":"Anti-Cheat"},{"type":"p","text":"PvP, rankings, and the online economy will require:"},{"type":"p","text":"server-side validation;"},{"type":"p","text":"tampering detection;"},{"type":"p","text":"movement/combat validation;"},{"type":"p","text":"inventory protection."},{"type":"p","text":"The client must not determine rewards, currency, or competitive results by itself."},{"type":"h1","text":"7. Scope Control"},{"type":"h2","text":"Development"},{"type":"p","text":"This point is quite clear thanks to the current Game Vision. Social systems are not part of the Core Gameplay Prototype and should not be part of the functional Vertical Slice. The current document expressly excludes the following from the first milestone:"},{"type":"p","text":"multiplayer;"},{"type":"p","text":"persistent servers;"},{"type":"p","text":"PvP;"},{"type":"p","text":"guilds;"},{"type":"p","text":"the complete Kingdomless Island."},{"type":"p","text":"In addition, the Game Vision places the social and online expansion after development of the basic commercial product."},{"type":"h1","text":"Vertical Slice"},{"type":"h2","text":"What Should NOT Be Implemented"},{"type":"p","text":"real Friends List;"},{"type":"p","text":"matchmaking;"},{"type":"p","text":"servers;"},{"type":"p","text":"co-op;"},{"type":"p","text":"PvP;"},{"type":"p","text":"Guilds;"},{"type":"p","text":"chat;"},{"type":"p","text":"trading;"},{"type":"p","text":"housing online;"},{"type":"p","text":"rankings;"},{"type":"p","text":"moderation;"},{"type":"p","text":"player synchronization."},{"type":"h1","text":"What Can Be Shown"},{"type":"p","text":"We can represent the social vision through:"},{"type":"h3","text":"Concept Art"},{"type":"p","text":"of the Kingdomless Island."},{"type":"h3","text":"Greybox"},{"type":"p","text":"of a small area."},{"type":"h3","text":"UI Mockup"},{"type":"p","text":"of party/friends."},{"type":"h3","text":"Roadmap"},{"type":"p","text":"showing the future expansion."},{"type":"h3","text":"Concept Video"},{"type":"p","text":"if it is worth the investment later. However, none of these elements needs to connect to an actual server."},{"type":"p","text":"This keeps the Vertical Slice budget focused on demonstrating what will initially sell the game: combat + characters + elements + exploration + world."},{"type":"h1","text":"Backend Dependencies"},{"type":"p","text":"Several services will be required later to implement the actual social layer."},{"type":"table","table":1},{"type":"p","text":"The current Game Vision already anticipates that online and backend infrastructure will be implemented in later phases, even mentioning Nakama or dedicated servers as possible technical alternatives that still need to be evaluated."},{"type":"h1","text":"Recommended Architecture"},{"type":"p","text":"For important systems:"},{"type":"p","text":"SERVER AUTHORITATIVE"},{"type":"p","text":"Especially:"},{"type":"p","text":"inventory;"},{"type":"p","text":"rewards;"},{"type":"p","text":"currency;"},{"type":"p","text":"trade;"},{"type":"p","text":"matchmaking;"},{"type":"p","text":"PvP result;"},{"type":"p","text":"rankings."},{"type":"p","text":"The client sends a request. The server validates it. The server modifies the state."},{"type":"h1","text":"Services That Can Be Added Later"},{"type":"p","text":"A sensible sequence would be:"},{"type":"h3","text":"Online Phase 1"},{"type":"p","text":"Account + Friends + Party + Presence"},{"type":"p","text":"↓"},{"type":"h3","text":"Online Phase 2"},{"type":"p","text":"Co-op + Matchmaking"},{"type":"p","text":"↓"},{"type":"h3","text":"Online Phase 3"},{"type":"p","text":"Kingdomless Island Social Hub"},{"type":"p","text":"↓"},{"type":"h3","text":"Online Phase 4"},{"type":"p","text":"Guilds + Housing + Social Activities"},{"type":"p","text":"↓"},{"type":"h3","text":"Online Phase 5"},{"type":"p","text":"PvP + Rankings"},{"type":"p","text":"↓"},{"type":"h3","text":"Online Phase 6"},{"type":"p","text":"Limited Trading + Advanced Community Systems"},{"type":"p","text":"I would not try to build everything simultaneously."},{"type":"h1","text":"Complete Social Layer Relationship"},{"type":"p","text":"We can represent the system as follows:"},{"type":"p","text":"PLAY SOLO"},{"type":"p","text":"↓"},{"type":"p","text":"MEET PLAYERS"},{"type":"p","text":"↓"},{"type":"p","text":"FRIENDS"},{"type":"p","text":"↓"},{"type":"p","text":"FORM A PARTY"},{"type":"p","text":"↓"},{"type":"p","text":"EXPLORE / DUNGEON / BOSS"},{"type":"p","text":"↓"},{"type":"p","text":"OBTAIN INDIVIDUAL REWARDS"},{"type":"p","text":"↓"},{"type":"p","text":"RETURN TO THE KINGDOMLESS ISLAND"},{"type":"p","text":"↓"},{"type":"p","text":"SOCIALIZE / HOUSING / ACTIVITIES"},{"type":"p","text":"↓"},{"type":"p","text":"FORM A COMMUNITY"},{"type":"p","text":"↓"},{"type":"p","text":"COOPERATE OR COMPETE"},{"type":"p","text":"↓"},{"type":"p","text":"RETURN TO THE WORLD"},{"type":"p","text":"In this way, the social layer surrounds the Core Loop without replacing it."}],"tables":[[["Status","DRAFT","Version","0.15.7"],["Owner","J. Crow","Last updated","08/20/2026"]],[["System","Main dependency"],["Account","Authentication / Identity"],["Friends","Social Graph"],["Presence","Presence Service"],["Party","Party Service"],["Matchmaking","Matchmaking Service"],["Co-op","Session / Game Server"],["Chat","Messaging Service"],["Guilds","Persistent Social Data"],["Housing","Persistent World Data"],["Trading","Transaction Service"],["PvP","Authoritative Game Servers"],["Rankings","Leaderboard Service"],["Rewards","Economy / Inventory Service"],["Reports","Moderation Backend"],["Anti-Cheat","Server Validation + Detection"]]]}